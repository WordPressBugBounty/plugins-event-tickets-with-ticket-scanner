#: sasoEventtickets_AdminSettings.php:3867
#, php-format
msgid "[%s] CRITICAL: Ticket format exhausted for \"%s\""
msgstr "[%s] КРИТИЧНО: Формат билета исчерпан для «%s»"

#: sasoEventtickets_AdminSettings.php:3869
#, php-format
msgid ""
"WARNING: The ticket number format for list \"%s\" is exhausted!\n"
"\n"
"It took %d attempts to generate a ticket code.\n"
"\n"
"Actions:\n"
"1. Go to: %s\n"
"2. Edit the ticket list\n"
"3. Increase code length or change character set\n"
"\n"
"Without action, future ticket sales may fail!"
msgstr ""
"ВНИМАНИЕ: Формат номеров билетов для списка «%s» исчерпан!\n"
"\n"
"Потребовалось %d попыток, чтобы сгенерировать код билета.\n"
"\n"
"Что сделать:\n"
"1. Перейдите: %s\n"
"2. Отредактируйте список билетов\n"
"3. Увеличьте длину кода или смените набор символов\n"
"\n"
"Без действий будущие продажи билетов могут завершаться ошибкой!"

#: sasoEventtickets_AdminSettings.php:3875
#, php-format
msgid "[%s] WARNING: Ticket format running out for \"%s\""
msgstr "[%s] ВНИМАНИЕ: Формат билета заканчивается для «%s»"

#: sasoEventtickets_AdminSettings.php:3877
#, php-format
msgid ""
"WARNING: The ticket number format for list \"%s\" is running out of "
"combinations!\n"
"\n"
"It took %d attempts to generate a ticket code.\n"
"\n"
"Recommended action:\n"
"1. Go to: %s\n"
"2. Edit the ticket list\n"
"3. Consider increasing code length or character set\n"
"\n"
"This is a proactive warning to prevent future issues."
msgstr ""
"ВНИМАНИЕ: Комбинации формата номеров билетов для списка «%s» заканчиваются!\n"
"\n"
"Потребовалось %d попыток, чтобы сгенерировать код билета.\n"
"\n"
"Рекомендуемые действия:\n"
"1. Перейдите: %s\n"
"2. Отредактируйте список билетов\n"
"3. Подумайте об увеличении длины кода или набора символов\n"
"\n"
"Это упреждающее предупреждение, чтобы избежать проблем в будущем."

