#: sasoEventtickets_Ticket.php:2179
msgid "TICKET NOT REDEEMED - see reason below"
msgstr ""
"#-#-#-#-#  event-tickets-with-ticket-scanner-de_DE.po (Event Tickets with "
"Ticket Scanner 1.2.12)  #-#-#-#-#\n"
