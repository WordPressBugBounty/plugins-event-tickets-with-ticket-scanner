{"translation-revision-date":"2026-03-24 18:00+0100","generator":"WP-CLI\/2.12.0","source":"js\/congress-a.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"ru_RU","plural-forms":"nplurals=3; plural=(n%10==1 && n%100!=11 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2);"},"Error":["\u041e\u0448\u0438\u0431\u043a\u0430"],"Active":["\u0410\u043a\u0442\u0438\u0432\u043d\u043e"],"Status":["\u0421\u0442\u0430\u0442\u0443\u0441"],"Expired":["\u0418\u0441\u0442\u0451\u043a"],"New congress":["\u041d\u043e\u0432\u044b\u0439 \u043a\u043e\u043d\u0433\u0440\u0435\u0441\u0441"],"Title":["\u041d\u0430\u0437\u0432\u0430\u043d\u0438\u0435"],"Products":["\u0422\u043e\u0432\u0430\u0440\u044b"],"Updated":["\u041e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u043e"],"Export contacts":["\u042d\u043a\u0441\u043f\u043e\u0440\u0442 \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u043e\u0432"],"Edit":["\u0420\u0435\u0434\u0430\u043a\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c"],"New edition":["\u041d\u043e\u0432\u043e\u0435 \u0438\u0437\u0434\u0430\u043d\u0438\u0435"],"Delete":["\u0423\u0434\u0430\u043b\u0438\u0442\u044c"],"Congresses let you attach structured information (programme, downloads, media, texts) to an event. Ticket holders can access the congress page using their ticket ID. Assign a congress to a product in the WooCommerce product settings \u2014 one congress can be shared across multiple products.":["\u041a\u043e\u043d\u0433\u0440\u0435\u0441\u0441\u044b \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u044e\u0442 \u043f\u0440\u0438\u0432\u044f\u0437\u044b\u0432\u0430\u0442\u044c \u043a \u0441\u043e\u0431\u044b\u0442\u0438\u044e \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0443\u044e \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044e (\u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0443, \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u044b, \u043c\u0435\u0434\u0438\u0430, \u0442\u0435\u043a\u0441\u0442\u044b). \u0412\u043b\u0430\u0434\u0435\u043b\u044c\u0446\u044b \u0431\u0438\u043b\u0435\u0442\u043e\u0432 \u043f\u043e\u043b\u0443\u0447\u0430\u044e\u0442 \u0434\u043e\u0441\u0442\u0443\u043f \u043a \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0435 \u043a\u043e\u043d\u0433\u0440\u0435\u0441\u0441\u0430 \u043f\u043e ID \u0431\u0438\u043b\u0435\u0442\u0430. \u041d\u0430\u0437\u043d\u0430\u0447\u044c\u0442\u0435 \u043a\u043e\u043d\u0433\u0440\u0435\u0441\u0441 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0443 \u0432 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0430\u0445 WooCommerce \u2014 \u043e\u0434\u0438\u043d \u043a\u043e\u043d\u0433\u0440\u0435\u0441\u0441 \u043c\u043e\u0436\u0435\u0442 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c\u0441\u044f \u0432 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0430\u0445."],"Delete this congress?":["\u0423\u0434\u0430\u043b\u0438\u0442\u044c \u044d\u0442\u043e\u0442 \u043a\u043e\u043d\u0433\u0440\u0435\u0441\u0441?"],"This action cannot be undone. All sections will be deleted as well.":["\u042d\u0442\u043e \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u043d\u0435\u043b\u044c\u0437\u044f \u043e\u0442\u043c\u0435\u043d\u0438\u0442\u044c. \u0412\u0441\u0435 \u0440\u0430\u0437\u0434\u0435\u043b\u044b \u0442\u0430\u043a\u0436\u0435 \u0431\u0443\u0434\u0443\u0442 \u0443\u0434\u0430\u043b\u0435\u043d\u044b."],"Current title:":["\u0422\u0435\u043a\u0443\u0449\u0435\u0435 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435:"],"Current slug:":["\u0422\u0435\u043a\u0443\u0449\u0438\u0439 \u044f\u0440\u043b\u044b\u043a:"],"Slug for new edition:":["Slug \u0434\u043b\u044f \u043d\u043e\u0432\u043e\u0433\u043e \u0438\u0437\u0434\u0430\u043d\u0438\u044f:"],"Title for new edition (leave empty to auto-generate):":["\u041d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u043d\u043e\u0432\u043e\u0433\u043e \u0438\u0437\u0434\u0430\u043d\u0438\u044f (\u043e\u0441\u0442\u0430\u0432\u044c\u0442\u0435 \u043f\u0443\u0441\u0442\u044b\u043c \u0434\u043b\u044f \u0430\u0432\u0442\u043e\u0433\u0435\u043d\u0435\u0440\u0430\u0446\u0438\u0438):"],"Create":["\u0421\u043e\u0437\u0434\u0430\u0442\u044c"],"Cancel":["\u041e\u0442\u043c\u0435\u043d\u0430"],"Edit congress":["\u0420\u0435\u0434\u0430\u043a\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u043a\u043e\u043d\u0433\u0440\u0435\u0441\u0441"],"Details":["\u041f\u043e\u0434\u0440\u043e\u0431\u043d\u043e\u0441\u0442\u0438"],"Unique identifier for this congress. Visitors open it through their personal ticket link, not the slug.":["\u0423\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u0439 \u0438\u0434\u0435\u043d\u0442\u0438\u0444\u0438\u043a\u0430\u0442\u043e\u0440 \u044d\u0442\u043e\u0433\u043e \u043a\u043e\u043d\u0433\u0440\u0435\u0441\u0441\u0430. \u041f\u043e\u0441\u0435\u0442\u0438\u0442\u0435\u043b\u0438 \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u044e\u0442 \u0435\u0433\u043e \u0447\u0435\u0440\u0435\u0437 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u043b\u044c\u043d\u0443\u044e \u0441\u0441\u044b\u043b\u043a\u0443 \u0432 \u0431\u0438\u043b\u0435\u0442\u0435, \u0430 \u043d\u0435 \u043f\u043e slug."],"Portal label":["\u041c\u0435\u0442\u043a\u0430 \u043f\u043e\u0440\u0442\u0430\u043b\u0430"],"Shown in the wallet and email (e.g. \"Opera evening\", \"Zoo visit\"). Empty = use the global default.":["\u041e\u0442\u043e\u0431\u0440\u0430\u0436\u0430\u0435\u0442\u0441\u044f \u0432 \u043a\u043e\u0448\u0435\u043b\u044c\u043a\u0435 \u0438 \u043f\u0438\u0441\u044c\u043c\u0435 (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u00ab\u0412\u0435\u0447\u0435\u0440 \u043e\u043f\u0435\u0440\u044b\u00bb, \u00ab\u0412\u0438\u0437\u0438\u0442 \u0432 \u0437\u043e\u043e\u043f\u0430\u0440\u043a\u00bb). \u041f\u0443\u0441\u0442\u043e = \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f \u0433\u043b\u043e\u0431\u0430\u043b\u044c\u043d\u043e\u0435 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435 \u043f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e."],"Show pages as a card grid on the start screen":["\u041f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u044b \u0432 \u0432\u0438\u0434\u0435 \u0441\u0435\u0442\u043a\u0438 \u043a\u0430\u0440\u0442\u043e\u0447\u0435\u043a \u043d\u0430 \u0441\u0442\u0430\u0440\u0442\u043e\u0432\u043e\u043c \u044d\u043a\u0440\u0430\u043d\u0435"],"Visitors first see a grid of page cards (icon\/image + description) instead of jumping straight into the first page.":["\u041f\u043e\u0441\u0435\u0442\u0438\u0442\u0435\u043b\u0438 \u0441\u043d\u0430\u0447\u0430\u043b\u0430 \u0432\u0438\u0434\u044f\u0442 \u0441\u0435\u0442\u043a\u0443 \u043a\u0430\u0440\u0442\u043e\u0447\u0435\u043a \u0441\u0442\u0440\u0430\u043d\u0438\u0446 (\u0438\u043a\u043e\u043d\u043a\u0430\/\u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435 + \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435), \u0430 \u043d\u0435 \u0441\u0440\u0430\u0437\u0443 \u043f\u043e\u043f\u0430\u0434\u0430\u044e\u0442 \u043d\u0430 \u043f\u0435\u0440\u0432\u0443\u044e \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0443."],"Access expires (optional)":["\u0421\u0440\u043e\u043a \u0434\u043e\u0441\u0442\u0443\u043f\u0430 (\u043d\u0435\u043e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e)"],"Manual hard cutoff. Leave empty for unlimited access.":["\u0420\u0443\u0447\u043d\u043e\u0439 \u0436\u0451\u0441\u0442\u043a\u0438\u0439 \u0441\u0440\u043e\u043a. \u041e\u0441\u0442\u0430\u0432\u044c\u0442\u0435 \u043f\u0443\u0441\u0442\u044b\u043c \u0434\u043b\u044f \u043d\u0435\u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u043d\u043e\u0433\u043e \u0434\u043e\u0441\u0442\u0443\u043f\u0430."],"Active \u2014 visible to ticket holders":["\u0410\u043a\u0442\u0438\u0432\u043d\u043e \u2014 \u0432\u0438\u0434\u043d\u043e \u0434\u0435\u0440\u0436\u0430\u0442\u0435\u043b\u044f\u043c \u0431\u0438\u043b\u0435\u0442\u043e\u0432"],"Turn off to hide this congress everywhere (page + wallet) without unassigning it \u2014 e.g. to publish the info only later.":["\u041e\u0442\u043a\u043b\u044e\u0447\u0438\u0442\u0435, \u0447\u0442\u043e\u0431\u044b \u0441\u043a\u0440\u044b\u0442\u044c \u044d\u0442\u043e\u0442 \u043a\u043e\u043d\u0433\u0440\u0435\u0441\u0441 \u0432\u0435\u0437\u0434\u0435 (\u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0430 + \u043a\u043e\u0448\u0435\u043b\u0451\u043a), \u043d\u0435 \u0441\u043d\u0438\u043c\u0430\u044f \u0435\u0433\u043e \u0441 \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f \u2014 \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0447\u0442\u043e\u0431\u044b \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u0442\u044c \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044e \u043f\u043e\u0437\u0436\u0435."],"assigned (manage on product level)":["\u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u043e (\u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u043d\u0430 \u0443\u0440\u043e\u0432\u043d\u0435 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0430)"],"Assign via the WooCommerce product settings.":["\u041d\u0430\u0437\u043d\u0430\u0447\u044c\u0442\u0435 \u0432 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0430\u0445 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0430 WooCommerce."],"Save the congress first to add pages and sections.":["\u0421\u043d\u0430\u0447\u0430\u043b\u0430 \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u0435 \u043a\u043e\u043d\u0433\u0440\u0435\u0441\u0441, \u0447\u0442\u043e\u0431\u044b \u0434\u043e\u0431\u0430\u0432\u043b\u044f\u0442\u044c \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u044b \u0438 \u0440\u0430\u0437\u0434\u0435\u043b\u044b."],"Pages":["\u0421\u0442\u0440\u0430\u043d\u0438\u0446\u044b"],"Add page":["\u0414\u043e\u0431\u0430\u0432\u0438\u0442\u044c \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0443"],"The first page is the start page (shown first to visitors). Drag pages and sections to reorder.":["\u041f\u0435\u0440\u0432\u0430\u044f \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0430 \u2014 \u0441\u0442\u0430\u0440\u0442\u043e\u0432\u0430\u044f (\u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u043f\u043e\u0441\u0435\u0442\u0438\u0442\u0435\u043b\u044f\u043c \u043f\u0435\u0440\u0432\u043e\u0439). \u041f\u0435\u0440\u0435\u0442\u0430\u0441\u043a\u0438\u0432\u0430\u0439\u0442\u0435 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u044b \u0438 \u0440\u0430\u0437\u0434\u0435\u043b\u044b \u0434\u043b\u044f \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u043f\u043e\u0440\u044f\u0434\u043a\u0430."],"Save congress":["\u0421\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u044c \u043a\u043e\u043d\u0433\u0440\u0435\u0441\u0441"],"Rename page":["\u041f\u0435\u0440\u0435\u0438\u043c\u0435\u043d\u043e\u0432\u0430\u0442\u044c \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0443"],"Delete page?":["\u0423\u0434\u0430\u043b\u0438\u0442\u044c \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0443?"],"Its sections will be moved to the start page. This cannot be undone.":["\u0415\u0451 \u0440\u0430\u0437\u0434\u0435\u043b\u044b \u0431\u0443\u0434\u0443\u0442 \u043f\u0435\u0440\u0435\u043d\u0435\u0441\u0435\u043d\u044b \u043d\u0430 \u0441\u0442\u0430\u0440\u0442\u043e\u0432\u0443\u044e \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0443. \u042d\u0442\u043e \u043d\u0435\u043b\u044c\u0437\u044f \u043e\u0442\u043c\u0435\u043d\u0438\u0442\u044c."],"Delete section?":["\u0423\u0434\u0430\u043b\u0438\u0442\u044c \u0440\u0430\u0437\u0434\u0435\u043b?"],"This action cannot be undone.":["\u042d\u0442\u043e \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u043d\u0435\u043b\u044c\u0437\u044f \u043e\u0442\u043c\u0435\u043d\u0438\u0442\u044c."],"OK":["\u041e\u041a"],"No icon":["\u0411\u0435\u0437 \u0438\u043a\u043e\u043d\u043a\u0438"],"Remove image":["\u0423\u0434\u0430\u043b\u0438\u0442\u044c \u0438\u0437\u043e\u0431\u0440\u0430\u043