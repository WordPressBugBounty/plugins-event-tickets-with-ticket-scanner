{"translation-revision-date":"2026-03-24 18:00+0100","generator":"WP-CLI\/2.12.0","source":"js\/congress-a.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"ko_KR","plural-forms":"nplurals=1; plural=0;"},"Error":["\uc624\ub958"],"Active":["\ud65c\uc131"],"Status":["\uc0c1\ud0dc"],"Expired":["\ub9cc\ub8cc\ub428"],"New congress":["\uc0c8 \ucee8\ud37c\ub7f0\uc2a4"],"Title":["\uc81c\ubaa9"],"Products":["\uc81c\ud488"],"Updated":["\uc5c5\ub370\uc774\ud2b8\ub428"],"Export contacts":["\uc5f0\ub77d\ucc98 \ub0b4\ubcf4\ub0b4\uae30"],"Edit":["\ud3b8\uc9d1"],"New edition":["\uc0c8 \uc5d0\ub514\uc158"],"Delete":["\uc0ad\uc81c"],"Congresses let you attach structured information (programme, downloads, media, texts) to an event. Ticket holders can access the congress page using their ticket ID. Assign a congress to a product in the WooCommerce product settings \u2014 one congress can be shared across multiple products.":["\ucee8\uadf8\ub808\uc2a4\ub97c \uc0ac\uc6a9\ud558\uba74 \ud504\ub85c\uadf8\ub7a8, \ub2e4\uc6b4\ub85c\ub4dc, \ubbf8\ub514\uc5b4, \ud14d\uc2a4\ud2b8 \ub4f1 \uad6c\uc870\ud654\ub41c \uc815\ubcf4\ub97c \uc774\ubca4\ud2b8\uc5d0 \ucca8\ubd80\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud2f0\ucf13 \uc18c\uc9c0\uc790\ub294 \uc790\uc2e0\uc758 \ud2f0\ucf13 ID\ub85c \ucee8\uadf8\ub808\uc2a4 \ud398\uc774\uc9c0\uc5d0 \uc811\uc18d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. WooCommerce \uc0c1\ud488 \uc124\uc815\uc5d0\uc11c \ucee8\uadf8\ub808\uc2a4\ub97c \uc0c1\ud488\uc5d0 \ud560\ub2f9\ud558\uc138\uc694. \ud55c \ucee8\uadf8\ub808\uc2a4\ub97c \uc5ec\ub7ec \uc0c1\ud488\uc5d0\uc11c \uacf5\uc720\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."],"Delete this congress?":["\uc774 \ucee8\uadf8\ub808\uc2a4\ub97c \uc0ad\uc81c\ud560\uae4c\uc694?"],"This action cannot be undone. All sections will be deleted as well.":["\uc774 \uc791\uc5c5\uc740 \ucde8\uc18c\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \ubaa8\ub4e0 \uc139\uc158\ub3c4 \ud568\uaed8 \uc0ad\uc81c\ub429\ub2c8\ub2e4."],"Current title:":["\ud604\uc7ac \uc81c\ubaa9:"],"Current slug:":["\ud604\uc7ac \uc2ac\ub7ec\uadf8:"],"Slug for new edition:":["\uc0c8 \uc5d0\ub514\uc158 \uc2ac\ub7ec\uadf8:"],"Title for new edition (leave empty to auto-generate):":["\uc0c8 \uc5d0\ub514\uc158 \uc81c\ubaa9(\ube44\uc6cc\ub450\uba74 \uc790\ub3d9 \uc0dd\uc131):"],"Create":["\ub9cc\ub4e4\uae30"],"Cancel":["\ucde8\uc18c"],"Edit congress":["\ucee8\uadf8\ub808\uc2a4 \ud3b8\uc9d1"],"Details":["\uc138\ubd80 \uc815\ubcf4"],"Unique identifier for this congress. Visitors open it through their personal ticket link, not the slug.":["\uc774 \ucee8\ud37c\ub7f0\uc2a4\uc758 \uace0\uc720 \uc2dd\ubcc4\uc790\uc785\ub2c8\ub2e4. \ubc29\ubb38\uc790\ub294 \uc2ac\ub7ec\uadf8\uac00 \uc544\ub2cc \uac1c\uc778 \ud2f0\ucf13 \ub9c1\ud06c\ub97c \ud1b5\ud574 \uc811\uc18d\ud569\ub2c8\ub2e4."],"Portal label":["\ud3ec\ud138 \ub808\uc774\ube14"],"Shown in the wallet and email (e.g. \"Opera evening\", \"Zoo visit\"). Empty = use the global default.":["\uc9c0\uac11\uacfc \uc774\uba54\uc77c\uc5d0 \ud45c\uc2dc\ub429\ub2c8\ub2e4(\uc608: \"\uc624\ud398\ub77c\uc758 \ubc24\", \"\ub3d9\ubb3c\uc6d0 \ubc29\ubb38\"). \ube44\uc6cc\ub450\uba74 \uc804\uc5ed \uae30\ubcf8\uac12\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4."],"Show pages as a card grid on the start screen":["\uc2dc\uc791 \ud654\uba74\uc5d0\uc11c \ud398\uc774\uc9c0\ub97c \uce74\ub4dc \uadf8\ub9ac\ub4dc\ub85c \ud45c\uc2dc"],"Visitors first see a grid of page cards (icon\/image + description) instead of jumping straight into the first page.":["\ubc29\ubb38\uc790\uac00 \uccab \ubc88\uc9f8 \ud398\uc774\uc9c0\ub85c \ubc14\ub85c \uc774\ub3d9\ud558\ub294 \ub300\uc2e0 \ud398\uc774\uc9c0 \uce74\ub4dc(\uc774\ubbf8\uc9c0\/\uc544\uc774\ucf58 + \uc124\uba85) \uadf8\ub9ac\ub4dc\ub97c \uba3c\uc800 \ubd05\ub2c8\ub2e4."],"Access expires (optional)":["\uc811\uadfc \ub9cc\ub8cc (\uc120\ud0dd \uc0ac\ud56d)"],"Manual hard cutoff. Leave empty for unlimited access.":["\uc218\ub3d9 \uc885\ub8cc \uc2dc\uc810. \ubb34\uc81c\ud55c \uc811\uc18d\uc744 \uc6d0\ud558\uc2dc\uba74 \ube44\uc6cc \ub450\uc138\uc694."],"Active \u2014 visible to ticket holders":["\ud65c\uc131 \u2014 \ud2f0\ucf13 \ubcf4\uc720\uc790\uc5d0\uac8c \ud45c\uc2dc\ub428"],"Turn off to hide this congress everywhere (page + wallet) without unassigning it \u2014 e.g. to publish the info only later.":["\ud560\ub2f9 \ud574\uc81c\ud558\uc9c0 \uc54a\uace0\ub3c4 \uc774 \ucee8\uadf8\ub808\uc2a4\ub97c \ubaa8\ub4e0 \uacf3(\ud398\uc774\uc9c0 + \uc9c0\uac11)\uc5d0\uc11c \uc228\uae30\ub824\uba74 \ub044\uc138\uc694. \uc608: \uc815\ubcf4\ub97c \ub098\uc911\uc5d0 \uac8c\uc2dc\ud558\ub824\ub294 \uacbd\uc6b0."],"assigned (manage on product level)":["\ud560\ub2f9\ub428 (\uc0c1\ud488 \uc218\uc900\uc5d0\uc11c \uad00\ub9ac)"],"Assign via the WooCommerce product settings.":["WooCommerce \uc0c1\ud488 \uc124\uc815\uc5d0\uc11c \ud560\ub2f9\ud558\uc138\uc694."],"Save the congress first to add pages and sections.":["\ud398\uc774\uc9c0\uc640 \uc139\uc158\uc744 \ucd94\uac00\ud558\ub824\uba74 \uba3c\uc800 \ucee8\ud37c\ub7f0\uc2a4\ub97c \uc800\uc7a5\ud558\uc138\uc694."],"Pages":["\ud398\uc774\uc9c0\ub4e4"],"Add page":["\ud398\uc774\uc9c0 \ucd94\uac00"],"The first page is the start page (shown first to visitors). Drag pages and sections to reorder.":["\uccab \ubc88\uc9f8 \ud398\uc774\uc9c0\uac00 \uc2dc\uc791 \ud398\uc774\uc9c0\uc785\ub2c8\ub2e4(\ubc29\ubb38\uc790\uc5d0\uac8c \uba3c\uc800 \ud45c\uc2dc\ub428). \ud398\uc774\uc9c0\uc640 \uc139\uc158\uc744 \ub4dc\ub798\uadf8\ud558\uc5ec \uc21c\uc11c\ub97c \ubc14\uafb8\uc138\uc694."],"Save congress":["\ucee8\ud37c\ub7f0\uc2a4 \uc800\uc7a5"],"Rename page":["\ud398\uc774\uc9c0 \uc774\ub984 \ubcc0\uacbd"],"Delete page?":["\ud398\uc774\uc9c0\ub97c \uc0ad\uc81c\ud560\uae4c\uc694?"],"Its sections will be moved to the start page. This cannot be undone.":["\ud574\ub2f9 \uc139\uc158\uc740 \uc2dc\uc791 \ud398\uc774\uc9c0\ub85c \uc774\ub3d9\ub429\ub2c8\ub2e4. \uc774 \uc791\uc5c5\uc740 \ucde8\uc18c\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."],"Delete section?":["\uc139\uc158\uc744 \uc0ad\uc81c\ud560\uae4c\uc694?"],"This action cannot be undone.":["\uc774 \uc791\uc5c5\uc740 \ucde8\uc18c\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."],"OK":["\ud655\uc778"],"No icon":["\uc544\uc774\ucf58 \uc5c6\uc74c"],"Remove image":["\uc774\ubbf8\uc9c0 \uc81c\uac70"],"Choose image":["\uc774\ubbf8\uc9c0 \uc120\ud0dd"],"Select image":["\uc774\ubbf8\uc9c0 \uc120\ud0dd"],"Icon, optional image, card color and a short description shown on the page card.":["\ud398\uc774\uc9c0 \uce74\ub4dc\uc5d0 \ud45c\uc2dc\ub418\ub294 \uc544\uc774\ucf58, \uc120\ud0dd \uc774\ubbf8\uc9c0, \uce74\ub4dc \uc0c9\uc0c1, \uac04\ub2e8 \uc124\uba85\uc785\ub2c8\ub2e4."],"Icon":["\uc544\uc774\ucf58"],"Image (optional, overrides icon)":["\uc774\ubbf8\uc9c0(\uc120\ud0dd, \uc544\uc774\ucf58\uc744 \ub300\uccb4)"],"Card color":["\uce74\ub4dc \uc0c9\uc0c1"],"Short description (max 160)":["\uac04\ub2e8 \uc124\uba85(\ucd5c\ub300 160\uc790)"],"Page card settings":["\ud398\uc774\uc9c0 \uce74\ub4dc \uc124\uc815"],"No pages yet. Add a page to start.":["\uc544\uc9c1 \ud398\uc774\uc9c0\uac00 \uc5c6\uc2b5\ub2c8\ub2e4. \ud398\uc774\uc9c0\ub97c \ucd94\uac00\ud574 \uc2dc\uc791\ud558\uc138\uc694."],"Drag to reorder pages":["\ub4dc\ub798\uadf8\ud558\uc5ec \ud398\uc774\uc9c0 \uc21c\uc11c \ubcc0\uacbd"],"Start page":["\uc2dc\uc791 \ud398\uc774\uc9c0"],"Add section":["\uc139\uc158 \ucd94\uac00"],"Rename":["\uc774\ub984 \ubcc0\uacbd"],"Settings":["\uc124\uc815"],"No sections on this page yet.":["\uc774 \ud398\uc774\uc9c0\uc5d0\ub294 \uc544\uc9c1 \uc139\uc158\uc774 \uc5c6\uc2b5\ub2c8\ub2e4."],"Program":["\ud504\ub85c\uadf8\ub7a8"],"Image":["\uc774\ubbf8\uc9c0"],"Video":["\ube44\ub514\uc624"],"Gallery":["\uac24\ub7ec\ub9ac"],"Speakers":["\uc5f0\uc0ac"],"Type":["\uc720\ud615"],"start page":["\uc2dc\uc791 \ud398\uc774\uc9c0"],"Page":["\ud398\uc774\uc9c0"],"Choose which page this section belongs to. Change it to move the section to another page.":["\uc774 \uc139\uc158\uc774 \uc18d\ud560 \ud398\uc774\uc9c0\ub97c \uc120\ud0dd\ud558\uc138\uc694. \ub2e4\ub978 \ud398\uc774\uc9c0\ub85c \uc774\ub3d9\ud558\ub824\uba74 \ubcc0\uacbd\ud558\uc138\uc694."],"Content":["\ucf58\ud150\uce20"],"HTML allowed (same rules as blog posts). JavaScript is stripped.":["HTML \ud5c8\uc6a9 (\ube14\ub85c\uadf8 \uac8c\uc2dc\ubb3c\uacfc \ub3d9\uc77c\ud55c \uaddc\uce59). JavaScript\ub294 \uc81c\uac70\ub429\ub2c8\ub2e4."],"Insert variable\u2026":["\ubcc0\uc218 \uc0bd\uc785\u2026"],"Select file":["\ud30c\uc77c \uc120\ud0dd"],"Drag to reorder":["\ub4dc\ub798\uadf8\ud558\uc5ec \uc21c\uc11c \ubcc0\uacbd"],"No file selected":["\uc120\ud0dd\ub41c \ud30c\uc77c \uc5c6\uc74c"],"Label for visitors":["\ubc29\ubb38\uc790\uc6a9 \ub808\uc774\ube14"],"Choose":["\uc120\ud0dd"],"Open in browser instead of downloading (PDF, images).":["\ub2e4\uc6b4\ub85c\ub4dc \ub300\uc2e0 \ube0c\ub77c\uc6b0\uc800\uc5d0\uc11c \uc5f4\uae30 (PDF, \uc774\ubbf8\uc9c0)."],"Open inline":["\uc778\ub77c\uc778\uc73c\ub85c \uc5f4\uae30"],"Remove":["\uc0ad\uc81c"],"Add file":["\ud30c\uc77c \ucd94\uac00"],"Files":["\ud30c\uc77c"],"Pick files from the media library. Label is shown to visitors. Drag to reorder.":["\ubbf8\ub514\uc5b4 \ub77c\uc774\ube0c\ub7ec\ub9ac\uc5d0\uc11c \ud30c\uc77c\uc744 \uc120\ud0dd\ud558\uc138\uc694. \ub77c\ubca8\uc740 \ubc29\ubb38\uc790\uc5d0\uac8c \ud45c\uc2dc\ub429\ub2c8\ub2e4. \ub4dc\ub798\uadf8\ud558\uc5ec \uc21c\uc11c\ub97c \ubc14\uafb8\uc138\uc694."],"Label":["\ub77c\ubca8"],"Internal":["\ub0b4\ubd80"],"Add URL":["URL \ucd94\uac00"],"URLs":["URL"],"Internal links open in the same tab. External links open in a new tab. Drag to reorder.":["\ub0b4\ubd80 \ub9c1\ud06c\ub294 \uac19\uc740 \ud0ed\uc5d0\uc11c \uc5f4\ub9ac\uace0, \uc678\ubd80 \ub9c1\ud06c\ub294 \uc0c8 \ud0ed\uc5d0\uc11c \uc5f4\ub9bd\ub2c8\ub2e4. \ub4dc\ub798\uadf8\ud558\uc5ec \uc21c\uc11c\ub97c \ubcc0\uacbd\ud558\uc138\uc694."],"Caption (optional)":["\ucea1\uc158 (\uc120\ud0dd \uc0ac\ud56d)"],"Add image":["\uc774\ubbf8\uc9c0 \ucd94\