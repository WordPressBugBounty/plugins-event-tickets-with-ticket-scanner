msgstr ""
"Etkinse ve üründe bir tarih ayarlanmışsa, etkinliğin tarihi satın alma e-"
"postasında müşteriye gösterilecektir."

#: sasoEventtickets_Options.php:711
msgid "Show the event date on the product detail page for your customer"
msgstr "Müşteriniz için ürün detay sayfasında etkinlik tarihini göster"

#: sasoEventtickets_Options.php:711
msgid ""
"If active and a date is set on the product, then it will display the date of "
"the event on the product detail page to the client."
msgstr ""
"Etkinse ve üründe bir tarih ayarlanmışsa, etkinliğin tarihi ürün detay "
"sayfasında müşteriye gösterilecektir."

#: sasoEventtickets_Options.php:712
msgid "Hide the event date on the ticket"
msgstr "Bilet üzerindeki etkinlik tarihini gizle"

#: sasoEventtickets_Options.php:712
msgid "If active the event date is not shown on the ticket."
msgstr "Etkinse etkinlik tarihi bilet üzerinde gösterilmez."

