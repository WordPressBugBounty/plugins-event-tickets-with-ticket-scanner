{"translation-revision-date":"2026-03-24 18:00+0100","generator":"WP-CLI\/2.12.0","source":"js\/congress-a.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"hu_HU","plural-forms":"nplurals=2; plural=(n != 1);"},"Error":["Hiba"],"Active":["\u0395\u03bd\u03b5\u03c1\u03b3\u03cc"],"Status":["\u00c1llapot"],"Expired":["\u0388\u03bb\u03b7\u03be\u03b5"],"New congress":["\u039d\u03ad\u03bf \u03c3\u03c5\u03bd\u03ad\u03b4\u03c1\u03b9\u03bf"],"Title":["\u03a4\u03af\u03c4\u03bb\u03bf\u03c2"],"Products":["\u03a0\u03c1\u03bf\u03ca\u03cc\u03bd\u03c4\u03b1"],"Updated":["\u0395\u03bd\u03b7\u03bc\u03b5\u03c1\u03ce\u03b8\u03b7\u03ba\u03b5"],"Export contacts":["\u0395\u03be\u03b1\u03b3\u03c9\u03b3\u03ae \u03b5\u03c0\u03b1\u03c6\u03ce\u03bd"],"Edit":["Szerkeszt\u00e9s"],"New edition":["\u039d\u03ad\u03b1 \u03ad\u03ba\u03b4\u03bf\u03c3\u03b7"],"Delete":["T\u00f6rl\u00e9s"],"Congresses let you attach structured information (programme, downloads, media, texts) to an event. Ticket holders can access the congress page using their ticket ID. Assign a congress to a product in the WooCommerce product settings \u2014 one congress can be shared across multiple products.":["\u03a4\u03b1 \u03c3\u03c5\u03bd\u03ad\u03b4\u03c1\u03b9\u03b1 \u03c3\u03ac\u03c2 \u03b5\u03c0\u03b9\u03c4\u03c1\u03ad\u03c0\u03bf\u03c5\u03bd \u03bd\u03b1 \u03b5\u03c0\u03b9\u03c3\u03c5\u03bd\u03ac\u03c8\u03b5\u03c4\u03b5 \u03b4\u03bf\u03bc\u03b7\u03bc\u03ad\u03bd\u03b5\u03c2 \u03c0\u03bb\u03b7\u03c1\u03bf\u03c6\u03bf\u03c1\u03af\u03b5\u03c2 (\u03c0\u03c1\u03cc\u03b3\u03c1\u03b1\u03bc\u03bc\u03b1, \u03bb\u03ae\u03c8\u03b5\u03b9\u03c2, \u03c0\u03bf\u03bb\u03c5\u03bc\u03ad\u03c3\u03b1, \u03ba\u03b5\u03af\u03bc\u03b5\u03bd\u03b1) \u03c3\u03b5 \u03bc\u03b9\u03b1 \u03b5\u03ba\u03b4\u03ae\u03bb\u03c9\u03c3\u03b7. \u039f\u03b9 \u03ba\u03ac\u03c4\u03bf\u03c7\u03bf\u03b9 \u03b5\u03b9\u03c3\u03b9\u03c4\u03b7\u03c1\u03af\u03c9\u03bd \u03bc\u03c0\u03bf\u03c1\u03bf\u03cd\u03bd \u03bd\u03b1 \u03ad\u03c7\u03bf\u03c5\u03bd \u03c0\u03c1\u03cc\u03c3\u03b2\u03b1\u03c3\u03b7 \u03c3\u03c4\u03b7 \u03c3\u03b5\u03bb\u03af\u03b4\u03b1 \u03c4\u03bf\u03c5 \u03c3\u03c5\u03bd\u03b5\u03b4\u03c1\u03af\u03bf\u03c5 \u03c7\u03c1\u03b7\u03c3\u03b9\u03bc\u03bf\u03c0\u03bf\u03b9\u03ce\u03bd\u03c4\u03b1\u03c2 \u03c4\u03bf ID \u03c4\u03bf\u03c5 \u03b5\u03b9\u03c3\u03b9\u03c4\u03b7\u03c1\u03af\u03bf\u03c5 \u03c4\u03bf\u03c5\u03c2. \u0391\u03bd\u03b1\u03b8\u03ad\u03c3\u03c4\u03b5 \u03ad\u03bd\u03b1 \u03c3\u03c5\u03bd\u03ad\u03b4\u03c1\u03b9\u03bf \u03c3\u03b5 \u03ad\u03bd\u03b1 \u03c0\u03c1\u03bf\u03ca\u03cc\u03bd \u03c3\u03c4\u03b9\u03c2 \u03c1\u03c5\u03b8\u03bc\u03af\u03c3\u03b5\u03b9\u03c2 \u03c0\u03c1\u03bf\u03ca\u03cc\u03bd\u03c4\u03bf\u03c2 \u03c4\u03bf\u03c5 WooCommerce \u2014 \u03ad\u03bd\u03b1 \u03c3\u03c5\u03bd\u03ad\u03b4\u03c1\u03b9\u03bf \u03bc\u03c0\u03bf\u03c1\u03b5\u03af \u03bd\u03b1 \u03ba\u03bf\u03b9\u03bd\u03bf\u03c0\u03bf\u03b9\u03b7\u03b8\u03b5\u03af \u03c3\u03b5 \u03c0\u03bf\u03bb\u03bb\u03ac \u03c0\u03c1\u03bf\u03ca\u03cc\u03bd\u03c4\u03b1."],"Delete this congress?":["\u0394\u03b9\u03b1\u03b3\u03c1\u03b1\u03c6\u03ae \u03b1\u03c5\u03c4\u03bf\u03cd \u03c4\u03bf\u03c5 \u03c3\u03c5\u03bd\u03b5\u03b4\u03c1\u03af\u03bf\u03c5;"],"This action cannot be undone. All sections will be deleted as well.":["\u0391\u03c5\u03c4\u03ae \u03b7 \u03b5\u03bd\u03ad\u03c1\u03b3\u03b5\u03b9\u03b1 \u03b4\u03b5\u03bd \u03bc\u03c0\u03bf\u03c1\u03b5\u03af \u03bd\u03b1 \u03b1\u03bd\u03b1\u03b9\u03c1\u03b5\u03b8\u03b5\u03af. \u038c\u03bb\u03b5\u03c2 \u03bf\u03b9 \u03b5\u03bd\u03cc\u03c4\u03b7\u03c4\u03b5\u03c2 \u03b8\u03b1 \u03b4\u03b9\u03b1\u03b3\u03c1\u03b1\u03c6\u03bf\u03cd\u03bd \u03b5\u03c0\u03af\u03c3\u03b7\u03c2."],"Current title:":["\u03a4\u03c1\u03ad\u03c7\u03c9\u03bd \u03c4\u03af\u03c4\u03bb\u03bf\u03c2:"],"Current slug:":["\u03a4\u03c1\u03ad\u03c7\u03bf\u03bd slug:"],"Slug for new edition:":["Slug \u03b3\u03b9\u03b1 \u03c4\u03b7 \u03bd\u03ad\u03b1 \u03ad\u03ba\u03b4\u03bf\u03c3\u03b7:"],"Title for new edition (leave empty to auto-generate):":["\u03a4\u03af\u03c4\u03bb\u03bf\u03c2 \u03b3\u03b9\u03b1 \u03c4\u03b7 \u03bd\u03ad\u03b1 \u03ad\u03ba\u03b4\u03bf\u03c3\u03b7 (\u03b1\u03c6\u03ae\u03c3\u03c4\u03b5 \u03ba\u03b5\u03bd\u03cc \u03b3\u03b9\u03b1 \u03b1\u03c5\u03c4\u03cc\u03bc\u03b1\u03c4\u03b7 \u03b4\u03b7\u03bc\u03b9\u03bf\u03c5\u03c1\u03b3\u03af\u03b1):"],"Create":["\u0394\u03b7\u03bc\u03b9\u03bf\u03c5\u03c1\u03b3\u03af\u03b1"],"Cancel":["M\u00e9gse"],"Edit congress":["\u0395\u03c0\u03b5\u03be\u03b5\u03c1\u03b3\u03b1\u03c3\u03af\u03b1 \u03c3\u03c5\u03bd\u03b5\u03b4\u03c1\u03af\u03bf\u03c5"],"Details":["\u039b\u03b5\u03c0\u03c4\u03bf\u03bc\u03ad\u03c1\u03b5\u03b9\u03b5\u03c2"],"Unique identifier for this congress. Visitors open it through their personal ticket link, not the slug.":["\u039c\u03bf\u03bd\u03b1\u03b4\u03b9\u03ba\u03cc \u03b1\u03bd\u03b1\u03b3\u03bd\u03c9\u03c1\u03b9\u03c3\u03c4\u03b9\u03ba\u03cc \u03b3\u03b9\u03b1 \u03b1\u03c5\u03c4\u03cc \u03c4\u03bf \u03c3\u03c5\u03bd\u03ad\u03b4\u03c1\u03b9\u03bf. \u039f\u03b9 \u03b5\u03c0\u03b9\u03c3\u03ba\u03ad\u03c0\u03c4\u03b5\u03c2 \u03c4\u03bf \u03b1\u03bd\u03bf\u03af\u03b3\u03bf\u03c5\u03bd \u03bc\u03ad\u03c3\u03c9 \u03c4\u03bf\u03c5 \u03c0\u03c1\u03bf\u03c3\u03c9\u03c0\u03b9\u03ba\u03bf\u03cd \u03c4\u03bf\u03c5\u03c2 \u03c3\u03c5\u03bd\u03b4\u03ad\u03c3\u03bc\u03bf\u03c5 \u03b5\u03b9\u03c3\u03b9\u03c4\u03b7\u03c1\u03af\u03bf\u03c5, \u03cc\u03c7\u03b9 \u03bc\u03ad\u03c3\u03c9 \u03c4\u03bf\u03c5 slug."],"Portal label":["\u0395\u03c4\u03b9\u03ba\u03ad\u03c4\u03b1 \u03c0\u03cd\u03bb\u03b7\u03c2"],"Shown in the wallet and email (e.g. \"Opera evening\", \"Zoo visit\"). Empty = use the global default.":["\u0395\u03bc\u03c6\u03b1\u03bd\u03af\u03b6\u03b5\u03c4\u03b1\u03b9 \u03c3\u03c4\u03bf wallet \u03ba\u03b1\u03b9 \u03c3\u03c4\u03bf email (\u03c0.\u03c7. \u00ab\u0392\u03c1\u03b1\u03b4\u03b9\u03ac \u03cc\u03c0\u03b5\u03c1\u03b1\u03c2\u00bb, \u00ab\u0395\u03c0\u03af\u03c3\u03ba\u03b5\u03c8\u03b7 \u03c3\u03b5 \u03b6\u03c9\u03bf\u03bb\u03bf\u03b3\u03b9\u03ba\u03cc \u03ba\u03ae\u03c0\u03bf\u00bb). \u039a\u03b5\u03bd\u03cc = \u03c7\u03c1\u03ae\u03c3\u03b7 \u03c4\u03b7\u03c2 \u03ba\u03b1\u03b8\u03bf\u03bb\u03b9\u03ba\u03ae\u03c2 \u03c0\u03c1\u03bf\u03b5\u03c0\u03b9\u03bb\u03bf\u03b3\u03ae\u03c2."],"Show pages as a card grid on the start screen":["\u0395\u03bc\u03c6\u03ac\u03bd\u03b9\u03c3\u03b7 \u03c3\u03b5\u03bb\u03af\u03b4\u03c9\u03bd \u03c9\u03c2 \u03c0\u03bb\u03ad\u03b3\u03bc\u03b1 \u03ba\u03b1\u03c1\u03c4\u03ce\u03bd \u03c3\u03c4\u03b7\u03bd \u03b1\u03c1\u03c7\u03b9\u03ba\u03ae \u03bf\u03b8\u03cc\u03bd\u03b7"],"Visitors first see a grid of page cards (icon\/image + description) instead of jumping straight into the first page.":["\u039f\u03b9 \u03b5\u03c0\u03b9\u03c3\u03ba\u03ad\u03c0\u03c4\u03b5\u03c2 \u03b2\u03bb\u03ad\u03c0\u03bf\u03c5\u03bd \u03c0\u03c1\u03ce\u03c4\u03b1 \u03ad\u03bd\u03b1 \u03c0\u03bb\u03ad\u03b3\u03bc\u03b1 \u03ba\u03b1\u03c1\u03c4\u03ce\u03bd \u03c3\u03b5\u03bb\u03af\u03b4\u03c9\u03bd (\u03b5\u03b9\u03ba\u03bf\u03bd\u03af\u03b4\u03b9\u03bf\/\u03b5\u03b9\u03ba\u03cc\u03bd\u03b1 + \u03c0\u03b5\u03c1\u03b9\u03b3\u03c1\u03b1\u03c6\u03ae) \u03b1\u03bd\u03c4\u03af \u03bd\u03b1 \u03bc\u03b5\u03c4\u03b1\u03c0\u03b7\u03b4\u03bf\u03cd\u03bd \u03b1\u03c0\u03b5\u03c5\u03b8\u03b5\u03af\u03b1\u03c2 \u03c3\u03c4\u03b7\u03bd \u03c0\u03c1\u03ce\u03c4\u03b7 \u03c3\u03b5\u03bb\u03af\u03b4\u03b1."],"Access expires (optional)":["\u039b\u03ae\u03be\u03b7 \u03c0\u03c1\u03cc\u03c3\u03b2\u03b1\u03c3\u03b7\u03c2 (\u03c0\u03c1\u03bf\u03b1\u03b9\u03c1\u03b5\u03c4\u03b9\u03ba\u03cc)"],"Manual hard cutoff. Leave empty for unlimited access.":["\u03a7\u03b5\u03b9\u03c1\u03bf\u03ba\u03af\u03bd\u03b7\u03c4\u03b7 \u03bf\u03c1\u03b9\u03c3\u03c4\u03b9\u03ba\u03ae \u03bb\u03ae\u03be\u03b7. \u0391\u03c6\u03ae\u03c3\u03c4\u03b5 \u03ba\u03b5\u03bd\u03cc \u03b3\u03b9\u03b1 \u03b1\u03c0\u03b5\u03c1\u03b9\u03cc\u03c1\u03b9\u03c3\u03c4\u03b7 \u03c0\u03c1\u03cc\u03c3\u03b2\u03b1\u03c3\u03b7."],"Active \u2014 visible to ticket holders":["\u0395\u03bd\u03b5\u03c1\u03b3\u03cc \u2014 \u03bf\u03c1\u03b1\u03c4\u03cc \u03c3\u03c4\u03bf\u03c5\u03c2 \u03ba\u03b1\u03c4\u03cc\u03c7\u03bf\u03c5\u03c2 \u03b5\u03b9\u03c3\u03b9\u03c4\u03b7\u03c1\u03af\u03c9\u03bd"],"Turn off to hide this congress everywhere (page + wallet) without unassigning it \u2014 e.g. to publish the info only later.":["\u0391\u03c0\u03b5\u03bd\u03b5\u03c1\u03b3\u03bf\u03c0\u03bf\u03b9\u03ae\u03c3\u03c4\u03b5 \u03b3\u03b9\u03b1 \u03bd\u03b1 \u03b1\u03c0\u03bf\u03ba\u03c1\u03cd\u03c8\u03b5\u03c4\u03b5 \u03b1\u03c5\u03c4\u03cc \u03c4\u03bf \u03c3\u03c5\u03bd\u03ad\u03b4\u03c1\u03b9\u03bf \u03c0\u03b1\u03bd\u03c4\u03bf\u03cd (\u03c3\u03b5\u03bb\u03af\u03b4\u03b1 + wallet) \u03c7\u03c9\u03c1\u03af\u03c2 \u03bd\u03b1 \u03c4\u03bf \u03b1\u03c6\u03b1\u03b9\u03c1\u03ad\u03c3\u03b5\u03c4\u03b5 \u2014 \u03c0.\u03c7. \u03b3\u03b9\u03b1 \u03bd\u03b1 \u03b4\u03b7\u03bc\u03bf\u03c3\u03b9\u03b5\u03cd\u03c3\u03b5\u03c4\u03b5 \u03c4\u03b9\u03c2 \u03c0\u03bb\u03b7\u03c1\u03bf\u03c6\u03bf\u03c1\u03af\u03b5\u03c2 \u03b1\u03c1\u03b3\u03cc\u03c4\u03b5\u03c1\u03b1."],"assigned (manage on product level)":["\u03b1\u03bd\u03b1\u03c4\u03b5\u03b8\u03b5\u03b9\u03bc\u03ad\u03bd\u03bf (\u03b4\u03b9\u03b1\u03c7\u03b5\u03af\u03c1\u03b9\u03c3\u03b7 \u03c3\u03b5 \u03b5\u03c0\u03af\u03c0\u03b5\u03b4\u03bf \u03c0\u03c1\u03bf\u03ca\u03cc\u03bd\u03c4\u03bf\u03c2)"],"Assign via the WooCommerce product settings.":["\u0391\u03bd\u03ac\u03b8\u03b5\u03c3\u03b7 \u03bc\u03ad\u03c3\u03c9 \u03c4\u03c9\u03bd \u03c1\u03c5\u03b8\u03bc\u03af\u03c3\u03b5\u03c9\u03bd \u03c0\u03c1\u03bf\u03ca\u03cc\u03bd\u03c4\u03bf\u03c2 \u03c4\u03bf\u03c5 WooCommerce."],"Save the congress first to add pages and sections.":["\u0391\u03c0\u03bf\u03b8\u03b7\u03ba\u03b5\u03cd\u03c3\u03c4\u03b5 \u03c0\u03c1\u03ce\u03c4\u03b1 \u03c4\u03bf \u03c3\u03c5\u03bd\u03ad\u03b4\u03c1\u03b9\u03bf \u03b3\u03b9\u03b1 \u03bd\u03b1 \u03c0\u03c1\u03bf\u03c3\u03b8\u03ad\u03c3\u03b5\u03c4\u03b5 \u03c3\u03b5\u03bb\u03af\u03b4\u03b5\u03c2 \u03ba\u03b1\u03b9 \u03b5\u03bd\u03cc\u03c4\u03b7\u03c4\u03b5\u03c2."],"Pages":["\u03a3\u03b5\u03bb\u03af\u03b4\u03b5\u03c2"],"Add page":["\u03a0\u03c1\u03bf\u03c3\u03b8\u03ae\u03ba\u03b7 \u03c3\u03b5\u03bb\u03af\u03b4\u03b1\u03c2"],"The first page is the start page (shown first to visitors). Drag pages and sections to reorder.":["\u0397 \u03c0\u03c1\u03ce\u03c4\u03b7 \u03c3\u03b5\u03bb\u03af\u03b4\u03b1 \u03b5\u03af\u03bd\u03b1\u03b9 \u03b7 \u03b1\u03c1\u03c7\u03b9\u03ba\u03ae (\u03b5\u03bc\u03c6\u03b1\u03bd\u03af\u03b6\u03b5\u03c4\u03b1\u03b9 \u03c0\u03c1\u03ce\u03c4\u03b7 \u03c3\u03c4\u03bf\u03c5\u03c2 \u03b5\u03c0\u03b9\u03c3\u03ba\u03ad\u03c0\u03c4\u03b5\u03c2). \u03a3\u03cd\u03c1\u03b5\u03c4\u03b5 \u03c3\u03b5\u03bb\u03af\u03b4\u03b5\u03c2 \u03ba\u03b1\u03b9 \u03b5\u03bd\u03cc\u03c4\u03b7\u03c4\u03b5\u03c2 \u03b3\u03b9\u03b1 \u03b1\u03bd\u03b1\u03b4\u03b9\u03ac\u03c4\u03b1\u03be\u03b7."],"Save congress":["\u0391\u03c0\u03bf\u03b8\u03ae\u03ba\u03b5\u03c5\u03c3\u03b7 \u03c3\u03c5\u03bd\u03b5\u03b4\u03c1\u03af\u03bf\u03c5"],"Rename page":["\u039c\u03b5\u03c4\u03bf\u03bd\u03bf\u03bc\u03b1\u03c3\u03af\u03b1 \u03c3\u03b5\u03bb\u03af\u03b4\u03b1\u03c2"],"Delete page?":["\u0394\u03b9\u03b1\u03b3\u03c1\u03b1\u03c6\u03ae \u03c3\u03b5\u03bb\u03af\u03b4\u03b1\u03c2;"],"Its sections will be moved to the start page. This cannot be undone.":["\u039f\u03b9 \u03b5\u03bd\u03cc\u03c4\u03b7\u03c4\u03ad\u03c2 \u03c4\u03bf\u03c5 \u03b8\u03b1 \u03bc\u03b5\u03c4\u03b1\u03ba\u03b9\u03bd\u03b7\u03b8\u03bf\u03cd\u03bd \u03c3\u03c4\u03b7\u03bd \u03b1\u03c1\u03c7\u03b9\u03ba\u03ae \u03c3\u03b5\u03bb\u03af\u03b4\u03b1. \u0391\u03c5\u03c4\u03cc \u03b4\u03b5\u03bd \u03bc\u03c0\u03bf\u03c1\u03b5\u03af \u03bd\u03b1 \u03b1\u03bd\u03b1\u03b9\u03c1\u03b5\u03b8\u03b5\u03af."],"Delete section?":["\u0394\u03b9\u03b1\u03b3\u03c1\u03b1\u03c6\u03ae \u03b5\u03bd\u03cc\u03c4\u03b7\u03c4\u03b1\u03c2;"],"This action cannot be undone.":["\u0391\u03c5\u