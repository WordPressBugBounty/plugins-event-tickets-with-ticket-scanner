{"translation-revision-date":"2026-03-24 18:00+0100","generator":"WP-CLI\/2.12.0","source":"js\/congress-a.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"hu_HU","plural-forms":"nplurals=2; plural=(n != 1);"},"Error":["Hiba"],"Active":["\u0646\u0634\u0637"],"Status":["\u00c1llapot"],"Expired":["\u0645\u0646\u062a\u0647\u064a"],"New congress":["\u0645\u0624\u062a\u0645\u0631 \u062c\u062f\u064a\u062f"],"Title":["\u0627\u0644\u0639\u0646\u0648\u0627\u0646"],"Products":["\u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a"],"Updated":["\u062a\u0645 \u0627\u0644\u062a\u062d\u062f\u064a\u062b"],"Export contacts":["\u062a\u0635\u062f\u064a\u0631 \u062c\u0647\u0627\u062a \u0627\u0644\u0627\u062a\u0635\u0627\u0644"],"Edit":["Szerkeszt\u00e9s"],"New edition":["\u0637\u0628\u0639\u0629 \u062c\u062f\u064a\u062f\u0629"],"Delete":["T\u00f6rl\u00e9s"],"Congresses let you attach structured information (programme, downloads, media, texts) to an event. Ticket holders can access the congress page using their ticket ID. Assign a congress to a product in the WooCommerce product settings \u2014 one congress can be shared across multiple products.":["\u062a\u062a\u064a\u062d \u0644\u0643 \u0627\u0644\u0645\u0624\u062a\u0645\u0631\u0627\u062a \u0625\u0631\u0641\u0627\u0642 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0645\u0646\u0638\u0645\u0629 (\u0627\u0644\u0628\u0631\u0646\u0627\u0645\u062c\u060c \u0627\u0644\u062a\u062d\u0645\u064a\u0644\u0627\u062a\u060c \u0627\u0644\u0648\u0633\u0627\u0626\u0637\u060c \u0627\u0644\u0646\u0635\u0648\u0635) \u0628\u062d\u062f\u062b. \u064a\u0645\u0643\u0646 \u0644\u062d\u0627\u0645\u0644\u064a \u0627\u0644\u062a\u0630\u0627\u0643\u0631 \u0627\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u0649 \u0635\u0641\u062d\u0629 \u0627\u0644\u0645\u0624\u062a\u0645\u0631 \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0645\u0639\u0631\u0641 \u0627\u0644\u062a\u0630\u0643\u0631\u0629. \u0639\u064a\u0651\u0646 \u0645\u0624\u062a\u0645\u0631\u064b\u0627 \u0644\u0645\u0646\u062a\u062c \u0641\u064a \u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0645\u0646\u062a\u062c WooCommerce \u2014 \u064a\u0645\u0643\u0646 \u0645\u0634\u0627\u0631\u0643\u0629 \u0645\u0624\u062a\u0645\u0631 \u0648\u0627\u062d\u062f \u0639\u0628\u0631 \u0639\u062f\u0629 \u0645\u0646\u062a\u062c\u0627\u062a."],"Delete this congress?":["\u062d\u0630\u0641 \u0647\u0630\u0627 \u0627\u0644\u0645\u0624\u062a\u0645\u0631\u061f"],"This action cannot be undone. All sections will be deleted as well.":["\u0644\u0627 \u064a\u0645\u0643\u0646 \u0627\u0644\u062a\u0631\u0627\u062c\u0639 \u0639\u0646 \u0647\u0630\u0627 \u0627\u0644\u0625\u062c\u0631\u0627\u0621. \u0633\u064a\u062a\u0645 \u062d\u0630\u0641 \u062c\u0645\u064a\u0639 \u0627\u0644\u0623\u0642\u0633\u0627\u0645 \u0623\u064a\u0636\u064b\u0627."],"Current title:":["\u0627\u0644\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u062d\u0627\u0644\u064a:"],"Current slug:":["\u0627\u0644\u0631\u0627\u0628\u0637 \u0627\u0644\u062d\u0627\u0644\u064a:"],"Slug for new edition:":["\u0627\u0644\u0631\u0627\u0628\u0637 \u0644\u0644\u0637\u0628\u0639\u0629 \u0627\u0644\u062c\u062f\u064a\u062f\u0629:"],"Title for new edition (leave empty to auto-generate):":["\u0639\u0646\u0648\u0627\u0646 \u0644\u0644\u0637\u0628\u0639\u0629 \u0627\u0644\u062c\u062f\u064a\u062f\u0629 (\u0627\u062a\u0631\u0643\u0647 \u0641\u0627\u0631\u063a\u064b\u0627 \u0644\u0644\u062a\u0648\u0644\u064a\u062f \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a):"],"Create":["\u0625\u0646\u0634\u0627\u0621"],"Cancel":["M\u00e9gse"],"Edit congress":["\u062a\u0639\u062f\u064a\u0644 \u0627\u0644\u0645\u0624\u062a\u0645\u0631"],"Details":["\u0627\u0644\u062a\u0641\u0627\u0635\u064a\u0644"],"Unique identifier for this congress. Visitors open it through their personal ticket link, not the slug.":["\u0645\u0639\u0631\u0651\u0641 \u0641\u0631\u064a\u062f \u0644\u0647\u0630\u0627 \u0627\u0644\u0645\u0624\u062a\u0645\u0631. \u064a\u0641\u062a\u062d\u0647 \u0627\u0644\u0632\u0648\u0627\u0631 \u0645\u0646 \u062e\u0644\u0627\u0644 \u0631\u0627\u0628\u0637 \u0627\u0644\u062a\u0630\u0643\u0631\u0629 \u0627\u0644\u0634\u062e\u0635\u064a \u0627\u0644\u062e\u0627\u0635 \u0628\u0647\u0645\u060c \u0648\u0644\u064a\u0633 \u0627\u0644\u0631\u0627\u0628\u0637."],"Portal label":["\u062a\u0633\u0645\u064a\u0629 \u0627\u0644\u0628\u0648\u0627\u0628\u0629"],"Shown in the wallet and email (e.g. \"Opera evening\", \"Zoo visit\"). Empty = use the global default.":["\u064a\u0638\u0647\u0631 \u0641\u064a \u0627\u0644\u0645\u062d\u0641\u0638\u0629 \u0648\u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a (\u0645\u062b\u0644 \"\u0645\u0633\u0627\u0621 \u0627\u0644\u0623\u0648\u0628\u0631\u0627\"\u060c \"\u0632\u064a\u0627\u0631\u0629 \u062d\u062f\u064a\u0642\u0629 \u0627\u0644\u062d\u064a\u0648\u0627\u0646\"). \u0641\u0627\u0631\u063a = \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a \u0627\u0644\u0639\u0627\u0645."],"Show pages as a card grid on the start screen":["\u0625\u0638\u0647\u0627\u0631 \u0627\u0644\u0635\u0641\u062d\u0627\u062a \u0643\u0634\u0628\u0643\u0629 \u0628\u0637\u0627\u0642\u0627\u062a \u0639\u0644\u0649 \u0634\u0627\u0634\u0629 \u0627\u0644\u0628\u062f\u0627\u064a\u0629"],"Visitors first see a grid of page cards (icon\/image + description) instead of jumping straight into the first page.":["\u064a\u0631\u0649 \u0627\u0644\u0632\u0648\u0627\u0631 \u0623\u0648\u0644\u0627\u064b \u0634\u0628\u0643\u0629 \u0645\u0646 \u0628\u0637\u0627\u0642\u0627\u062a \u0627\u0644\u0635\u0641\u062d\u0629 (\u0623\u064a\u0642\u0648\u0646\u0629\/\u0635\u0648\u0631\u0629 + \u0648\u0635\u0641) \u0628\u062f\u0644\u0627\u064b \u0645\u0646 \u0627\u0644\u0627\u0646\u062a\u0642\u0627\u0644 \u0645\u0628\u0627\u0634\u0631\u0629 \u0625\u0644\u0649 \u0627\u0644\u0635\u0641\u062d\u0629 \u0627\u0644\u0623\u0648\u0644\u0649."],"Access expires (optional)":["\u0627\u0646\u062a\u0647\u0627\u0621 \u0635\u0644\u0627\u062d\u064a\u0629 \u0627\u0644\u0648\u0635\u0648\u0644 (\u0627\u062e\u062a\u064a\u0627\u0631\u064a)"],"Manual hard cutoff. Leave empty for unlimited access.":["\u0625\u064a\u0642\u0627\u0641 \u064a\u062f\u0648\u064a \u0635\u0627\u0631\u0645. \u0627\u062a\u0631\u0643\u0647 \u0641\u0627\u0631\u063a\u064b\u0627 \u0644\u0648\u0635\u0648\u0644 \u063a\u064a\u0631 \u0645\u062d\u062f\u0648\u062f."],"Active \u2014 visible to ticket holders":["\u0646\u0634\u0637 \u2014 \u0645\u0631\u0626\u064a \u0644\u062d\u0627\u0645\u0644\u064a \u0627\u0644\u062a\u0630\u0627\u0643\u0631"],"Turn off to hide this congress everywhere (page + wallet) without unassigning it \u2014 e.g. to publish the info only later.":["\u0642\u0645 \u0628\u0625\u064a\u0642\u0627\u0641\u0647 \u0644\u0625\u062e\u0641\u0627\u0621 \u0647\u0630\u0627 \u0627\u0644\u0645\u0624\u062a\u0645\u0631 \u0641\u064a \u0643\u0644 \u0645\u0643\u0627\u0646 (\u0635\u0641\u062d\u0629 + \u0645\u062d\u0641\u0638\u0629) \u062f\u0648\u0646 \u0625\u0644\u063a\u0627\u0621 \u062a\u0639\u064a\u064a\u0646\u0647 \u2014 \u0639\u0644\u0649 \u0633\u0628\u064a\u0644 \u0627\u0644\u0645\u062b\u0627\u0644 \u0644\u0646\u0634\u0631 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0644\u0627\u062d\u0642\u0627\u064b \u0641\u0642\u0637."],"assigned (manage on product level)":["\u0645\u0639\u064a\u0651\u0646 (\u0625\u062f\u0627\u0631\u0629 \u0639\u0644\u0649 \u0645\u0633\u062a\u0648\u0649 \u0627\u0644\u0645\u0646\u062a\u062c)"],"Assign via the WooCommerce product settings.":["\u0627\u0644\u062a\u062e\u0635\u064a\u0635 \u0639\u0628\u0631 \u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0645\u0646\u062a\u062c WooCommerce."],"Save the congress first to add pages and sections.":["\u0627\u062d\u0641\u0638 \u0627\u0644\u0645\u0624\u062a\u0645\u0631 \u0623\u0648\u0644\u0627\u064b \u0644\u0625\u0636\u0627\u0641\u0629 \u0627\u0644\u0635\u0641\u062d\u0627\u062a \u0648\u0627\u0644\u0623\u0642\u0633\u0627\u0645."],"Pages":["\u0635\u0641\u062d\u0627\u062a"],"Add page":["\u0625\u0636\u0627\u0641\u0629 \u0635\u0641\u062d\u0629"],"The first page is the start page (shown first to visitors). Drag pages and sections to reorder.":["\u0627\u0644\u0635\u0641\u062d\u0629 \u0627\u0644\u0623\u0648\u0644\u0649 \u0647\u064a \u0635\u0641\u062d\u0629 \u0627\u0644\u0628\u062f\u0627\u064a\u0629 (\u062a\u0638\u0647\u0631 \u0623\u0648\u0644\u0627\u064b \u0644\u0644\u0632\u0648\u0627\u0631). \u0627\u0633\u062d\u0628 \u0627\u0644\u0635\u0641\u062d\u0627\u062a \u0648\u0627\u0644\u0623\u0642\u0633\u0627\u0645 \u0644\u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u062a\u0631\u062a\u064a\u0628."],"Save congress":["\u062d\u0641\u0638 \u0627\u0644\u0645\u0624\u062a\u0645\u0631"],"Rename page":["\u0625\u0639\u0627\u062f\u0629 \u062a\u0633\u0645\u064a\u0629 \u0627\u0644\u0635\u0641\u062d\u0629"],"Delete page?":["\u062d\u0630\u0641 \u0627\u0644\u0635\u0641\u062d\u0629\u061f"],"Its sections will be moved to the start page. This cannot be undone.":["\u0633\u064a\u062a\u0645 \u0646\u0642\u0644 \u0623\u0642\u0633\u0627\u0645\u0647\u0627 \u0625\u0644\u0649 \u0635\u0641\u062d\u0629 \u0627\u0644\u0628\u062f\u0627\u064a\u0629. \u0644\u0627 \u064a\u0645\u0643\u0646 \u0627\u0644\u062a\u0631\u0627\u062c\u0639 \u0639\u0646 \u0647\u0630\u0627 \u0627\u0644\u0625\u062c\u0631\u0627\u0621."],"Delete section?":["\u062d\u0630\u0641 \u0627\u0644\u0642\u0633\u0645\u061f"],"This action cannot be undone.":["\u0644\u0627 \u064a\u0645\u0643\u0646 \u0627\u0644\u062a\u0631\u0627\u062c\u0639 \u0639\u0646 \u0647\u0630\u0627 \u0627\u0644\u0625\u062c\u0631\u0627\u0621."],"OK":["\u062d\u0633\u0646\u064b\u0627"],"No icon":["\u0628\u062f\u0648\u0646 \u0623\u064a\u0642\u0648\u0646\u0629"],"Remove image":["\u0625\u0632\u0627\u0644\u0629 \u0627\u0644\u0635\u0648\u0631\u0629"],"Choose image":["\u0627\u062e\u062a\u064a\u0627\u0631 \u0635\u0648\u0631\u0629"],"Select image":["\u062a\u062d\u062f\u064a\u062f \u0635\u0648\u0631\u0629"],"Icon, op