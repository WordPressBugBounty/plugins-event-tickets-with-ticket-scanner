03b1. \u03a3\u03cd\u03c1\u03b5\u03c4\u03b5 \u03b3\u03b9\u03b1 \u03b1\u03bd\u03b1\u03b4\u03b9\u03ac\u03c4\u03b1\u03be\u03b7."],"Choose video":["\u0395\u03c0\u03b9\u03bb\u03bf\u03b3\u03ae \u03b2\u03af\u03bd\u03c4\u03b5\u03bf"],"Delete this event app?":[""],"Its sections will be moved to the start page. This cannot be undone.":["\u039f\u03b9 \u03b5\u03bd\u03cc\u03c4\u03b7\u03c4\u03ad\u03c2 \u03c4\u03bf\u03c5 \u03b8\u03b1 \u03bc\u03b5\u03c4\u03b1\u03ba\u03b9\u03bd\u03b7\u03b8\u03bf\u03cd\u03bd \u03c3\u03c4\u03b7\u03bd \u03b1\u03c1\u03c7\u03b9\u03ba\u03ae \u03c3\u03b5\u03bb\u03af\u03b4\u03b1. \u0391\u03c5\u03c4\u03cc \u03b4\u03b5\u03bd \u03bc\u03c0\u03bf\u03c1\u03b5\u03af \u03bd\u03b1 \u03b1\u03bd\u03b1\u03b9\u03c1\u03b5\u03b8\u03b5\u03af."],"URLs":["URL"],"Add section":["\u03a0\u03c1\u03bf\u03c3\u03b8\u03ae\u03ba\u03b7 \u03b5\u03bd\u03cc\u03c4\u03b7\u03c4\u03b1\u03c2"],"Gallery":["\u03a3\u03c5\u03bb\u03bb\u03bf\u03b3\u03ae"],"Delete":["T\u00f6rl\u00e9s"],"Add days and time slots. Each slot has time, title, speaker and room.":["\u03a0\u03c1\u03bf\u03c3\u03b8\u03ad\u03c3\u03c4\u03b5 \u03b7\u03bc\u03ad\u03c1\u03b5\u03c2 \u03ba\u03b1\u03b9 \u03c7\u03c1\u03bf\u03bd\u03b9\u03ba\u03ad\u03c2 \u03b8\u03ad\u03c3\u03b5\u03b9\u03c2. \u039a\u03ac\u03b8\u03b5 \u03b8\u03ad\u03c3\u03b7 \u03ad\u03c7\u03b5\u03b9 \u03ce\u03c1\u03b1, \u03c4\u03af\u03c4\u03bb\u03bf, \u03bf\u03bc\u03b9\u03bb\u03b7\u03c4\u03ae \u03ba\u03b1\u03b9 \u03b1\u03af\u03b8\u03bf\u03c5\u03c3\u03b1."],"Create":["\u0394\u03b7\u03bc\u03b9\u03bf\u03c5\u03c1\u03b3\u03af\u03b1"],"Edit event app":[""],"Shown in the wallet and email (e.g. \"Opera evening\", \"Zoo visit\"). Empty = use the global default.":["\u0395\u03bc\u03c6\u03b1\u03bd\u03af\u03b6\u03b5\u03c4\u03b1\u03b9 \u03c3\u03c4\u03bf wallet \u03ba\u03b1\u03b9 \u03c3\u03c4\u03bf email (\u03c0.\u03c7. \u00ab\u0392\u03c1\u03b1\u03b4\u03b9\u03ac \u03cc\u03c0\u03b5\u03c1\u03b1\u03c2\u00bb, \u00ab\u0395\u03c0\u03af\u03c3\u03ba\u03b5\u03c8\u03b7 \u03c3\u03b5 \u03b6\u03c9\u03b