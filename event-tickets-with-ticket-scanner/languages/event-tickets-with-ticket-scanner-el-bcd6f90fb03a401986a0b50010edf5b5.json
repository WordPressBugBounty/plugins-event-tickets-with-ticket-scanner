{"translation-revision-date":"2026-03-24 18:00+0100","generator":"WP-CLI\/2.12.0","source":"js\/congress-a.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"hu_HU","plural-forms":"nplurals=2; plural=(n != 1);"},"Title":["\u03a4\u03af\u03c4\u03bb\u03bf\u03c2"],"Add":["Hozz\u00e1ad\u00e1s"],"Export contacts":["\u0395\u03be\u03b1\u03b3\u03c9\u03b3\u03ae \u03b5\u03c0\u03b1\u03c6\u03ce\u03bd"],"Portal label":["\u0395\u03c4\u03b9\u03ba\u03ad\u03c4\u03b1 \u03c0\u03cd\u03bb\u03b7\u03c2"],"Shown in the wallet and email (e.g. \"Opera evening\", \"Zoo visit\"). Empty = use the global default.":["\u0395\u03bc\u03c6\u03b1\u03bd\u03af\u03b6\u03b5\u03c4\u03b1\u03b9 \u03c3\u03c4\u03bf wallet \u03ba\u03b1\u03b9 \u03c3\u03c4\u03bf email (\u03c0.\u03c7. \u00ab\u0392\u03c1\u03b1\u03b4\u03b9\u03ac \u03cc\u03c0\u03b5\u03c1\u03b1\u03c2\u00bb, \u00ab\u0395\u03c0\u03af\u03c3\u03ba\u03b5\u03c8\u03b7 \u03c3\u03b5 \u03b6\u03c9\u03bf\u03bb\u03bf\u03b3\u03b9\u03ba\u03cc \u03ba\u03ae\u03c0\u03bf\u00bb). \u039a\u03b5\u03bd\u03cc = \u03c7\u03c1\u03ae\u03c3\u03b7 \u03c4\u03b7\u03c2 \u03ba\u03b1\u03b8\u03bf\u03bb\u03b9\u03ba\u03ae\u03c2 \u03c0\u03c1\u03bf\u03b5\u03c0\u03b9\u03bb\u03bf\u03b3\u03ae\u03c2."],"Show pages as a card grid on the start screen":["\u0395\u03bc\u03c6\u03ac\u03bd\u03b9\u03c3\u03b7 \u03c3\u03b5\u03bb\u03af\u03b4\u03c9\u03bd \u03c9\u03c2 \u03c0\u03bb\u03ad\u03b3\u03bc\u03b1 \u03ba\u03b1\u03c1\u03c4\u03ce\u03bd \u03c3\u03c4\u03b7\u03bd \u03b1\u03c1\u03c7\u03b9\u03ba\u03ae \u03bf\u03b8\u03cc\u03bd\u03b7"],"Visitors first see a grid of page cards (icon\/image + description) instead of jumping straight into the first page.":["\u039f\u03b9 \u03b5\u03c0\u03b9\u03c3\u03ba\u03ad\u03c0\u03c4\u03b5\u03c2 \u03b2\u03bb\u03ad\u03c0\u03bf\u03c5\u03bd \u03c0\u03c1\u03ce\u03c4\u03b1 \u03ad\u03bd\u03b1 \u03c0\u03bb\u03ad\u03b3\u03bc\u03b1 \u03ba\u03b1\u03c1\u03c4\u03ce\u03bd \u03c3\u03b5\u03bb\u03af\u03b4\u03c9\u03bd (\u03b5\u03b9\u03ba\u03bf\u03bd\u03af\u03b4\u03b9\u03bf\/\u03b5\u03b9\u03ba\u03cc\u03bd\u03b1 + \u03c0\u03b5\u03c1\u03b9\u03b3\u03c1\u03b1\u03c6\u03ae) \u03b1\u03bd\u03c4\u03af \u03bd\u03b1 \u03bc\u03b5\u03c4\u03b1\u03c0\u03b7\u03b4\u03bf\u03cd\u03bd \u03b1\u03c0\u03b5\u03c5\u03b8\u03b5\u03af\u03b1\u03c2 \u03c3\u03c4\u03b7\u03bd \u03c0\u03c1\u03ce\u03c4\u03b7 \u03c3\u03b5\u03bb\u03af\u03b4\u03b1."],"Active \u2014 visible to ticket holders":["\u0395\u03bd\u03b5\u03c1\u03b3\u03cc \u2014 \u03bf\u03c1\u03b1\u03c4\u03cc \u03c3\u03c4\u03bf\u03c5\u03c2 \u03ba\u03b1\u03c4\u03cc\u03c7\u03bf\u03c5\u03c2 \u03b5\u03b9\u03c3\u03b9\u03c4\u03b7\u03c1\u03af\u03c9\u03bd"],"Turn off to hide this congress everywhere (page + wallet) without unassigning it \u2014 e.g. to publish the info only later.":["\u0391\u03c0\u03b5\u03bd\u03b5\u03c1\u03b3\u03bf\u03c0\u03bf\u03b9\u03ae\u03c3\u03c4\u03b5 \u03b3\u03b9\u03b1 \u03bd\u03b1 \u03b1\u03c0\u03bf\u03ba\u03c1\u03cd\u03c8\u03b5\u03c4\u03b5 \u03b1\u03c5\u03c4\u03cc \u03c4\u03bf \u03c3\u03c5\u03bd\u03ad\u03b4\u03c1\u03b9\u03bf \u03c0\u03b1\u03bd\u03c4\u03bf\u03cd (\u03c3\u03b5\u03bb\u03af\u03b4\u03b1 + wallet) \u03c7\u03c9\u03c1\u03af\u03c2 \u03bd\u03b1 \u03c4\u03bf \u03b1\u03c6\u03b1\u03b9\u03c1\u03ad\u03c3\u03b5\u03c4\u03b5 \u2014 \u03c0.\u03c7. \u03b3\u03b9\u03b1 \u03bd\u03b1 \u03b4\u03b7\u03bc\u03bf\u03c3\u03b9\u03b5\u03cd\u03c3\u03b5\u03c4\u03b5 \u03c4\u03b9\u03c2 \u03c0\u03bb\u03b7\u03c1\u03bf\u03c6\u03bf\u03c1\u03af\u03b5\u03c2 \u03b1\u03c1\u03b3\u03cc\u03c4\u03b5\u03c1\u03b1."],"No icon":["\u03a7\u03c9\u03c1\u03af\u03c2 \u03b5\u03b9\u03ba\u03bf\u03bd\u03af\u03b4\u03b9\u03bf"],"Remove image":["\u0391\u03c6\u03b1\u03af\u03c1\u03b5\u03c3\u03b7 \u03b5\u03b9\u03ba\u03cc\u03bd\u03b1\u03c2"],"Icon, optional image, card color and a short description shown on the page card.":["\u0395\u03b9\u03ba\u03bf\u03bd\u03af\u03b4\u03b9\u03bf, \u03c0\u03c1\u03bf\u03b1\u03b9\u03c1\u03b5\u03c4\u03b9\u03ba\u03ae \u03b5\u03b9\u03ba\u03cc\u03bd\u03b1, \u03c7\u03c1\u03ce\u03bc\u03b1 \u03ba\u03ac\u03c1\u03c4\u03b1\u03c2 \u03ba\u03b1\u03b9 \u03c3\u03cd\u03bd\u03c4\u03bf\u03bc\u03b7 \u03c0\u03b5\u03c1\u03b9\u03b3\u03c1\u03b1\u03c6\u03ae \u03c0\u03bf\u03c5 \u03b5\u03bc\u03c6\u03b1\u03bd\u03af\u03b6\u03bf\u03bd\u03c4\u03b1\u03b9 \u03c3\u03c4\u03b7\u03bd \u03ba\u03ac\u03c1\u03c4\u03b1 \u03c3\u03b5\u03bb\u03af\u03b4\u03b1\u03c2."],"Icon":["\u0395\u03b9\u03ba\u03bf\u03bd\u03af\u03b4\u03b9\u03bf"],"Image (optional, overrides icon)":["\u0395\u03b9\u03ba\u03cc\u03bd\u03b1 (\u03c0\u03c1\u03bf\u03b1\u03b9\u03c1\u03b5\u03c4\u03b9\u03ba\u03ae, \u03c0\u03b1\u03c1\u03b1\u03ba\u03ac\u03bc\u03c0\u03c4\u03b5\u03b9 \u03c4\u03bf \u03b5\u03b9\u03ba\u03bf\u03bd\u03af\u03b4\u03b9\u03bf)"],"Card color":["\u03a7\u03c1\u03ce\u03bc\u03b1 \u03ba\u03ac\u03c1\u03c4\u03b1\u03c2"],"Short description (max 160)":["\u03a3\u03cd\u03bd\u03c4\u03bf\u03bc\u03b7 \u03c0\u03b5\u03c1\u03b9\u03b3\u03c1\u03b1\u03c6\u03ae (\u03bc\u03ad\u03b3\u03b9\u03c3\u03c4\u03bf 160)"],"Page card settings":["\u03a1\u03c5\u03b8\u03bc\u03af\u03c3\u03b5\u03b9\u03c2 \u03ba\u03ac\u03c1\u03c4\u03b1\u03c2 \u03c3\u03b5\u03bb\u03af\u03b4\u03b1\u03c2"],"Settings":["\u03a1\u03c5\u03b8\u03bc\u03af\u03c3\u03b5\u03b9\u03c2"],"Speakers":["\u039f\u03bc\u03b9\u03bb\u03b7\u03c4\u03ad\u03c2"],"Insert variable\u2026":["\u0395\u03b9\u03c3\u03b1\u03b3\u03c9\u03b3\u03ae \u03bc\u03b5\u03c4\u03b1\u03b2\u03bb\u03b7\u03c4\u03ae\u03c2\u2026"],"Short bio (max 500 characters)":["\u03a3\u03cd\u03bd\u03c4\u03bf\u03bc\u03bf \u03b2\u03b9\u03bf\u03b3\u03c1\u03b1\u03c6\u03b9\u03ba\u03cc (\u03bc\u03ad\u03b3\u03b9\u03c3\u03c4\u03bf 500 \u03c7\u03b1\u03c1\u03b1\u03ba\u03c4\u03ae\u03c1\u03b5\u03c2)"],"Add speaker":["\u03a0\u03c1\u03bf\u03c3\u03b8\u03ae\u03ba\u03b7 \u03bf\u03bc\u03b9\u03bb\u03b7\u03c4\u03ae"],"Each speaker has an image, name, title and a short bio (max 500 characters). One speaker is shown in full; several are shown as boxes. Drag to reorder.":["\u039a\u03ac\u03b8\u03b5 \u03bf\u03bc\u03b9\u03bb\u03b7\u03c4\u03ae\u03c2 \u03ad\u03c7\u03b5\u03b9 \u03b5\u03b9\u03ba\u03cc\u03bd\u03b1, \u03cc\u03bd\u03bf\u03bc\u03b1, \u03c4\u03af\u03c4\u03bb\u03bf \u03ba\u03b1\u03b9 \u03c3\u03cd\u03bd\u03c4\u03bf\u03bc\u03bf \u03b2\u03b9\u03bf\u03b3\u03c1\u03b1\u03c6\u03b9\u03ba\u03cc (\u03bc\u03ad\u03b3\u03b9\u03c3\u03c4\u03bf 500 \u03c7\u03b1\u03c1\u03b1\u03ba\u03c4\u03ae\u03c1\u03b5\u03c2). \u0388\u03bd\u03b1\u03c2 \u03bf\u03bc\u03b9\u03bb\u03b7\u03c4\u03ae\u03c2 \u03b5\u03bc\u03c6\u03b1\u03bd\u03af\u03b6\u03b5\u03c4\u03b1\u03b9 \u03c0\u03bb\u03ae\u03c1\u03c9\u03c2\u00b7 \u03c0\u03bf\u03bb\u03bb\u03bf\u03af \u03b5\u03bc\u03c6\u03b1\u03bd\u03af\u03b6\u03bf\u03bd\u03c4\u03b1\u03b9 \u03c9\u03c2 \u03c0\u03bb\u03b1\u03af\u03c3\u03b9\u03b1. \u03a3\u03cd\u03c1\u03b5\u03c4\u03b5 \u03b3\u03b9\u03b1 \u03b1\u03bd\u03b1\u03b4\u03b9\u03ac\u03c4\u03b1\u03be\u03b7."]}}}