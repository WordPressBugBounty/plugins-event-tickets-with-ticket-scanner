3ba\u03b1\u03b9 \u03c4\u03bf slug \u03b5\u03af\u03bd\u03b1\u03b9 \u03c5\u03c0\u03bf\u03c7\u03c1\u03b5\u03c9\u03c4\u03b9\u03ba\u03ac."],"Program":["\u03a0\u03c1\u03cc\u03b3\u03c1\u03b1\u03bc\u03bc\u03b1"],"Updated":["\u0395\u03bd\u03b7\u03bc\u03b5\u03c1\u03ce\u03b8\u03b7\u03ba\u03b5"],"Products":["\u03a0\u03c1\u03bf\u03ca\u03cc\u03bd\u03c4\u03b1"],"Speaker":["\u039f\u03bc\u03b9\u03bb\u03b7\u03c4\u03ae\u03c2"],"Pick files from the media library. Label is shown to visitors. Drag to reorder.":["\u0395\u03c0\u03b9\u03bb\u03ad\u03be\u03c4\u03b5 \u03b1\u03c1\u03c7\u03b5\u03af\u03b1 \u03b1\u03c0\u03cc \u03c4\u03b7 \u03b2\u03b9\u03b2\u03bb\u03b9\u03bf\u03b8\u03ae\u03ba\u03b7 \u03c0\u03bf\u03bb\u03c5\u03bc\u03ad\u03c3\u03c9\u03bd. \u0397 \u03b5\u03c4\u03b9\u03ba\u03ad\u03c4\u03b1 \u03b5\u03bc\u03c6\u03b1\u03bd\u03af\u03b6\u03b5\u03c4\u03b1\u03b9 \u03c3\u03c4\u03bf\u03c5\u03c2 \u03b5\u03c0\u03b9\u03c3\u03ba\u03ad\u03c0\u03c4\u03b5\u03c2. \u03a3\u03cd\u03c1\u03b5\u03c4\u03b5 \u03b3\u03b9\u03b1 \u03b1\u03bd\u03b1\u03b4\u03b9\u03ac\u03c4\u03b1\u03be\u03b7."],"Unique identifier for this congress. Visitors open it through their personal ticket link, not the slug.":["\u039c\u03bf\u03bd\u03b1\u03b4\u03b9\u03ba\u03cc \u03b1\u03bd\u03b1\u03b3\u03bd\u03c9\u03c1\u03b9\u03c3\u03c4\u03b9\u03ba\u03cc \u03b3\u03b9\u03b1 \u03b1\u03c5\u03c4\u03cc \u03c4\u03bf \u03c3\u03c5\u03bd\u03ad\u03b4\u03c1\u03b9\u03bf. \u039f\u03b9 \u03b5\u03c0\u03b9\u03c3\u03ba\u03ad\u03c0\u03c4\u03b5\u03c2 \u03c4\u03bf \u03b1\u03bd\u03bf\u03af\u03b3\u03bf\u03c5\u03bd \u03bc\u03ad\u03c3\u03c9 \u03c4\u03bf\u03c5 \u03c0\u03c1\u03bf\u03c3\u03c9\u03c0\u03b9\u03ba\u03bf\u03cd \u03c4\u03bf\u03c5\u03c2 \u03c3\u03c5\u03bd\u03b4\u03ad\u03c3\u03bc\u03bf\u03c5 \u03b5\u03b9\u03c3\u03b9\u03c4\u03b7\u03c1\u03af\u03bf\u03c5, \u03cc\u03c7\u03b9 \u03bc\u03ad\u03c3\u03c9 \u03c4\u03bf\u03c5 slug."],"Choose":["\u0395\u03c0\u03b9\u03bb\u03bf\u03b3\u03ae"],"Save congress":["\u0391\u03c0\u03bf\u03b8\u03ae\u03ba\u03b5\u03c5\u03c3\u03b7 \u03c3\u03c5\u03bd\u03b5\u03b4\u03c1\u03af\u03bf\u03c5"],"Delete page?":["\u0394\u03b9\u03b1\u03b3\u03c1\u03b1\u03c6\u03ae \u03c3\u03b5\u03bb\u03af\u03b4\u03b1\u03c2;"],"Save":["\u0391\u03c0\u03bf\u03b8\u03ae\u03ba\u03b5\u03c5\u03c3\u03b7"],"Assign via the WooCommerce product settings.":["\u0391\u03bd\u03ac\u03b8\u03b5\u03c3\u03b7 \u03bc\u03ad\u03c3\u03c9 \u03c4\u03c9\u03bd \u03c1\u03c5\u03b8\u03bc\u03af\u03c3\u03b5\u03c9\u03bd \u03c0\u03c1\u03bf\u03ca\u03cc\u03bd\u03c4\u03bf\u03c2 \u03c4\u03bf\u03c5 WooCommerce."],"Internal":["\u0395\u03c3\u03c9\u03c4\u03b5\u03c1\u03b9\u03ba\u03cc\u03c2"],"Insert variable\u2026":["\u0395\u03b9\u03c3\u03b1\u03b3\u03c9\u03b3\u03ae \u03bc\u03b5\u03c4\u03b1\u03b2\u03bb\u03b7\u03c4\u03ae\u03c2\u2026"],"Files":["\u0391\u03c1\u03c7\u03b5\u03af\u03b1"],"Title":["\u03a4\u03af\u03c4\u03bb\u03bf\u03c2"],"Cancel":["M\u00e9gse"],"Choose image":["\u0395\u03c0\u03b9\u03bb\u03bf\u03b3\u03ae \u03b5\u03b9\u03ba\u03cc\u03bd\u03b1\u03c2"],"Image":["\u0395\u03b9\u03ba\u03cc\u03bd\u03b1"],"Manual hard cutoff. Leave empty for unlimited access.":["\u03a7\u03b5\u03b9\u03c1\u03bf\u03ba\u03af\u03bd\u03b7\u03c4\u03b7 \u03bf\u03c1\u03b9\u03c3\u03c4\u03b9\u03ba\u03ae \u03bb\u03ae\u03be\u03b7. \u0391\u03c6\u03ae\u03c3\u03c4\u03b5 \u03ba\u03b5\u03bd\u03cc \u03b3\u03b9\u03b1 \u03b1\u03c0\u03b5\u03c1\u03b9\u03cc\u03c1\u03b9\u03c3\u03c4\u03b7 \u03c0\u03c1\u03cc\u03c3\u03b2\u03b1\u03c3\u03b7."],"Caption (optional)":["\u039b\u03b5\u03b6\u03ac\u03bd\u03c4\u03b1 (\u03c0\u03c1\u03bf\u03b1\u03b9\u03c1\u03b5\u03c4\u03b9\u03ba\u03cc)"],"No pages yet. Add a page to start.":["\u0394\u03b5\u03bd \u03c5\u03c0\u03ac\u03c1\u03c7\u03bf\u03c5\u03bd \u03b1\u03ba\u03cc\u03bc\u03b7 \u03c3\u03b5\u03bb\u03af\u03b4\u03b5\u03c2. \u03a0\u03c1\u03bf\u03c3\u03b8\u03ad\u03c3\u03c4\u03b5 \u03bc\u03b9\u03b1 \u03c3\u03b5\u03bb\u03af\u03b4\u03b1 \u03b3\u03b9\u03b1 \u03bd\u03b1 \u03be\u03b5\u03ba\u03b9\u03bd\u03ae\u03c3\u03b5\u03c4\u03b5."],"Portal label":["\u0395\u03c4\u03b9\u03ba\u03ad\u03c4\u03b1 \u03c0\u03cd\u03bb\u03b7\u03c2"],"assigned (manage on product level)":["\u03b1\u03bd\u03b1\u03c4\u03b5\u03b8\u03b5\u03b9\u03bc\u03ad\u03bd\u03bf (\u03b4\u03b9\u03b1\u03c7\u03b5\u03af\u03c1\u03b9\u03c3\u03b7 \u03c3\u03b5 \u03b5\u03c0\u03af\u03c0\u03b5\u03b4\u03bf \u03c0\u03c1\u03bf\u03ca\u03cc\u03bd\u03c4\u03bf\u03c2)"],"Video":["\u0392\u03af\u03bd\u03c4\u03b5\u03bf"],"Icon":["\u0395\u03b9\u03ba\u03bf\u03bd\u03af\u03b4\u03b9\u03bf"],"Drag to reorder":["\u03a3\u03cd\u03c1\u03b5\u03c4\u03b5 \u03b3\u03b9\u03b1 \u03b1\u03bd\u03b1\u03b4\u03b9\u03ac\u03c4\u03b1\u03be\u03b7"],"Room":["\u0391\u03af\u03b8\u03bf\u03c5\u03c3\u03b1"],"Add URL":["\u03a0\u03c1\u03bf\u03c3\u03b8\u03ae\u03ba\u03b7 URL"],"Type":["\u03a4\u03cd\u03c0\u03bf\u03c2"],"Access expires (optional)":["\u039b\u03ae\u03be\u03b7 \u03c0\u03c1\u03cc\u03c3\u03b2\u03b1\u03c3\u03b7\u03c2 (\u03c0\u03c1\u03bf\u03b1\u03b9\u03c1\u03b5\u03c4\u03b9\u03ba\u03cc)"],"Active \u2014 visible to ticket holders":["\u0395\u03bd\u03b5\u03c1\u03b3\u03cc \u2014 \u03bf\u03c1\u03b1\u03c4\u03cc \u03c3\u03c4\u03bf\u03c5\u03c2 \u03ba\u03b1\u03c4\u03cc\u03c7\u03bf\u03c5\u03c2 \u03b5\u03b9\u03c3\u03b9\u03c4\u03b7\u03c1\u03af\u03c9\u03bd"],"Add page":["\u03a0\u03c1\u03bf\u03c3\u03b8\u03ae\u03ba\u03b7 \u03c3\u03b5\u03bb\u03af\u03b4\u03b1\u03c2"],"This action cannot be undone. All sections will be deleted as well.":["\u0391\u03c5\u03c4\u03ae \u03b7 \u03b5\u03bd\u03ad\u03c1\u03b3\u03b5\u03b9\u03b1 \u03b4\u03b5\u03bd \u03bc\u03c0\u03bf\u03c1\u03b5\u03af \u03bd\u03b1 \u03b1\u03bd\u03b1\u03b9\u03c1\u03b5\u03b8\u03b5\u03af. \u038c\u03bb\u03b5\u03c2 \u03bf\u03b9 \u03b5\u03bd\u03cc\u03c4\u03b7\u03c4\u03b5\u03c2 \u03b8\u03b1 \u03b4\u03b9\u03b1\u03b3\u03c1\u03b1\u03c6\u03bf\u03cd\u03bd \u03b5\u03c0\u03af\u03c3\u03b7\u03c2."],"Icon, optional image, card color and a short description shown on the page card.":["\u0395\u03b9\u03ba\u03bf\u03bd\u03af\u03b4\u03b9\u03bf, \u03c0\u03c1\u03bf\u03b1\u03b9\u03c1\u03b5\u03c4\u03b9\u03ba\u03ae \u03b5\u03b9\u03ba\u03cc\u03bd\u03b1, \u03c7\u03c1\u03ce\u03bc\u03b1 \u03ba\u03ac\u03c1\u03c4\u03b1\u03c2 \u03ba\u03b1\u03b9 \u03c3\u03cd\u03bd\u03c4\u03bf\u03bc\u03b7 \u03c0\u03b5\u03c1\u03b9\u03b3\u03c1\u03b1\u03c6\u03ae \u03c0\u03bf\u03c5 \u03b5\u03bc\u03c6\u03b1\u03bd\u03af\u03b6\u03bf\u03bd\u03c4\u03b1\u03b9 \u03c3\u03c4\u03b7\u03bd \u03ba\u03ac\u03c1\u03c4\u03b1 \u03c3\u03b5\u03bb\u03af\u03b4\u03b1\u03c2."],"Video file":["\u0391\u03c1\u03c7\u03b5\u03af\u03bf \u03b2\u03af\u03bd\u03c4\u03b5\u03bf"],"Title for new edition (leave empty to auto-generate):":["\u03a4\u03af\u03c4\u03bb\u03bf\u03c2 \u03b3\u03b9\u03b1 \u03c4\u03b7 \u03bd\u03ad\u03b1 \u03ad\u03ba\u03b4\u03bf\u03c3\u03b7 (\u03b1\u03c6\u03ae\u03c3\u03c4\u03b5 \u03ba\u03b5\u03bd\u03cc \u03b3\u03b9\u03b1 \u03b1\u03c5\u03c4\u03cc\u03bc\u03b1\u03c4\u03b7 \u03b4\u03b7\u03bc\u03b9\u03bf\u03c5\u03c1\u03b3\u03af\u03b1):"],"Paste a YouTube, Vimeo or other supported link. It is embedded automatically.":["\u0395\u03c0\u03b9\u03ba\u03bf\u03bb\u03bb\u03ae\u03c3\u03c4\u03b5 \u03ad\u03bd\u03b1 \u03c3\u03cd\u03bd\u03b4\u03b5\u03c3\u03bc\u03bf YouTube, Vimeo \u03ae \u03ac\u03bb\u03bb\u03b7\u03c2 \u03c5\u03c0\u03bf\u03c3\u03c4\u03b7\u03c1\u03b9\u03b6\u03cc\u03bc\u03b5\u03bd\u03b7\u03c2 \u03c0\u03bb\u03b1\u03c4\u03c6\u03cc\u03c1\u03bc\u03b1\u03c2. \u0395\u03bd\u03c3\u03c9\u03bc\u03b1\u03c4\u03ce\u03bd\u03b5\u03c4\u03b1\u03b9 \u03b1\u03c5\u03c4\u03cc\u03bc\u03b1\u03c4\u03b1."],"start page":["\u03b1\u03c1\u03c7\u03b9\u03ba\u03ae \u03c3\u03b5\u03bb\u03af\u03b4\u03b1"],"Name":["N\u00e9v"],"Select video":["\u0395\u03c0\u03b9\u03bb\u03bf\u03b3\u03ae \u03b2\u03af\u03bd\u03c4\u03b5\u03bf"],"Remove slot":["\u0391\u03c6\u03b1\u03af\u03c1\u03b5\u03c3\u03b7 \u03c5\u03c0\u03bf\u03b4\u03bf\u03c7\u03ae\u03c2"],"Add image":["\u03a0\u03c1\u03bf\u03c3\u03b8\u03ae\u03ba\u03b7 \u03b5\u03b9\u03ba\u03cc\u03bd\u03b1\u03c2"],"Remove image":["\u0391\u03c6\u03b1\u03af\u03c1\u03b5\u03c3\u03b7 \u03b5\u03b9\u03ba\u03cc\u03bd\u03b1\u03c2"],"Display size":["\u039c\u03ad\u03b3\u03b5\u03b8\u03bf\u03c2 \u03b5\u03bc\u03c6\u03ac\u03bd\u03b9\u03c3\u03b7\u03c2"],"Short description (max 160)":["\u03a3\u03cd\u03bd\u03c4\u03bf\u03bc\u03b7 \u03c0\u03b5\u03c1\u03b9\u03b3\u03c1\u03b1\u03c6\u03ae (\u03bc\u03ad\u03b3\u03b9\u03c3\u03c4\u03bf 160)"],"Choose which page this section belongs to. Change it to move the section to another page.":["\u0395\u03c0\u03b9\u03bb\u03ad\u03be\u03c4\u03b5 \u03c3\u03b5 \u03c0\u03bf\u03b9\u03b1 \u03c3\u03b5\u03bb\u03af\u03b4\u03b1 \u03b1\u03bd\u03ae\u03ba\u03b5\u03b9 \u03b1\u03c5\u03c4\u03ae \u03b7 \u03b5\u03bd\u03cc\u03c4\u03b7\u03c4\u03b1. \u0391\u03bb\u03bb\u03ac\u03be\u03c4\u03b5 \u03c4\u03bf \u03b3\u03b9\u03b1 \u03bd\u03b1 \u03bc\u03b5\u03c4\u03b1\u03ba\u03b9\u03bd\u03ae\u03c3\u03b5\u03c4\u03b5 \u03c4\u03b7\u03bd \u03b5\u03bd\u03cc\u03c4\u03b7\u03c4\u03b1 \u03c3\u03b5 \u03ac\u03bb\u03bb\u03b7 \u03c3\u03b5\u03bb\u03af\u03b4\u03b1."],"Open full size when clicked":["\u0386\u03bd\u03bf\u03b9\u03b3\u03bc\u03b1 \u03c3\u03b5 \u03c0\u03bb\u03ae\u03c1\u03b5\u03c2 \u03bc\u03ad\u03b3\u03b5\u03b8\u03bf\u03c2 \u03bc\u03b5 \u03ba\u03bb\u03b9\u03ba"],"Content":["\u03a0\u03b5\u03c1\u03b9\u03b5\u03c7\u03cc\u03bc\u03b5\u03bd\u03bf"],"Video URL":["URL \u03b2\u03af\u03bd\u03c4\u03b5\u03bf"],"Uploaded video file":["\u039c\u03b5\u03c4\u03b1\u03c6\u03bf\u03c1\u03c4\u03c9\u03bc\u03ad\u03bd\u03bf \u03b1\u03c1\u03c7\u03b5\u03af\u03bf \u03b2\u03af\u03bd\u03c4\u03b5\u03bf"],"Select file":["\u0395\u03c0\u03b9\u03bb\u03bf\u03b3\u03ae \u03b1\u03c1\u03c7\u03b5\u03af\u03bf\u03c5"],"New event app":[""],"Full width":["\u03a0\u03bb\u03ae\u03c1\u03b5\u03c2 \u03c0\u03bb\u03ac\u03c4\u03bf\u03c2"],"Card color":["\u03a7\u03c1\u03ce\u03bc\u03b1 \u03ba\u03ac\u03c1\u03c4\u03b1\u03c2"],"Add slot":["\u03a0\u03c1\u03bf\u03c3\u03b8\u03ae\u03ba\u03b7 \u03b8\u03ad\u03c3\u03b7\u03c2"],"Settings":["\u03a1\u03c5\u03b8\u03bc\u03af\u03c3\u03b5\u03b9\u03c2"],"Rename page":["\u039c\u03b5\u03c4\u03bf\u03bd\u03bf\u03bc\u03b1\u03c3\u03af\u03b1 \u03c3\u03b5\u03bb\u03af\u03b4\u03b1\u03c2"],"Short bio (max 500 characters)":["\u03a3\u03cd\u03bd\u03c4\u03bf\u03bc\u03bf \u03b2\u03b9\u03bf\u03b3\u03c1\u03b1\u03c6\u03b9\u03ba\u03cc (\u03bc\u03ad\u03b3\u03b9\u03c3\u03c4\u03bf 500 \u03c7\u03b1\u03c1\u03b1\u03ba\u03c4\u03ae\u03c1\u03b5\u03c2)"],"No icon":["\u03a7\u03c9\u03c1\u03af\u03c2 \u03b5\u03b9\u03ba\u03bf\u03bd\u03af\u03b4\u03b9\u03bf"],"An event app is the companion page your visitors open with their ticket: programme and schedule, speaker or artist info, venue maps, downloads, media and support pages \u2014 everything structured in one place. Perfect for a congress with multiple sessions, but just as much for a single event where ticket holders need extra info, a FAQ or contact options. Visitors do not need an account or an extra app: their ticket ID is the key, access opens with the ticket and can expire with it. Assign an event app to a product in the WooCommerce product settings \u2014 one app can serve multiple products, so an event series shares one app.":[""],"Source":["\u03a0\u03b7\u03b3\u03ae"],"Export contacts":["\u0395\u03be\u03b1\u03b3\u03c9\u03b3\u03ae \u03b5\u03c0\u03b1\u03c6\u03ce\u03bd"],"Edit":["Szerkeszt\u00e9s"],"Page":["\u03a3\u03b5\u03bb\u03af\u03b4\u03b1"],"Updated:":["\u0395\u03bd\u03b7\u03bc\u03b5\u03c1\u03ce\u03b8\u03b7\u03ba\u03b5:"],"Time":["\u038f\u03c1\u03b1"],"Open inline":["\u0386\u03bd\u03bf\u03b9\u03b3\u03bc\u03b1 \u03b5\u03bd\u03c4\u03cc\u03c2 \u03c3\u03b5\u03bb\u03af\u03b4\u03b1\u03c2"],"Images":["\u0395\u03b9\u03ba\u03cc\u03bd\u03b5\u03c2"],"Add file":["\u03a0\u03c1\u03bf\u03c3\u03b8\u03ae\u03ba\u03b7 \u03b1\u03c1\u03c7\u03b5\u03af\u03bf\u03c5"]}}}