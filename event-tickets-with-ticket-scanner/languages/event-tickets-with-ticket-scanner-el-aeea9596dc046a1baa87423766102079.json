unknown columns:":["\u0391\u03b3\u03bd\u03bf\u03ae\u03c3\u03c4\u03b7\u03ba\u03b1\u03bd \u03ac\u03b3\u03bd\u03c9\u03c3\u03c4\u03b5\u03c2 \u03c3\u03c4\u03ae\u03bb\u03b5\u03c2:"],"Import failed.":["\u0397 \u03b5\u03b9\u03c3\u03b1\u03b3\u03c9\u03b3\u03ae \u03b1\u03c0\u03ad\u03c4\u03c5\u03c7\u03b5."],"Free Version: %d\/%d plans":["\u0394\u03c9\u03c1\u03b5\u03ac\u03bd \u0388\u03ba\u03b4\u03bf\u03c3\u03b7: %d\/%d \u03c3\u03c7\u03ad\u03b4\u03b9\u03b1"],"Seating Plans":["\u03a3\u03c7\u03ad\u03b4\u03b9\u03b1 \u03ba\u03b1\u03b8\u03b9\u03c3\u03bc\u03ac\u03c4\u03c9\u03bd"],"Upgrade to Premium":["\u0391\u03bd\u03b1\u03b2\u03ac\u03b8\u03bc\u03b9\u03c3\u03b7 \u03c3\u03b5 Premium"],"+ Add Seating Plan":["+ \u03a0\u03c1\u03bf\u03c3\u03b8\u03ae\u03ba\u03b7 \u03c3\u03c7\u03b5\u03b4\u03af\u03bf\u03c5 \u03ba\u03b1\u03b8\u03b9\u03c3\u03bc\u03ac\u03c4\u03c9\u03bd"],"+ Add Seat":["+ \u03a0\u03c1\u03bf\u03c3\u03b8\u03ae\u03ba\u03b7 \u03b8\u03ad\u03c3\u03b7\u03c2"],"Import CSV":["\u0395\u03b9\u03c3\u03b1\u03b3\u03c9\u03b3\u03ae CSV"],"Apply":["\u0395\u03c6\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae"],"Seating Plan Layout":["\u0394\u03b9\u03ac\u03c4\u03b1\u03be\u03b7 \u03c3\u03c7\u03b5\u03b4\u03af\u03bf\u03c5 \u03ba\u03b1\u03b8\u03b9\u03c3\u03bc\u03ac\u03c4\u03c9\u03bd"],"Plan Name":["\u038c\u03bd\u03bf\u03bc\u03b1 \u03c0\u03bb\u03ac\u03bd\u03bf\u03c5"],"Layout Type":["\u03a4\u03cd\u03c0\u03bf\u03c2 \u03b4\u03b9\u03ac\u03c4\u03b1\u03be\u03b7\u03c2"],"Venue Photo":["\u03a6\u03c9\u03c4\u03bf\u03b3\u03c1\u03b1\u03c6\u03af\u03b1 \u03a7\u03ce\u03c1\u03bf\u03c5"],"optional":["opcion\u00e1lis"],"Optional: Upload a photo of the entire venue\/hall. Customers can view this via \"View Seating Plan\" button. Useful when the seat map only shows a specific section.":["\u03a0\u03c1\u03bf\u03b1\u03b9\u03c1\u03b5\u03c4\u03b9\u03ba\u03cc: \u0391\u03bd\u03b5\u03b2\u03ac\u03c3\u03c4\u03b5 \u03bc\u03b9\u03b1 \u03c6\u03c9\u03c4\u03bf\u03b3\u03c1\u03b1\u03c6\u03af\u03b1 \u03bf\u03bb\u03cc\u03ba\u03bb\u03b7\u03c1\u03bf\u03c