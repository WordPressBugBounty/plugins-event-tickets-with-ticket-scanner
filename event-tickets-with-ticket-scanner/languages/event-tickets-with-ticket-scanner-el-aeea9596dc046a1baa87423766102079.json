c3\u03c4\u03bf\u03b9\u03c7\u03b1 \u03b1\u03bd\u03b1\u03b3\u03bd\u03c9\u03c1\u03b9\u03c3\u03c4\u03b9\u03ba\u03ac \u03b8\u03b1 \u03b5\u03bd\u03b7\u03bc\u03b5\u03c1\u03c9\u03b8\u03bf\u03cd\u03bd."],"Import CSV":["\u0395\u03b9\u03c3\u03b1\u03b3\u03c9\u03b3\u03ae CSV"],"Import complete:":["\u0397 \u03b5\u03b9\u03c3\u03b1\u03b3\u03c9\u03b3\u03ae \u03bf\u03bb\u03bf\u03ba\u03bb\u03b7\u03c1\u03ce\u03b8\u03b7\u03ba\u03b5:"],"Import failed.":["\u0397 \u03b5\u03b9\u03c3\u03b1\u03b3\u03c9\u03b3\u03ae \u03b1\u03c0\u03ad\u03c4\u03c5\u03c7\u03b5."],"Inactive":["\u0391\u03bd\u03b5\u03bd\u03b5\u03c1\u03b3\u03cc"],"Label":["\u0395\u03c4\u03b9\u03ba\u03ad\u03c4\u03b1"],"Layout":["\u0394\u03b9\u03ac\u03c4\u03b1\u03be\u03b7"],"Layout Type":["\u03a4\u03cd\u03c0\u03bf\u03c2 \u03b4\u03b9\u03ac\u03c4\u03b1\u03be\u03b7\u03c2"],"Limit reached. Upgrade to Premium for unlimited access.":["\u03a3\u03c5\u03bc\u03c0\u03bb\u03b7\u03c1\u03ce\u03b8\u03b7\u03ba\u03b5 \u03c4\u03bf \u03cc\u03c1\u03b9\u03bf. \u0391\u03bd\u03b1\u03b2\u03b1\u03b8\u03bc\u03af\u03c3\u03c4\u03b5 \u03c3\u03b5 Premium \u03b3\u03b9\u03b1 \u03b1\u03c0\u03b5\u03c1\u03b9\u03cc\u03c1\u03b9\u03c3\u03c4\u03b7 \u03c0\u03c1\u03cc\u03c3\u03b2\u03b1\u03c3\u03b7."],"Loading designer...":["\u03a6\u03cc\u03c1\u03c4\u03c9\u03c3\u03b7 \u03c3\u03c7\u03b5\u03b4\u03b9\u03b1\u03c3\u03c4\u03ae..."],"Loading...":["\u03a6\u03cc\u03c1\u03c4\u03c9\u03c3\u03b7..."],"Manage Seats":["\u0394\u03b9\u03b1\u03c7\u03b5\u03af\u03c1\u03b9\u03c3\u03b7 \u03b8\u03ad\u03c3\u03b5\u03c9\u03bd"],"Name":["N\u00e9v"],"New Seat":["\u039d\u03ad\u03b1 \u03b8\u03ad\u03c3\u03b7"],"New Seating Plan":["\u039d\u03ad\u03bf \u03c3\u03c7\u03ad\u03b4\u03b9\u03bf \u03ba\u03b1\u03b8\u03b9\u03c3\u03bc\u03ac\u03c4\u03c9\u03bd"],"No seating plans found. Create your first plan!":["\u0394\u03b5\u03bd \u03b2\u03c1\u03ad\u03b8\u03b7\u03ba\u03b1\u03bd \u03c3\u03c7\u03ad\u03b4\u03b9\u03b1 \u03ba\u03b1\u03b8\u03b9\u03c3\u03bc\u03ac\u03c4\u03c9\u03bd. \u0394\u03b7\u03bc\u03b9\u03bf\u03c5\u03c1\u03b3\u03ae\u03c3\u03c4\u03b5 \u03c4\u03bf \u03c0\u03c1\u03ce\u03c4\u03bf \u03c3\u03b1\u03c2 \u03c3\u03c7\u03ad\u03b4\u03b9\u03bf!"],"No seats in this plan. Add seats below.":["\u0394\u03b5\u03bd \u03c5\u03c0\u03ac\u03c1\u03c7\u03bf\u03c5\u03bd \u03b8\u03ad\u03c3\u03b5\u03b9\u03c2 \u03c3\u03b5 \u03b1\u03c5\u03c4\u03cc \u03c4\u03bf \u03c3\u03c7\u03ad\u03b4\u03b9\u03bf. \u03a0\u03c1\u03bf\u03c3\u03b8\u03ad\u03c3\u03c4\u03b5 \u03b8\u03ad\u03c3\u03b5\u03b9\u03c2 \u03c0\u03b1\u03c1\u03b1\u03ba\u03ac\u03c4\u03c9."],"No valid rows found in CSV file.":["\u0394\u03b5\u03bd \u03b2\u03c1\u03ad\u03b8\u03b7\u03ba\u03b1\u03bd \u03ad\u03b3\u03ba\u03c5\u03c1\u03b5\u03c2 \u03b3\u03c1\u03b1\u03bc\u03bc\u03ad\u03c2 \u03c3\u03c4\u03bf \u03b1\u03c1\u03c7\u03b5\u03af\u03bf CSV."],"Open Designer":["\u0386\u03bd\u03bf\u03b9\u03b3\u03bc\u03b1 \u03c3\u03c7\u03b5\u03b4\u03b9\u03b1\u03c3\u03c4\u03ae"],"Optional: Upload a photo of the entire venue\/hall. Customers can view this via \"View Seating Plan\" button. Useful when the seat map only shows a specific section.":["\u03a0\u03c1\u03bf\u03b1\u03b9\u03c1\u03b5\u03c4\u03b9\u03ba\u03cc: \u0391\u03bd\u03b5\u03b2\u03ac\u03c3\u03c4\u03b5 \u03bc\u03b9\u03b1 \u03c6\u03c9\u03c4\u03bf\u03b3\u03c1\u03b1\u03c6\u03af\u03b1 \u03bf\u03bb\u03cc\u03ba\u03bb\u03b7\u03c1\u03bf\u03c5 \u03c4\u03bf\u03c5 \u03c7\u03ce\u03c1\u03bf\u03c5\/\u03b1\u03af\u03b8\u03bf\u03c5\u03c3\u03b1\u03c2. \u039f\u03b9 \u03c0\u03b5\u03bb\u03ac\u03c4\u03b5\u03c2 \u03bc\u03c0\u03bf\u03c1\u03bf\u03cd\u03bd \u03bd\u03b1 \u03c4\u03b7 \u03b4\u03bf\u03c5\u03bd \u03bc\u03ad\u03c3\u03c9 \u03c4\u03bf\u03c5 \u03ba\u03bf\u03c5\u03bc\u03c0\u03b9\u03bf\u03cd \"\u03a0\u03c1\u03bf\u03b2\u03bf\u03bb\u03ae \u03c3\u03c7\u03b5\u03b4\u03af\u03bf\u03c5 \u03ba\u03b1\u03b8\u03b9\u03c3\u03bc\u03ac\u03c4\u03c9\u03bd\". \u03a7\u03c1\u03ae\u03c3\u03b9\u03bc\u03bf \u03cc\u03c4\u03b1\u03bd \u03bf \u03c7\u03ac\u03c1\u03c4\u03b7\u03c2 \u03ba\u03b1\u03b8\u03b9\u03c3\u03bc\u03ac\u03c4\u03c9\u03bd \u03b4\u03b5\u03af\u03c7\u03bd\u03b5\u03b9 \u03bc\u03cc\u03bd\u03bf \u03ad\u03bd\u03b1 \u03c3\u03c5\u03b3\u03ba\u03b5\u03ba\u03c1\u03b9\u03bc\u03ad\u03bd\u03bf \u03c4\u03bc\u03ae\u03bc\u03b1."],"Plan Name":["\u038c\u03bd\u03bf\u03bc\u03b1 \u03c0\u03bb\u03ac\u03bd\u03bf\u03c5"],"Published":["\u0394\u03b7\u03bc\u03bf\u03c3\u03b9\u03b5\u03c5\u03bc\u03ad\u03bd\u03bf"],"Remove":["\u0391\u03c6\u03b1\u03af\u03c1\u03b5\u03c3\u03b7"],"Save & Add Next":["\u0391\u03c0\u03bf\u03b8\u03ae\u03ba\u03b5\u03c5\u03c3\u03b7 & \u03a0\u03c1\u03bf\u03c3\u03b8\u03ae\u03ba\u03b7 \u0395\u03c0\u03cc\u03bc\u03b5\u03bd\u03bf\u03c5"],"Save & Close":["\u0391\u03c0\u03bf\u03b8\u03ae\u03ba\u03b5\u03c5\u03c3\u03b7 & \u039a\u03bb\u03b5\u03af\u03c3\u03b9\u03bc\u03bf"],"Save Plan":["\u0391\u03c0\u03bf\u03b8\u03ae\u03ba\u03b5\u03c5\u03c3\u03b7 \u03a0\u03bb\u03ac\u03bd\u03bf\u03c5"],"Seat":["\u0398\u03ad\u03c3\u03b7"],"Seat Identifier":["\u0391\u03bd\u03b1\u03b3\u03bd\u03c9\u03c1\u03b9\u03c3\u03c4\u03b9\u03ba\u03cc \u0398\u03ad\u03c3\u03b7\u03c2"],"Seat created successfully":["\u0397 \u03b8\u03ad\u03c3\u03b7 \u03b4\u03b7\u03bc\u03b9\u03bf\u03c5\u03c1\u03b3\u03ae\u03b8\u03b7\u03ba\u03b5 \u03bc\u03b5 \u03b5\u03c0\u03b9\u03c4\u03c5\u03c7\u03af\u03b1"],"Seat deleted successfully":["\u0397 \u03b8\u03ad\u03c3\u03b7 \u03b4\u03b9\u03b1\u03b3\u03c1\u03ac\u03c6\u03b7\u03ba\u03b5 \u03bc\u03b5 \u03b5\u03c0\u03b9\u03c4\u03c5\u03c7\u03af\u03b1"],"Seat updated successfully":["\u0397 \u03b8\u03ad\u03c3\u03b7 \u03b5\u03bd\u03b7\u03bc\u03b5\u03c1\u03ce\u03b8\u03b7\u03ba\u03b5 \u03b5\u03c0\u03b9\u03c4\u03c5\u03c7\u03ce\u03c2"],"Seating Plan":["\u03a3\u03c7\u03ad\u03b4\u03b9\u03bf \u03ba\u03b1\u03b8\u03b9\u03c3\u03bc\u03ac\u03c4\u03c9\u03bd"],"Seating Plan Layout":["\u0394\u03b9\u03ac\u03c4\u03b1\u03be\u03b7 \u03c3\u03c7\u03b5\u03b4\u03af\u03bf\u03c5 \u03ba\u03b1\u03b8\u03b9\u03c3\u03bc\u03ac\u03c4\u03c9\u03bd"],"Seating Plans":["\u03a3\u03c7\u03ad\u03b4\u03b9\u03b1 \u03ba\u03b1\u03b8\u03b9\u03c3\u03bc\u03ac\u03c4\u03c9\u03bd"],"Seating plan cloned successfully":["\u0397 \u03ba\u03bb\u03c9\u03bd\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b7 \u03c4\u03bf\u03c5 \u03c3\u03c7\u03b5\u03b4\u03af\u03bf\u03c5 \u03ba\u03b1\u03b8\u03b9\u03c3\u03bc\u03ac\u03c4\u03c9\u03bd \u03bf\u03bb\u03bf\u03ba\u03bb\u03b7\u03c1\u03ce\u03b8\u03b7\u03ba\u03b5 \u03b5\u03c0\u03b9\u03c4\u03c5\u03c7\u03ce\u03c2"],"Seating plan created successfully":["\u0397 \u03b4\u03b7\u03bc\u03b9\u03bf\u03c5\u03c1\u03b3\u03af\u03b1 \u03c4\u03bf\u03c5 \u03c3\u03c7\u03b5\u03b4\u03af\u03bf\u03c5 \u03ba\u03b1\u03b8\u03b9\u03c3\u03bc\u03ac\u03c4\u03c9\u03bd \u03bf\u03bb\u03bf\u03ba\u03bb\u03b7\u03c1\u03ce\u03b8\u03b7\u03ba\u03b5 \u03b5\u03c0\u03b9\u03c4\u03c5\u03c7\u03ce\u03c2"],"Seating plan deleted successfully":["\u0397 \u03b4\u03b9\u03b1\u03b3\u03c1\u03b1\u03c6\u03ae \u03c4\u03bf\u03c5 \u03c3\u03c7\u03b5\u03b4\u03af\u03bf\u03c5 \u03ba\u03b1\u03b8\u03b9\u03c3\u03bc\u03ac\u03c4\u03c9\u03bd \u03bf\u03bb\u03bf\u03ba\u03bb\u03b7\u03c1\u03ce\u03b8\u03b7\u03ba\u03b5 \u03b5\u03c0\u03b9\u03c4\u03c5\u03c7\u03ce\u03c2"],"Seating plan updated successfully":["\u0397 \u03b5\u03bd\u03b7\u03bc\u03ad\u03c1\u03c9\u03c3\u03b7 \u03c4\u03bf\u03c5 \u03c3\u03c7\u03b5\u03b4\u03af\u03bf\u03c5 \u03ba\u03b1\u03b8\u03b9\u03c3\u03bc\u03ac\u03c4\u03c9\u03bd \u03bf\u03bb\u03bf\u03ba\u03bb\u03b7\u03c1\u03ce\u03b8\u03b7\u03ba\u03b5 \u03b5\u03c0\u03b9\u03c4\u03c5\u03c7\u03ce\u03c2"],"Seats":["\u0398\u03ad\u03c3\u03b5\u03b9\u03c2"],"Seats created successfully":["\u039f\u03b9 \u03b8\u03ad\u03c3\u03b5\u03b9\u03c2 \u03b4\u03b7\u03bc\u03b9\u03bf\u03c5\u03c1\u03b3\u03ae\u03b8\u03b7\u03ba\u03b1\u03bd \u03b5\u03c0\u03b9\u03c4\u03c5\u03c7\u03ce\u03c2"],"Select All":["\u0395\u03c0\u03b9\u03bb\u03bf\u03b3\u03ae \u03cc\u03bb\u03c9\u03bd"],"Select Image":["\u0395\u03c0\u03b9\u03bb\u03bf\u03b3\u03ae \u03b5\u03b9\u03ba\u03cc\u03bd\u03b1\u03c2"],"Show Layout":["\u0395\u03bc\u03c6\u03ac\u03bd\u03b9\u03c3\u03b7 \u03b4\u03b9\u03ac\u03c4\u03b1\u03be\u03b7\u03c2"],"Shown on ticket PDF":["\u0395\u03bc\u03c6\u03b1\u03bd\u03af\u03b6\u03b5\u03c4\u03b1\u03b9 \u03c3\u03c4\u03bf PDF \u03c4\u03bf\u03c5 \u03b5\u03b9\u03c3\u03b9\u03c4\u03b7\u03c1\u03af\u03bf\u03c5"],"Simple (Dropdown)":["\u0391\u03c0\u03bb\u03cc (\u0391\u03bd\u03b1\u03c0\u03c4\u03c5\u03c3\u03c3\u03cc\u03bc\u03b5\u03bd\u03b7 \u03bb\u03af\u03c3\u03c4\u03b1)"],"Simple Layout (Dropdown)":["\u0391\u03c0\u03bb\u03ae \u03b4\u03b9\u03ac\u03c4\u03b1\u03be\u03b7 (\u0391\u03bd\u03b1\u03c0\u03c4\u03c5\u03c3\u03c3\u03cc\u03bc\u03b5\u03bd\u03b7 \u03bb\u03af\u03c3\u03c4\u03b1)"],"Status":["\u00c1llapot"],"This plan has seats. Delete plan and all seats?":["\u0391\u03c5\u03c4\u03cc \u03c4\u03bf \u03c0\u03bb\u03ac\u03bd\u03bf \u03ad\u03c7\u03b5\u03b9 \u03b8\u03ad\u03c3\u03b5\u03b9\u03c2. \u039d\u03b1 \u03b4\u03b9\u03b1\u03b3\u03c1\u03b1\u03c6\u03b5\u03af \u03c4\u03bf \u03c0\u03bb\u03ac\u03bd\u03bf \u03ba\u03b1\u03b9 \u03cc\u03bb\u03b5\u03c2 \u03bf\u03b9 \u03b8\u03ad\u03c3\u03b5\u03b9\u03c2;"],"This plan uses Visual Layout. Add and delete seats using the Visual Designer. You can edit seat details (label, category) here.":["\u0391\u03c5\u03c4\u03cc \u03c4\u03bf \u03c0\u03bb\u03ac\u03bd\u03bf \u03c7\u03c1\u03b7\u03c3\u03b9\u03bc\u03bf\u03c0\u03bf\u03b9\u03b5\u03af \u039f\u03c0\u03c4\u03b9\u03ba\u03ae \u0394\u03b9\u03ac\u03c4\u03b1\u03be\u03b7. \u03a0\u03c1\u03bf\u03c3\u03b8\u03ad\u03c3\u03c4\u03b5 \u03ba\u03b1\u03b9 \u03b4\u03b9\u03b1\u03b3\u03c1\u03ac\u03c8\u03c4\u03b5 \u03b8\u03ad\u03c3\u03b5\u03b9\u03c2 \u03c7\u03c1\u03b7\u03c3\u03b9\u03bc\u03bf\u03c0\u03bf\u03b9\u03ce\u03bd\u03c4\u03b1\u03c2 \u03c4\u03bf\u03bd \u039f\u03c0\u03c4\u03b9\u03ba\u03cc \u03a3\u03c7\u03b5\u03b4\u03b9\u03b1\u03c3\u03c4\u03ae. \u039c\u03c0\u03bf\u03c1\u03b5\u03af\u03c4\u03b5 \u03bd\u03b1 \u03b5\u03c0\u03b5\u03be\u03b5\u03c1\u03b3\u03b1\u03c3\u03c4\u03b5\u03af\u03c4\u03b5 \u03c4\u03b9\u03c2 \u03bb\u03b5\u03c0\u03c4\u03bf\u03bc\u03ad\u03c1\u03b5\u03b9\u03b5\u03c2 \u03c4\u03c9\u03bd \u03b8\u03ad\u03c3\u03b5\u03c9\u03bd (\u03b5\u03c4\u03b9\u03ba\u03ad\u03c4\u03b1, \u03ba\u03b1\u03c4\u03b7\u03b3\u03bf\u03c1\u03af\u03b1) \u03b5\u03b4\u03ce."],"Unique ID like A-1, B-2, VIP-01":["\u039c\u03bf\u03bd\u03b1\u03b4\u03b9\u03ba\u03cc \u03b1\u03bd\u03b1\u03b3\u03bd\u03c9\u03c1\u03b9\u03c3\u03c4\u03b9\u03ba\u03cc \u03cc\u03c0\u03c9\u03c2 A-1, B-2, VIP-01"],"Upgrade to Premium":["\u0391\u03bd\u03b1\u03b2\u03ac\u03b8\u03bc\u03b9\u03c3\u03b7 \u03c3\u03b5 Premium"],"Use Visual Designer to add seats":["\u03a7\u03c1\u03b7\u03c3\u03b9\u03bc\u03bf\u03c0\u03bf\u03b9\u03ae\u03c3\u03c4\u03b5 \u03c4\u03bf\u03bd Visual Designer \u03b3\u03b9\u03b1 \u03bd\u03b1 \u03c0\u03c1\u03bf\u03c3\u03b8\u03ad\u03c3\u03b5\u03c4\u03b5 \u03b8\u03ad\u03c3\u03b5\u03b9\u03c2"],"Venue Photo":["\u03a6\u03c9\u03c4\u03bf\u03b3\u03c1\u03b1\u03c6\u03af\u03b1 \u03a7\u03ce\u03c1\u03bf\u03c5"],"View Venue Photo":["\u03a0\u03c1\u03bf\u03b2\u03bf\u03bb\u03ae \u03a6\u03c9\u03c4\u03bf\u03b3\u03c1\u03b1\u03c6\u03af\u03b1\u03c2 \u03a7\u03ce\u03c1\u03bf\u03c5"],"Visual (Seat Map)":["\u039f\u03c0\u03c4\u03b9\u03ba\u03cc (\u03a7\u03ac\u03c1\u03c4\u03b7\u03c2 \u0398\u03ad\u03c3\u03b5\u03c9\u03bd)"],"Visual Designer":["\u039f\u03c0\u03c4\u03b9\u03ba\u03cc\u03c2 \u03a3\u03c7\u03b5\u03b4\u03b9\u03b1\u03c3\u03c4\u03ae\u03c2"],"Visual Layout (Seat Map)":["\u039f\u03c0\u03c4\u03b9\u03ba\u03ae \u0394\u03b9\u03ac\u03c4\u03b1\u03be\u03b7 (\u03a7\u03ac\u03c1\u03c4\u03b7\u03c2 \u0398\u03ad\u03c3\u03b5\u03c9\u03bd)"],"created":["\u03b4\u03b7\u03bc\u03b9\u03bf\u03c5\u03c1\u03b3\u03ae\u03b8\u03b7\u03ba\u03b5"],"optional":["opcion\u00e1lis"],"selected":["\u03b5\u03c0\u03b9\u03bb\u03b5\u03b3\u03bc\u03ad\u03bd\u03bf"],"skipped":["\u03c0\u03b1\u03c1\u03b1\u03bb\u03b5\u03af\u03c6\u03b8\u03b7\u03ba\u03b5"],"updated":["\u03b5\u03bd\u03b7\u03bc\u03b5\u03c1\u03ce\u03b8\u03b7\u03ba\u03b5"]}}}