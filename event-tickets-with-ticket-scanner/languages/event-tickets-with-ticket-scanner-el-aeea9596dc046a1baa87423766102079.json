{"translation-revision-date":"2026-03-24 18:00+0100","generator":"WP-CLI\/2.12.0","source":"js\/seating_a.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"hu_HU","plural-forms":"nplurals=2; plural=(n != 1);"},"Seating plan created successfully":["\u0397 \u03b4\u03b7\u03bc\u03b9\u03bf\u03c5\u03c1\u03b3\u03af\u03b1 \u03c4\u03bf\u03c5 \u03c3\u03c7\u03b5\u03b4\u03af\u03bf\u03c5 \u03ba\u03b1\u03b8\u03b9\u03c3\u03bc\u03ac\u03c4\u03c9\u03bd \u03bf\u03bb\u03bf\u03ba\u03bb\u03b7\u03c1\u03ce\u03b8\u03b7\u03ba\u03b5 \u03b5\u03c0\u03b9\u03c4\u03c5\u03c7\u03ce\u03c2"],"Seating plan updated successfully":["\u0397 \u03b5\u03bd\u03b7\u03bc\u03ad\u03c1\u03c9\u03c3\u03b7 \u03c4\u03bf\u03c5 \u03c3\u03c7\u03b5\u03b4\u03af\u03bf\u03c5 \u03ba\u03b1\u03b8\u03b9\u03c3\u03bc\u03ac\u03c4\u03c9\u03bd \u03bf\u03bb\u03bf\u03ba\u03bb\u03b7\u03c1\u03ce\u03b8\u03b7\u03ba\u03b5 \u03b5\u03c0\u03b9\u03c4\u03c5\u03c7\u03ce\u03c2"],"Seating plan deleted successfully":["\u0397 \u03b4\u03b9\u03b1\u03b3\u03c1\u03b1\u03c6\u03ae \u03c4\u03bf\u03c5 \u03c3\u03c7\u03b5\u03b4\u03af\u03bf\u03c5 \u03ba\u03b1\u03b8\u03b9\u03c3\u03bc\u03ac\u03c4\u03c9\u03bd \u03bf\u03bb\u03bf\u03ba\u03bb\u03b7\u03c1\u03ce\u03b8\u03b7\u03ba\u03b5 \u03b5\u03c0\u03b9\u03c4\u03c5\u03c7\u03ce\u03c2"],"Seating plan cloned successfully":["\u0397 \u03ba\u03bb\u03c9\u03bd\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b7 \u03c4\u03bf\u03c5 \u03c3\u03c7\u03b5\u03b4\u03af\u03bf\u03c5 \u03ba\u03b1\u03b8\u03b9\u03c3\u03bc\u03ac\u03c4\u03c9\u03bd \u03bf\u03bb\u03bf\u03ba\u03bb\u03b7\u03c1\u03ce\u03b8\u03b7\u03ba\u03b5 \u03b5\u03c0\u03b9\u03c4\u03c5\u03c7\u03ce\u03c2"],"Seat created successfully":["\u0397 \u03b8\u03ad\u03c3\u03b7 \u03b4\u03b7\u03bc\u03b9\u03bf\u03c5\u03c1\u03b3\u03ae\u03b8\u03b7\u03ba\u03b5 \u03bc\u03b5 \u03b5\u03c0\u03b9\u03c4\u03c5\u03c7\u03af\u03b1"],"Seat updated successfully":["\u0397 \u03b8\u03ad\u03c3\u03b7 \u03b5\u03bd\u03b7\u03bc\u03b5\u03c1\u03ce\u03b8\u03b7\u03ba\u03b5 \u03b5\u03c0\u03b9\u03c4\u03c5\u03c7\u03ce\u03c2"],"Seat deleted successfully":["\u0397 \u03b8\u03ad\u03c3\u03b7 \u03b4\u03b9\u03b1\u03b3\u03c1\u03ac\u03c6\u03b7\u03ba\u03b5 \u03bc\u03b5 \u03b5\u03c0\u03b9\u03c4\u03c5\u03c7\u03af\u03b1"],"Are you sure you want to delete this?":["\u0395\u03af\u03c3\u03c4\u03b5 \u03b2\u03ad\u03b2\u03b1\u03b9\u03bf\u03b9 \u03cc\u03c4\u03b9 \u03b8\u03ad\u03bb\u03b5\u03c4\u03b5 \u03bd\u03b1 \u03c4\u03bf \u03b4\u03b9\u03b1\u03b3\u03c1\u03ac\u03c8\u03b5\u03c4\u03b5;"],"This plan has seats. Delete plan and all seats?":["\u0391\u03c5\u03c4\u03cc \u03c4\u03bf \u03c0\u03bb\u03ac\u03bd\u03bf \u03ad\u03c7\u03b5\u03b9 \u03b8\u03ad\u03c3\u03b5\u03b9\u03c2. \u039d\u03b1 \u03b4\u03b9\u03b1\u03b3\u03c1\u03b1\u03c6\u03b5\u03af \u03c4\u03bf \u03c0\u03bb\u03ac\u03bd\u03bf \u03ba\u03b1\u03b9 \u03cc\u03bb\u03b5\u03c2 \u03bf\u03b9 \u03b8\u03ad\u03c3\u03b5\u03b9\u03c2;"],"Seats created successfully":["\u039f\u03b9 \u03b8\u03ad\u03c3\u03b5\u03b9\u03c2 \u03b4\u03b7\u03bc\u03b9\u03bf\u03c5\u03c1\u03b3\u03ae\u03b8\u03b7\u03ba\u03b1\u03bd \u03b5\u03c0\u03b9\u03c4\u03c5\u03c7\u03ce\u03c2"],"Limit reached. Upgrade to Premium for unlimited access.":["\u03a3\u03c5\u03bc\u03c0\u03bb\u03b7\u03c1\u03ce\u03b8\u03b7\u03ba\u03b5 \u03c4\u03bf \u03cc\u03c1\u03b9\u03bf. \u0391\u03bd\u03b1\u03b2\u03b1\u03b8\u03bc\u03af\u03c3\u03c4\u03b5 \u03c3\u03b5 Premium \u03b3\u03b9\u03b1 \u03b1\u03c0\u03b5\u03c1\u03b9\u03cc\u03c1\u03b9\u03c3\u03c4\u03b7 \u03c0\u03c1\u03cc\u03c3\u03b2\u03b1\u03c3\u03b7."],"An error occurred. Please try again.":["\u03a0\u03b1\u03c1\u03bf\u03c5\u03c3\u03b9\u03ac\u03c3\u03c4\u03b7\u03ba\u03b5 \u03c3\u03c6\u03ac\u03bb\u03bc\u03b1. \u03a0\u03b1\u03c1\u03b1\u03ba\u03b1\u03bb\u03ce \u03b4\u03bf\u03ba\u03b9\u03bc\u03ac\u03c3\u03c4\u03b5 \u03be\u03b1\u03bd\u03ac."],"Loading...":["\u03a6\u03cc\u03c1\u03c4\u03c9\u03c3\u03b7..."],"No seating plans found. Create your first plan!":["\u0394\u03b5\u03bd \u03b2\u03c1\u03ad\u03b8\u03b7\u03ba\u03b1\u03bd \u03c3\u03c7\u03ad\u03b4\u03b9\u03b1 \u03ba\u03b1\u03b8\u03b9\u03c3\u03bc\u03ac\u03c4\u03c9\u03bd. \u0394\u03b7\u03bc\u03b9\u03bf\u03c5\u03c1\u03b3\u03ae\u03c3\u03c4\u03b5 \u03c4\u03bf \u03c0\u03c1\u03ce\u03c4\u03bf \u03c3\u03b1\u03c2 \u03c3\u03c7\u03ad\u03b4\u03b9\u03bf!"],"No seats in this plan. Add seats below.":["\u0394\u03b5\u03bd \u03c5\u03c0\u03ac\u03c1\u03c7\u03bf\u03c5\u03bd \u03b8\u03ad\u03c3\u03b5\u03b9\u03c2 \u03c3\u03b5 \u03b1\u03c5\u03c4\u03cc \u03c4\u03bf \u03c3\u03c7\u03ad\u03b4\u03b9\u03bf. \u03a0\u03c1\u03bf\u03c3\u03b8\u03ad\u03c3\u03c4\u03b5 \u03b8\u03ad\u03c3\u03b5\u03b9\u03c2 \u03c0\u03b1\u03c1\u03b1\u03ba\u03ac\u03c4\u03c9."],"Simple Layout (Dropdown)":["\u0391\u03c0\u03bb\u03ae \u03b4\u03b9\u03ac\u03c4\u03b1\u03be\u03b7 (\u0391\u03bd\u03b1\u03c0\u03c4\u03c5\u03c3\u03c3\u03cc\u03bc\u03b5\u03bd\u03b7 \u03bb\u03af\u03c3\u03c4\u03b1)"],"Customers will see a dropdown menu to select their seat. Available seats are shown in a list sorted by identifier. This is ideal for smaller venues or when visual seat selection is not needed.":["\u039f\u03b9 \u03c0\u03b5\u03bb\u03ac\u03c4\u03b5\u03c2 \u03b8\u03b1 \u03b4\u03bf\u03c5\u03bd \u03ad\u03bd\u03b1 \u03b1\u03bd\u03b1\u03c0\u03c4\u03c5\u03c3\u03c3\u03cc\u03bc\u03b5\u03bd\u03bf \u03bc\u03b5\u03bd\u03bf\u03cd \u03b3\u03b9\u03b1 \u03bd\u03b1 \u03b5\u03c0\u03b9\u03bb\u03ad\u03be\u03bf\u03c5\u03bd \u03c4\u03b7 \u03b8\u03ad\u03c3\u03b7 \u03c4\u03bf\u03c5\u03c2. \u039f\u03b9 \u03b4\u03b9\u03b1\u03b8\u03ad\u03c3\u03b9\u03bc\u03b5\u03c2 \u03b8\u03ad\u03c3\u03b5\u03b9\u03c2 \u03b5\u03bc\u03c6\u03b1\u03bd\u03af\u03b6\u03bf\u03bd\u03c4\u03b1\u03b9 \u03c3\u03b5 \u03bb\u03af\u03c3\u03c4\u03b1 \u03c4\u03b1\u03be\u03b9\u03bd\u03bf\u03bc\u03b7\u03bc\u03ad\u03bd\u03b7 \u03ba\u03b1\u03c4\u03ac \u03b1\u03bd\u03b1\u03b3\u03bd\u03c9\u03c1\u03b9\u03c3\u03c4\u03b9\u03ba\u03cc. \u0391\u03c5\u03c4\u03cc \u03b5\u03af\u03bd\u03b1\u03b9 \u03b9\u03b4\u03b1\u03bd\u03b9\u03ba\u03cc \u03b3\u03b9\u03b1 \u03bc\u03b9\u03ba\u03c1\u03cc\u03c4\u03b5\u03c1\u03bf\u03c5\u03c2 \u03c7\u03ce\u03c1\u03bf\u03c5\u03c2 \u03ae \u03cc\u03c4\u03b1\u03bd \u03b4\u03b5\u03bd \u03b1\u03c0\u03b1\u03b9\u03c4\u03b5\u03af\u03c4\u03b1\u03b9 \u03bf\u03c0\u03c4\u03b9\u03ba\u03ae \u03b5\u03c0\u03b9\u03bb\u03bf\u03b3\u03ae \u03b8\u03ad\u03c3\u03b7\u03c2."],"Visual Layout (Seat Map)":["\u039f\u03c0\u03c4\u03b9\u03ba\u03ae \u0394\u03b9\u03ac\u03c4\u03b1\u03be\u03b7 (\u03a7\u03ac\u03c1\u03c4\u03b7\u03c2 \u0398\u03ad\u03c3\u03b5\u03c9\u03bd)"],"Customers will see an interactive seat map where they can click on available seats. Occupied seats are shown in a different color. This provides a visual overview of the venue. (Premium feature)":["\u039f\u03b9 \u03c0\u03b5\u03bb\u03ac\u03c4\u03b5\u03c2 \u03b8\u03b1 \u03b4\u03bf\u03c5\u03bd \u03ad\u03bd\u03b1\u03bd \u03b4\u03b9\u03b1\u03b4\u03c1\u03b1\u03c3\u03c4\u03b9\u03ba\u03cc \u03c7\u03ac\u03c1\u03c4\u03b7 \u03b8\u03ad\u03c3\u03b5\u03c9\u03bd \u03cc\u03c0\u03bf\u03c5 \u03bc\u03c0\u03bf\u03c1\u03bf\u03cd\u03bd \u03bd\u03b1 \u03ba\u03ac\u03bd\u03bf\u03c5\u03bd \u03ba\u03bb\u03b9\u03ba \u03c3\u03c4\u03b9\u03c2 \u03b4\u03b9\u03b1\u03b8\u03ad\u03c3\u03b9\u03bc\u03b5\u03c2 \u03b8\u03ad\u03c3\u03b5\u03b9\u03c2. \u039f\u03b9 \u03ba\u03b1\u03c4\u03b5\u03b9\u03bb\u03b7\u03bc\u03bc\u03ad\u03bd\u03b5\u03c2 \u03b8\u03ad\u03c3\u03b5\u03b9\u03c2 \u03b5\u03bc\u03c6\u03b1\u03bd\u03af\u03b6\u03bf\u03bd\u03c4\u03b1\u03b9 \u03bc\u03b5 \u03b4\u03b9\u03b1\u03c6\u03bf\u03c1\u03b5\u03c4\u03b9\u03ba\u03cc \u03c7\u03c1\u03ce\u03bc\u03b1. \u0391\u03c5\u03c4\u03cc \u03c0\u03b1\u03c1\u03ad\u03c7\u03b5\u03b9 \u03bc\u03b9\u03b1 \u03bf\u03c0\u03c4\u03b9\u03ba\u03ae \u03b5\u03b9\u03ba\u03cc\u03bd\u03b1 \u03c4\u03bf\u03c5 \u03c7\u03ce\u03c1\u03bf\u03c5. (\u039b\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1 Premium)"],"Seat":["\u0398\u03ad\u03c3\u03b7"],"Seating Plan":["\u03a3\u03c7\u03ad\u03b4\u03b9\u03bf \u03ba\u03b1\u03b8\u03b9\u03c3\u03bc\u03ac\u03c4\u03c9\u03bd"],"Description":["Le\u00edr\u00e1s"],"Active":["\u0395\u03bd\u03b5\u03c1\u03b3\u03cc"],"Inactive":["\u0391\u03bd\u03b5\u03bd\u03b5\u03c1\u03b3\u03cc"],"Activate":["\u0395\u03bd\u03b5\u03c1\u03b3\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b7"],"Status":["\u00c1llapot"],"Export CSV":["\u0395\u03be\u03b1\u03b3\u03c9\u03b3\u03ae CSV"],"Edit":["Szerkeszt\u00e9s"],"Delete":["T\u00f6rl\u00e9s"],"Cancel":["M\u00e9gse"],"Drag to reorder":["\u03a3\u03cd\u03c1\u03b5\u03c4\u03b5 \u03b3\u03b9\u03b1 \u03b1\u03bd\u03b1\u03b4\u03b9\u03ac\u03c4\u03b1\u03be\u03b7"],"Remove":["\u0391\u03c6\u03b1\u03af\u03c1\u03b5\u03c3\u03b7"],"Label":["\u0395\u03c4\u03b9\u03ba\u03ad\u03c4\u03b1"],"Name":["N\u00e9v"],"Show Layout":["\u0395\u03bc\u03c6\u03ac\u03bd\u03b9\u03c3\u03b7 \u03b4\u03b9\u03ac\u03c4\u03b1\u03be\u03b7\u03c2"],"Hide Layout":["\u0391\u03c0\u03cc\u03ba\u03c1\u03c5\u03c8\u03b7 \u0394\u03b9\u03ac\u03c4\u03b1\u03be\u03b7\u03c2"],"Delete %d seats?":["\u0394\u03b9\u03b1\u03b3\u03c1\u03b1\u03c6\u03ae %d \u03b8\u03ad\u03c3\u03b5\u03c9\u03bd;"],"%d seats updated":["%d \u03b8\u03ad\u03c3\u03b5\u03b9\u03c2 \u03b5\u03bd\u03b7\u03bc\u03b5\u03c1\u03ce\u03b8\u03b7\u03ba\u03b1\u03bd"],"%d seats deleted":["%d \u03b8\u03ad\u03c3\u03b5\u03b9\u03c2 \u03b4\u03b9\u03b1\u03b3\u03c1\u03ac\u03c6\u03b7\u03ba\u03b1\u03bd"],"%d seats processed, %d errors":["%d \u03b8\u03ad\u03c3\u03b5\u03b9\u03c2 \u03b5\u03c0\u03b5\u03be\u03b5\u03c1\u03b3\u03ac\u03c3\u03c4\u03b7\u03ba\u03b1\u03bd, %d \u03c3\u03c6\u03ac\u03bb\u03bc\u03b1\u03c4\u03b1"],"selected":["\u03b5\u03c0\u03b9\u03bb\u03b5\u03b3\u03bc\u03ad\u03bd\u03bf"],"-- Action --":["-- \u0395\u03bd\u03ad\u03c1\u03b3\u03b5\u03b9\u03b1 --"],"Deactivate":["\u0391\u03c0\u03b5\u03bd\u03b5\u03c1\u03b3\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b7"],"Layout":["\u0394\u03b9\u03ac\u03c4\u03b1\u03be\u03b7"],"Seats":["\u0398\u03ad\u03c3\u03b5\u03b9\u03c2"],"Actions":["\u0395\u03bd\u03ad\u03c1\u03b3\u03b5\u03b9\u03b5\u03c2"],"Visual (Seat Map)":["\u039f\u03c0\u03c4\u03b9\u03ba\u03cc (\u03a7\u03ac\u03c1\u03c4\u03b7\u03c2 \u0398\u03ad\u03c3\u03b5\u03c9\u03bd)"],"Simple (Dropdown)":["\u0391\u03c0\u03bb\u03cc (\u0391\u03bd\u03b1\u03c0\u03c4\u03c5\u03c3\u03c3\u03cc\u03bc\u03b5\u03bd\u03b7 \u03bb\u03af\u03c3\u03c4\u03b1)"],"View Venue Photo":["\u03a0\u03c1\u03bf\u03b2\u03bf\u03bb\u03ae \u03a6\u03c9\u03c4\u03bf\u03b3\u03c1\u03b1\u03c6\u03af\u03b1\u03c2 \u03a7\u03ce\u03c1\u03bf\u03c5"],"Open Designer":["\u0386\u03bd\u03bf\u03b9\u03b3\u03bc\u03b1 \u03c3\u03c7\u03b5\u03b4\u03b9\u03b1\u03c3\u03c4\u03ae"],"Manage Seats":["\u0394\u03b9\u03b1\u03c7\u03b5\u03af\u03c1\u03b9\u03c3\u03b7 \u03b8\u03ad\u03c3\u03b5\u03c9\u03bd"],"Clone":["\u039a\u03bb\u03c9\u03bd\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b7"],"Edit Seating Plan":["\u0395\u03c0\u03b5\u03be\u03b5\u03c1\u03b3\u03b1\u03c3\u03af\u03b1 \u03c3\u03c7\u03b5\u03b4\u03af\u03bf\u03c5 \u03ba\u03b1\u03b8\u03b9\u03c3\u03bc\u03ac\u03c4\u03c9\u03bd"],"New Seating Plan":["\u039d\u03ad\u03bf \u03c3\u03c7\u03ad\u03b4\u03b9\u03bf \u03ba\u03b1\u03b8\u03b9\u03c3\u03bc\u03ac\u03c4\u03c9\u03bd"],"Failed to load designer script":["\u0391\u03c0\u03bf\u03c4\u03c5\u03c7\u03af\u03b1 \u03c6\u03cc\u03c1\u03c4\u03c9\u03c3\u03b7\u03c2 \u03b4\u03ad\u03c3\u03bc\u03b7\u03c2 \u03b5\u03bd\u03b5\u03c1\u03b3\u03b5\u03b9\u03ce\u03bd \u03c4\u03bf\u03c5 \u03c3\u03c7\u03b5\u03b4\u03b9\u03b1\u03c3\u03c4\u03ae"],"Designer failed to load":["\u0391\u03c0\u03bf\u03c4\u03c5\u03c7\u03af\u03b1 \u03c6\u03cc\u03c1\u03c4\u03c9\u03c3\u03b7\u03c2 \u03c4\u03bf\u03c5 \u03c3\u03c7\u03b5\u03b4\u03b9\u03b1\u03c3\u03c4\u03ae"],"Click to view published version":["\u039a\u03ac\u03bd\u03c4\u03b5 \u03ba\u03bb\u03b9\u03ba \u03b3\u03b9\u03b1 \u03c0\u03c1\u03bf\u03b2\u03bf\u03bb\u03ae \u03b4\u03b7\u03bc\u03bf\u03c3\u03b9\u03b5\u03c5\u03bc\u03ad\u03bd\u03b7\u03c2 \u03ad\u03ba\u03b4\u03bf\u03c3\u03b7\u03c2"],"Published":["\u0394\u03b7\u03bc\u03bf\u03c3\u03b9\u03b5\u03c5\u03bc\u03ad\u03bd\u03bf"],"Click to view\/edit draft":["\u039a\u03ac\u03bd\u03c4\u03b5 \u03ba\u03bb\u03b9\u03ba \u03b3\u03b9\u03b1 \u03c0\u03c1\u03bf\u03b2\u03bf\u03bb\u03ae\/\u03b5\u03c0\u03b5\u03be\