Shown in the wallet and email (e.g. \"Opera evening\", \"Zoo visit\"). Empty = use the global default.":["\u041e\u0442\u043e\u0431\u0440\u0430\u0436\u0430\u0435\u0442\u0441\u044f \u0432 \u043a\u043e\u0448\u0435\u043b\u044c\u043a\u0435 \u0438 \u043f\u0438\u0441\u044c\u043c\u0435 (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u00ab\u0412\u0435\u0447\u0435\u0440 \u043e\u043f\u0435\u0440\u044b\u00bb, \u00ab\u0412\u0438\u0437\u0438\u0442 \u0432 \u0437\u043e\u043e\u043f\u0430\u0440\u043a\u00bb). \u041f\u0443\u0441\u0442\u043e = \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f \u0433\u043b\u043e\u0431\u0430\u043b\u044c\u043d\u043e\u0435 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435 \u043f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e."],"Active":["\u0410\u043a\u0442\u0438\u0432\u043d\u043e"],"Save the congress first to add pages and sections.":["\u0421\u043d\u0430\u0447\u0430\u043b\u0430 \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u0435 \u043a\u043e\u043d\u0433\u0440\u0435\u0441\u0441, \u0447\u0442\u043e\u0431\u044b \u0434\u043e\u0431\u0430\u0432\u043b\u044f\u0442\u044c \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u044b \u0438 \u0440\u0430\u0437\u0434\u0435\u043b\u044b."],"Add":["\u0414\u043e\u0431\u0430\u0432\u0438\u0442\u044c"],"Expired":["\u0418\u0441\u0442\u0451\u043a"],"Turn off to hide this congress everywhere (page + wallet) without unassigning it \u2014 e.g. to publish the info only later.":["\u041e\u0442\u043a\u043b\u044e\u0447\u0438\u0442\u0435, \u0447\u0442\u043e\u0431\u044b \u0441\u043a\u0440\u044b\u0442\u044c \u044d\u0442\u043e\u0442 \u043a\u043e\u043d\u0433\u0440\u0435\u0441\u0441 \u0432\u0435\u0437\u0434\u0435 (\u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0430 + \u043a\u043e\u0448\u0435\u043b\u0451\u043a), \u043d\u0435 \u0441\u043d\u0438\u043c\u0430\u044f \u0435\u0433\u043e \u0441 \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f \u2014 \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0447\u0442\u043e\u0431\u044b \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u0442\u044c \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044e \u043f\u043e\u0437\u0436\u0435."],"Slug for new edition:":["Slug \u0434\u043b\u044f \u043d\u043e\u0432\u043e\u0433\u043e \u0438\u0437\u0434\u0430\u043d\u0438\u044f:"],"Add speaker":["\u0414\u043e\u0431\u0430\u0432\u0438\u0442\u044c \u0441\u043f\u0438\u043a\u0435\u0440\u0430"],"Title and slug are required.":["\u0417\u0430\u0433\u043e\u043b\u043e\u0432\u043e\u043a \u0438 slug \u043e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u044b."],"Program":["\u041f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0430"],"Updated":["\u041e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u043e"],"Products":["\u0422\u043e\u0432\u0430\u0440\u044b"],"Speaker":["\u0421\u043f\u0438\u043a\u0435\u0440"],"Pick files from the media library. Label is shown to visitors. Drag to reorder.":["\u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u0444\u0430\u0439\u043b\u044b \u0438\u0437 \u043c\u0435\u0434\u0438\u0430\u0431\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a\u0438. \u041c\u0435\u0442\u043a\u0430 \u043e\u0442\u043e\u0431\u0440\u0430\u0436\u0430\u0435\u0442\u0441\u044f \u043f\u043e\u0441\u0435\u0442\u0438\u0442\u0435\u043b\u044f\u043c. \u041f\u0435\u0440\u0435\u0442\u0430\u0449\u0438\u0442\u0435 \u0434\u043b\u044f \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u043f\u043e\u0440\u044f\u0434\u043a\u0430."],"Unique identifier for this congress. Visitors open it through their personal ticket link, not the slug.":["\u0423\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u0439 \u0438\u0434\u0435\u043d\u0442\u0438\u0444\u0438\u043a\u0430\u0442\u043e\u0440 \u044d\u0442\u043e\u0433\u043e \u043a\u043e\u043d\u0433\u0440\u0435\u0441\u0441\u0430. \u041f\u043e\u0441\u0435\u0442\u0438\u0442\u0435\u043b\u0438 \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u044e\u0442 \u0435\u0433\u043e \u0447\u0435\u0440\u0435\u0437 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u043b\u044c\u043d\u0443\u044e \u0441\u0441\u044b\u043b\u043a\u0443 \u0432 \u0431\u0438\u043b\u0435\u0442\u0435, \u0430 \u043d\u0435 \u043f\u043e slug."],"Choose":["\u0412\u044b\u0431\u0440\u0430\u0442\u044c"],"Save congress":["\u0421\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u044c \u043a\u043e\u043d\u0433\u0440\u0435\u0441\u0441"],"Delete page?":["\u0423\u0434\u0430\u043b\u0438\u0442\u044c \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0443?"],"Save":["\u0421\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u044c"],"Assign via the WooCommerce product settings.":["\u041d\u0430\u0437\u043d\u0430\u0447\u044c\u0442\u0435 \u0432 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0430\u0445 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0430 WooCommerce."],"Internal":["\u0412\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u044f\u044f"],"Insert variable\u2026":["\u0412\u0441\u0442\u0430\u0432\u0438\u0442\u044c \u043f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u0443\u044e\u2026"],"Files":["\u0424\u0430\u0439\u043b\u044b"],"Title":["\u041d\u0430\u0437\u0432\u0430\u043d\u0438\u0435"],"Cancel":["\u041e\u0442\u043c\u0435\u043d\u0430"],"Choose image":["\u0412\u044b\u0431\u0440\u0430\u0442\u044c \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435"],"Image":["\u0418\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435"],"Manual hard cutoff. Leave empty for unlimited access.":["\u0420\u0443\u0447\u043d\u043e\u0439 \u0436\u0451\u0441\u0442\u043a\u0438\u0439 \u0441\u0440\u043e\u043a. \u041e\u0441\u0442\u0430\u0432\u044c\u0442\u0435 \u043f\u0443\u0441\u0442\u044b\u043c \u0434\u043b\u044f \u043d\u0435\u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u043d\u043e\u0433\u043e \u0434\u043e\u0441\u0442\u0443\u043f\u0430."],"Caption (optional)":["\u041f\u043e\u0434\u043f\u0438\u0441\u044c (\u043d\u0435\u043e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e)"],"No pages yet. Add a page to start.":["\u0421\u0442\u0440\u0430\u043d\u0438\u0446 \u043f\u043e\u043a\u0430 \u043d\u0435\u0442. \u0414\u043e\u0431\u0430\u0432\u044c\u0442\u0435 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0443, \u0447\u0442\u043e\u0431\u044b \u043d\u0430\u0447\u0430\u0442\u044c."],"Portal label":["\u041c\u0435\u0442\u043a\u0430 \u043f\u043e\u0440\u0442\u0430\u043b\u0430"],"assigned (manage on product level)":["\u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u043e (\u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u043d\u0430 \u0443\u0440\u043e\u0432\u043d\u0435 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0430)"],"Video":["\u0412\u0438\u0434\u0435\u043e"],"Icon":["\u0418\u043a\u043e\u043d\u043a\u0430"],"Drag to reorder":["\u041f\u0435\u0440\u0435\u0442\u0430\u0449\u0438\u0442\u0435 \u0434\u043b\u044f \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u043f\u043e\u0440\u044f\u0434\u043a\u0430"],"Room":["\u0417\u0430\u043b"],"Add URL":["\u0414\u043e\u0431\u0430\u0432\u0438\u0442\u044c URL"],"Type":["\u0422\u0438\u043f"],"Access expires (optional)":["\u0421\u0440\u043e\u043a \u0434\u043e\u0441\u0442\u0443\u043f\u0430 (\u043d\u0435\u043e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e)"],"Active \u2014 visible to ticket holders":["\u0410\u043a\u0442\u0438\u0432\u043d\u043e \u2014 \u0432\u0438\u0434\u043d\u043e \u0434\u0435\u0440\u0436\u0430\u0442\u0435\u043b\u044f\u043c \u0431\u0438\u043b\u0435\u0442\u043e\u0432"],"Add page":["\u0414\u043e\u0431\u0430\u0432\u0438\u0442\u044c \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0443"],"This action cannot be undone. All sections will be deleted as well.":["\u042d\u0442\u043e \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u043d\u0435\u043b\u044c\u0437\u044f \u043e\u0442\u043c\u0435\u043d\u0438\u0442\u044c. \u0412\u0441\u0435 \u0440\u0430\u0437\u0434\u0435\u043b\u044b \u0442\u0430\u043a\u0436\u0435 \u0431\u0443\u0434\u0443\u0442 \u0443\u0434\u0430\u043b\u0435\u043d\u044b."],"Icon, optional image, card color and a short description shown on the page card.":["\u0418\u043a\u043e\u043d\u043a\u0430, \u043d\u0435\u043e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0435 \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435, \u0446\u0432\u0435\u0442 \u043a\u0430\u0440\u0442\u043e\u0447\u043a\u0438 \u0438 \u043a\u0440\u0430\u0442\u043a\u043e\u0435 \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435, \u043e\u0442\u043e\u0431\u0440\u0430\u0436\u0430\u0435\u043c\u044b\u0435 \u043d\u0430 \u043a\u0430\u0440\u0442\u043e\u0447\u043a\u0435 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u044b."],"Video file":["\u0412\u0438\u0434\u0435\u043e\u0444\u0430\u0439\u043b"],"Title for new edition (leave empty to auto-generate):":["\u041d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u043d\u043e\u0432\u043e\u0433\u043e \u0438\u0437\u0434\u0430\u043d\u0438\u044f (\u043e\u0441\u0442\u0430\u0432\u044c\u0442\u0435 \u043f\u0443\u0441\u0442\u044b\u043c \u0434\u043b\u044f \u0430\u0432\u0442\u043e\u0433\u0435\u043d\u0435\u0440\u0430\u0446\u0438\u0438):"],"Paste a YouTube, Vimeo or other supported link. It is embedded automatically.":["\u0412\u0441\u0442\u0430\u0432\u044c\u0442\u0435 \u0441\u0441\u044b\u043b\u043a\u0443 YouTube, Vimeo \u0438\u043b\u0438 \u0434\u0440\u0443\u0433\u0443\u044e \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u043c\u0443\u044e \u0441\u0441\u044b\u043b\u043a\u0443. \u041e\u043d\u0430 \u0431\u0443\u0434\u0435\u0442 \u0432\u0441\u0442\u0440\u043e\u0435\u043d\u0430 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438."],"start page":["\u0441\u0442\u0430\u0440\u0442\u043e\u0432\u0430\u044f \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0430"],"Name":["\u0418\u043c\u044f"],"Select video":["\u0412\u044b\u0431\u0440\u0430\u0442\u044c \u0432\u0438\u0434\u0435\u043e"],"Remove slot":["\u0423\u0434\u0430\u043b\u0438\u0442\u044c \u0441\u043b\u043e\u0442"],"Add image":["\u0414\u043e\u0431\u0430\u0432\u0438\u0442\u044c \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435"],"Remove image":["\u0423\u0434\u0430\u043b\u0438\u0442\u044c \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435"],"Display size":["\u0420\u0430\u0437\u043c\u0435\u0440 \u043e\u0442\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u044f"],"Short description (max 160)":["\u041a\u0440\u0430\u0442\u043a\u043e\u0435 \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 (\u043d\u0435 \u0431\u043e\u043b\u0435\u0435 160)"],"Choose which page this section belongs to. Change it to move the section to another page.":["\u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0443, \u043a \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0441\u044f \u044d\u0442\u043e\u0442 \u0440\u0430\u0437\u0434\u0435\u043b. \u0418\u0437\u043c\u0435\u043d\u0438\u0442\u0435, \u0447\u0442\u043e\u0431\u044b \u043f\u0435\u0440\u0435\u043c\u0435\u0441\u0442\u0438\u0442\u044c \u0440\u0430\u0437\u0434\u0435\u043b \u043d\u0430 \u0434\u0440\u0443\u0433\u0443\u044e \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0443."],"Open full size when clicked":["\u041e\u0442\u043a\u0440\u044b\u0432\u0430\u0442\u044c \u0432 \u043f\u043e\u043b\u043d\u043e\u043c \u0440\u0430\u0437\u043c\u0435\u0440\u0435 \u043f\u043e \u043a\u043b\u0438\u043a\u0443"],"Content":["\u0421\u043e\u0434\u0435\u0440\u0436\u0438\u043c\u043e\u0435"],"Video URL":["URL \u0432\u0438\u0434\u0435\u043e"],"Uploaded video file":["\u0417\u0430\u0433\u0440\u0443\u0436\u0435\u043d\u043d\u044b\u0439 \u0432\u0438\u0434\u0435\u043e\u0444\u0430\u0439\u043b"],"Select file":["\u0412\u044b\u0431\u0440\u0430\u0442\u044c \u0444\u0430\u0439\u043b"],"New event app":[""],"Full width":["\u041f\u043e\u043b\u043d\u0430\u044f \u0448\u0438\u0440\u0438\u043d\u0430"],"Card color":["\u0426\u0432\u0435\u0442 \u043a\u0430\u0440\u0442\u043e\u0447\u043a\u0438"],"Add slot":["\u0414\u043e\u0431\u0430\u0432\u0438\u0442\u044c \u0441\u043b\u043e\u0442"],"Settings":["\u041d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438"],"Rename page":["\u041f\u0435\u0440\u0435\u0438\u043c\u0435\u043d\u043e\u0432\u0430\u0442\u044c \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0443"],"Short bio (max 500 characters)":["\u041a\u0440\u0430\u0442\u043a\u0430\u044f \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f (\u043d\u0435 \u0431\u043e\u043b\u0435\u0435 500 \u0441\u0438\u043c\u0432\u043e\u043b\u043e\u0432)"],"No icon":["\u0411\u0435\u0437 \u0438\u043a\u043e\u043d\u043a\u0438"],"An event app is the companion page your visitors open with their ticket: programme and schedule, speaker or artist info, venue maps, downloads, media and support pages \u2014 everything structured in one place. Perfect for a congress with multiple sessions, but just as much for a single event where ticket holders need extra info, a FAQ or contact options. Visitors do not need an account or an extra app: their ticket ID is the key, access opens with the ticket and can expire with it. Assign an event app to a product in the WooCommerce product settings \u2014 one app can serve multiple products, so an event series shares one app.":[""],"Source":["\u0418\u0441\u0442\u043e\u0447\u043d\u0438\u043a"],"Export contacts":["\u042d\u043a\u0441\u043f\u043e\u0440\u0442 \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u043e\u0432"],"Edit":["\u0420\u0435\u0434\u0430\u043a\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c"],"Page":["\u0421\u0442\u0440\u0430\u043d\u0438\u0446\u0430"],"Updated:":["\u041e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u043e:"],"Time":["\u0412\u0440\u0435\u043c\u044f"],"Open inline":["\u041e\u0442\u043a\u0440\u044b\u0432\u0430\u0442\u044c \u0432\u0441\u0442\u0440\u043e\u0435\u043d\u043d\u043e"],"Images":["\u0418\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u044f"],"Add file":["\u0414\u043e\u0431\u0430\u0432\u0438\u0442\u044c \u0444\u0430\u0439\u043b"]}}}