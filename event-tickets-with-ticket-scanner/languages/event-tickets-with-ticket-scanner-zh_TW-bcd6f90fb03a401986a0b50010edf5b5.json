{"translation-revision-date":"2026-03-24 18:00+0100","generator":"WP-CLI\/2.12.0","source":"js\/congress-a.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"zh_TW","plural-forms":"nplurals=1; plural=0;"},"Title":["\u6a19\u984c"],"Add":["\u65b0\u589e"],"Export contacts":["\u532f\u51fa\u806f\u7d61\u4eba"],"Portal label":["\u5165\u53e3\u6a19\u7c64"],"Shown in the wallet and email (e.g. \"Opera evening\", \"Zoo visit\"). Empty = use the global default.":["\u986f\u793a\u65bc\u9322\u5305\u8207\u96fb\u5b50\u90f5\u4ef6\u4e2d\uff08\u4f8b\u5982\u300c\u6b4c\u5287\u4e4b\u591c\u300d\u3001\u300c\u52d5\u7269\u5712\u4e4b\u65c5\u300d\uff09\u3002\u7559\u7a7a = \u4f7f\u7528\u5168\u57df\u9810\u8a2d\u503c\u3002"],"Show pages as a card grid on the start screen":["\u5728\u958b\u59cb\u756b\u9762\u4ee5\u5361\u7247\u7db2\u683c\u986f\u793a\u9801\u9762"],"Visitors first see a grid of page cards (icon\/image + description) instead of jumping straight into the first page.":["\u8a2a\u5ba2\u6703\u5148\u770b\u5230\u9801\u9762\u5361\u7247\u7db2\u683c\uff08\u5716\u793a\/\u5716\u7247 + \u8aaa\u660e\uff09\uff0c\u800c\u975e\u76f4\u63a5\u8df3\u5165\u7b2c\u4e00\u500b\u9801\u9762\u3002"],"Active \u2014 visible to ticket holders":["\u555f\u7528\u4e2d \u2014 \u7968\u5238\u6301\u6709\u4eba\u53ef\u898b"],"Turn off to hide this congress everywhere (page + wallet) without unassigning it \u2014 e.g. to publish the info only later.":["\u95dc\u9589\u5f8c\u53ef\u96b1\u85cf\u6b64\u8b70\u6703\u65bc\u6240\u6709\u4f4d\u7f6e\uff08\u9801\u9762 + \u9322\u5305\uff09\uff0c\u7121\u9808\u53d6\u6d88\u6307\u6d3e \u2014 \u4f8b\u5982\u53ef\u7a0d\u5f8c\u518d\u767c\u4f48\u8cc7\u8a0a\u3002"],"No icon":["\u7121\u5716\u793a"],"Remove image":["\u79fb\u9664\u5716\u7247"],"Icon, optional image, card color and a short description shown on the page card.":["\u5716\u793a\u3001\u9078\u586b\u5716\u7247\u3001\u5361\u7247\u984f\u8272\u53ca\u7c21\u77ed\u8aaa\u660e\u6703\u986f\u793a\u65bc\u9801\u9762\u5361\u7247\u4e0a\u3002"],"Icon":["\u5716\u793a"],"Image (optional, overrides icon)":["\u5716\u7247\uff08\u9078\u586b,\u512a\u5148\u65bc\u5716\u793a\uff09"],"Card color":["\u5361\u7247\u984f\u8272"],"Short description (max 160)":["\u7c21\u77ed\u8aaa\u660e\uff08\u6700\u591a 160 \u5b57\uff09"],"Page card settings":["\u9801\u9762\u5361\u7247\u8a2d\u5b9a"],"Settings":["\u8a2d\u5b9a"],"Speakers":["\u8b1b\u8005"],"Insert variable\u2026":["\u63d2\u5165\u8b8a\u6578\u2026"],"Short bio (max 500 characters)":["\u7c21\u77ed\u500b\u4eba\u7c21\u4ecb\uff08\u6700\u591a 500 \u5b57\u5143\uff09"],"Add speaker":["\u65b0\u589e\u8b1b\u8005"],"Each speaker has an image, name, title and a short bio (max 500 characters). One speaker is shown in full; several are shown as boxes. Drag to reorder.":["\u6bcf\u4f4d\u8b1b\u8005\u7686\u5305\u542b\u5716\u7247\u3001\u59d3\u540d\u3001\u8077\u7a31\u53ca\u7c21\u77ed\u500b\u4eba\u7c21\u4ecb\uff08\u6700\u591a 500 \u5b57\u5143\uff09\u3002\u55ae\u4e00\u8b1b\u8005\u6703\u5b8c\u6574\u986f\u793a\uff1b\u591a\u4f4d\u8b1b\u8005\u5247\u4ee5\u65b9\u584a\u5448\u73fe\u3002\u53ef\u62d6\u66f3\u8abf\u6574\u9806\u5e8f\u3002"]}}}