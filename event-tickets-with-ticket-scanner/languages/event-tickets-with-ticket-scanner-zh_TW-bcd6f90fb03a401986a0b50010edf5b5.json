{"translation-revision-date":"2026-03-24 18:00+0100","generator":"WP-CLI\/2.12.0","source":"js\/congress-a.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"zh_TW","plural-forms":"nplurals=1; plural=0;"},"Error":["\u932f\u8aa4"],"Active":["\u555f\u7528"],"Status":["\u72c0\u614b"],"Expired":["\u5df2\u904e\u671f"],"New congress":["\u65b0\u589e\u5927\u6703"],"Title":["\u6a19\u984c"],"Products":["\u7522\u54c1"],"Updated":["\u5df2\u66f4\u65b0"],"Export contacts":["\u532f\u51fa\u806f\u7d61\u4eba"],"Edit":["\u7de8\u8f2f"],"New edition":["\u65b0\u589e\u5c46\u6b21"],"Delete":["\u522a\u9664"],"Congresses let you attach structured information (programme, downloads, media, texts) to an event. Ticket holders can access the congress page using their ticket ID. Assign a congress to a product in the WooCommerce product settings \u2014 one congress can be shared across multiple products.":["\u5927\u6703\u53ef\u8b93\u60a8\u5c07\u7d50\u69cb\u5316\u8cc7\u8a0a\uff08\u8b70\u7a0b\u3001\u4e0b\u8f09\u3001\u5a92\u9ad4\u3001\u6587\u5b57\uff09\u9644\u52a0\u81f3\u6d3b\u52d5\u3002\u7968\u5238\u6301\u6709\u4eba\u53ef\u4f7f\u7528\u5176\u7968\u5238 ID \u5b58\u53d6\u5927\u6703\u9801\u9762\u3002\u8acb\u5728 WooCommerce \u5546\u54c1\u8a2d\u5b9a\u4e2d\u5c07\u5927\u6703\u6307\u6d3e\u7d66\u5546\u54c1 \u2014 \u4e00\u500b\u5927\u6703\u53ef\u540c\u6642\u6307\u6d3e\u7d66\u591a\u500b\u5546\u54c1\u3002"],"Delete this congress?":["\u522a\u9664\u6b64\u5927\u6703\uff1f"],"This action cannot be undone. All sections will be deleted as well.":["\u6b64\u64cd\u4f5c\u7121\u6cd5\u5fa9\u539f\u3002\u6240\u6709\u7ae0\u7bc0\u4e5f\u5c07\u4e00\u4f75\u522a\u9664\u3002"],"Current title:":["\u76ee\u524d\u6a19\u984c\uff1a"],"Current slug:":["\u76ee\u524d slug\uff1a"],"Slug for new edition:":["\u65b0\u5c46\u6b21\u4ee3\u7a31:"],"Title for new edition (leave empty to auto-generate):":["\u65b0\u5c46\u6b21\u6a19\u984c (\u7559\u7a7a\u5c07\u81ea\u52d5\u7522\u751f):"],"Create":["\u5efa\u7acb"],"Cancel":["\u53d6\u6d88"],"Edit congress":["\u7de8\u8f2f\u5927\u6703"],"Details":["\u8a73\u7d30\u8cc7\u6599"],"Unique identifier for this congress. Visitors open it through their personal ticket link, not the slug.":["\u6b64\u5927\u6703\u7684\u552f\u4e00\u8b58\u5225\u78bc\u3002\u8a2a\u5ba2\u900f\u904e\u5176\u500b\u4eba\u7968\u5238\u9023\u7d50 (\u975e\u4ee3\u7a31) \u958b\u555f\u3002"],"Portal label":["\u5165\u53e3\u6a19\u7c64"],"Shown in the wallet and email (e.g. \"Opera evening\", \"Zoo visit\"). Empty = use the global default.":["\u986f\u793a\u65bc\u9322\u5305\u8207\u96fb\u5b50\u90f5\u4ef6\u4e2d\uff08\u4f8b\u5982\u300c\u6b4c\u5287\u4e4b\u591c\u300d\u3001\u300c\u52d5\u7269\u5712\u4e4b\u65c5\u300d\uff09\u3002\u7559\u7a7a = \u4f7f\u7528\u5168\u57df\u9810\u8a2d\u503c\u3002"],"Show pages as a card grid on the start screen":["\u5728\u958b\u59cb\u756b\u9762\u4ee5\u5361\u7247\u7db2\u683c\u986f\u793a\u9801\u9762"],"Visitors first see a grid of page cards (icon\/image + description) instead of jumping straight into the first page.":["\u8a2a\u5ba2\u6703\u5148\u770b\u5230\u9801\u9762\u5361\u7247\u7db2\u683c\uff08\u5716\u793a\/\u5716\u7247 + \u8aaa\u660e\uff09\uff0c\u800c\u975e\u76f4\u63a5\u8df3\u5165\u7b2c\u4e00\u500b\u9801\u9762\u3002"],"Access expires (optional)":["\u5b58\u53d6\u5230\u671f\u6642\u9593\uff08\u9078\u586b\uff09"],"Manual hard cutoff. Leave empty for unlimited access.":["\u624b\u52d5\u5f37\u5236\u622a\u6b62\u6642\u9593\u3002\u7559\u767d\u8868\u793a\u7121\u5b58\u53d6\u9650\u5236\u3002"],"Active \u2014 visible to ticket holders":["\u555f\u7528\u4e2d \u2014 \u7968\u5238\u6301\u6709\u4eba\u53ef\u898b"],"Turn off to hide this congress everywhere (page + wallet) without unassigning it \u2014 e.g. to publish the info only later.":["\u95dc\u9589\u5f8c\u53ef\u96b1\u85cf\u6b64\u8b70\u6703\u65bc\u6240\u6709\u4f4d\u7f6e\uff08\u9801\u9762 + \u9322\u5305\uff09\uff0c\u7121\u9808\u53d6\u6d88\u6307\u6d3e \u2014 \u4f8b\u5982\u53ef\u7a0d\u5f8c\u518d\u767c\u4f48\u8cc7\u8a0a\u3002"],"assigned (manage on product level)":["\u5df2\u6307\u6d3e\uff08\u65bc\u5546\u54c1\u5c64\u7d1a\u7ba1\u7406\uff09"],"Assign via the WooCommerce product settings.":["\u8acb\u900f\u904e WooCommerce \u5546\u54c1\u8a2d\u5b9a\u9032\u884c\u6307\u6d3e\u3002"],"Save the congress first to add pages and sections.":["\u8acb\u5148\u5132\u5b58\u5927\u6703,\u624d\u80fd\u65b0\u589e\u9801\u9762\u8207\u7ae0\u7bc0\u3002"],"Pages":["\u9801\u9762"],"Add page":["\u65b0\u589e\u9801\u9762"],"The first page is the start page (shown first to visitors). Drag pages and sections to reorder.":["\u7b2c\u4e00\u9801\u70ba\u8d77\u59cb\u9801 (\u512a\u5148\u986f\u793a\u7d66\u8a2a\u5ba2)\u3002\u53ef\u62d6\u66f3\u9801\u9762\u8207\u7ae0\u7bc0\u4ee5\u91cd\u65b0\u6392\u5e8f\u3002"],"Save congress":["\u5132\u5b58\u5927\u6703"],"Rename page":["\u91cd\u65b0\u547d\u540d\u9801\u9762"],"Delete page?":["\u522a\u9664\u9801\u9762\uff1f"],"Its sections will be moved to the start page. This cannot be undone.":["\u5176\u5340\u6bb5\u5c07\u6703\u79fb\u81f3\u8d77\u59cb\u9801\u3002\u6b64\u64cd\u4f5c\u7121\u6cd5\u5fa9\u539f\u3002"],"Delete section?":["\u522a\u9664\u5340\u6bb5\uff1f"],"This action cannot be undone.":["\u6b64\u64cd\u4f5c\u7121\u6cd5\u5fa9\u539f\u3002"],"OK":["\u78ba\u5b9a"],"No icon":["\u7121\u5716\u793a"],"Remove image":["\u79fb\u9664\u5716\u7247"],"Choose image":["\u9078\u64c7\u5716\u7247"],"Select image":["\u9078\u64c7\u5716\u7247"],"Icon, optional image, card color and a short description shown on the page card.":["\u5716\u793a\u3001\u9078\u586b\u5716\u7247\u3001\u5361\u7247\u984f\u8272\u53ca\u7c21\u77ed\u8aaa\u660e\u6703\u986f\u793a\u65bc\u9801\u9762\u5361\u7247\u4e0a\u3002"],"Icon":["\u5716\u793a"],"Image (optional, overrides icon)":["\u5716\u7247\uff08\u9078\u586b,\u512a\u5148\u65bc\u5716\u793a\uff09"],"Card color":["\u5361\u7247\u984f\u8272"],"Short description (max 160)":["\u7c21\u77ed\u8aaa\u660e\uff08\u6700\u591a 160 \u5b57\uff09"],"Page card settings":["\u9801\u9762\u5361\u7247\u8a2d\u5b9a"],"No pages yet.