{"translation-revision-date":"2026-03-24 18:00+0100","generator":"WP-CLI\/2.12.0","source":"js\/seating_a.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"ko_KR","plural-forms":"nplurals=1; plural=0;"},"%d seats":["%d\uc11d"],"%d seats deleted":["%d\uc11d \uc0ad\uc81c\ub428"],"%d seats processed, %d errors":["%d\uc11d \ucc98\ub9ac\ub428, \uc624\ub958 %d\uac74"],"%d seats updated":["%d\uc11d \uc5c5\ub370\uc774\ud2b8\ub428"],"+ Add Seat":["+ \uc88c\uc11d \ucd94\uac00"],"+ Add Seating Plan":["+ \uc88c\uc11d \ubc30\uce58\ub3c4 \ucd94\uac00"],"-- Action --":["-- \uc791\uc5c5 --"],"Actions":["\uc791\uc5c5"],"Activate":["\ud65c\uc131\ud654"],"Active":["\ud65c\uc131"],"An error occurred. Please try again.":["\uc624\ub958\uac00 \ubc1c\uc0dd\ud588\uc2b5\ub2c8\ub2e4. \ub2e4\uc2dc \uc2dc\ub3c4\ud574 \uc8fc\uc138\uc694."],"Apply":["\uc801\uc6a9"],"Are you sure you want to delete this?":["\uc815\ub9d0 \uc0ad\uc81c\ud558\uc2dc\uaca0\uc2b5\ub2c8\uae4c?"],"Back to Plans":["\uc694\uae08\uc81c \ubaa9\ub85d\uc73c\ub85c"],"Cancel":["\ucde8\uc18c"],"Category":["\uce74\ud14c\uace0\ub9ac"],"Click to view published version":["\uac8c\uc2dc\ub41c \ubc84\uc804 \ubcf4\uae30"],"Click to view\/edit draft":["\ucd08\uc548 \ubcf4\uae30\/\ud3b8\uc9d1"],"Clone":["\ubcf5\uc81c"],"Customers will see a dropdown menu to select their seat. Available seats are shown in a list sorted by identifier. This is ideal for smaller venues or when visual seat selection is not needed.":["\uace0\uac1d\uc740 \uc88c\uc11d\uc744 \uc120\ud0dd\ud560 \uc218 \uc788\ub294 \ub4dc\ub86d\ub2e4\uc6b4 \uba54\ub274\ub97c \ubcf4\uac8c \ub429\ub2c8\ub2e4. \uc0ac\uc6a9 \uac00\ub2a5\ud55c \uc88c\uc11d\uc740 \uc2dd\ubcc4\uc790 \uae30\uc900\uc73c\ub85c \uc815\ub82c\ub41c \ubaa9\ub85d\uc73c\ub85c \ud45c\uc2dc\ub429\ub2c8\ub2e4. \uc18c\uaddc\ubaa8 \ud589\uc0ac\uc7a5\uc774\ub098 \uc2dc\uac01\uc801 \uc88c\uc11d \uc120\ud0dd\uc774 \ud544\uc694\ud558\uc9c0 \uc54a\uc740 \uacbd\uc6b0\uc5d0 \uc801\ud569\ud569\ub2c