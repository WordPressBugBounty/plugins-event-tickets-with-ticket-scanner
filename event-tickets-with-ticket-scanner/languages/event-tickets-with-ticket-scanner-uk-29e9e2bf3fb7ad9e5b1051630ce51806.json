{"translation-revision-date":"2026-03-24 18:00+0100","generator":"WP-CLI\/2.12.0","source":"js\/shop-payment-settings.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"hu_HU","plural-forms":"nplurals=2; plural=(n != 1);"},"Save":["\u0417\u0431\u0435\u0440\u0435\u0433\u0442\u0438"],"Network error.":["\u041f\u043e\u043c\u0438\u043b\u043a\u0430 \u043c\u0435\u0440\u0435\u0436\u0456."],"Online payments":["\u041e\u043d\u043b\u0430\u0439\u043d-\u043f\u043b\u0430\u0442\u0435\u0436\u0456"],"Sell through the shop page with a hosted Stripe checkout \u2014 buyers pay by card and the tickets are sent automatically.":["\u041f\u0440\u043e\u0434\u0430\u0432\u0430\u0439\u0442\u0435 \u0447\u0435\u0440\u0435\u0437 \u0441\u0442\u043e\u0440\u0456\u043d\u043a\u0443 \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u0443 \u0437 \u0445\u043e\u0441\u0442\u0438\u043d\u0433\u043e\u0432\u0438\u043c checkout Stripe \u2014 \u043f\u043e\u043a\u0443\u043f\u0446\u0456 \u043f\u043b\u0430\u0442\u044f\u0442\u044c \u043a\u0430\u0440\u0442\u043a\u043e\u044e, \u0430 \u043a\u0432\u0438\u0442\u043a\u0438 \u043d\u0430\u0434\u0441\u0438\u043b\u0430\u044e\u0442\u044c\u0441\u044f \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u043e."],"Off \u2014 orders are confirmed manually in the Kasse":["\u0412\u0438\u043c\u043a\u043d\u0435\u043d\u043e \u2014 \u0437\u0430\u043c\u043e\u0432\u043b\u0435\u043d\u043d\u044f \u043f\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u0436\u0443\u044e\u0442\u044c\u0441\u044f \u0432\u0440\u0443\u0447\u043d\u0443 \u0432 \u043a\u0430\u0441\u0456"],"Configured":["\u041d\u0430\u043b\u0430\u0448\u0442\u043e\u0432\u0430\u043d\u043e"],"Not configured":["\u041d\u0435 \u043d\u0430\u043b\u0430\u0448\u0442\u043e\u0432\u0430\u043d\u043e"],"Payment provider":["\u041f\u0440\u043e\u0432\u0430\u0439\u0434\u0435\u0440 \u043f\u043b\u0430\u0442\u0435\u0436\u0456\u0432"],"Stripe secret key":["\u0421\u0435\u043a\u0440\u0435\u0442\u043d\u0438\u0439 \u043a\u043b\u044e\u0447 Stripe"],"Leave empty to keep the stored key. A secret key (sk_\u2026) \u2014 never the publishable one.":["\u0417\u0430\u043b\u0438\u0448\u0442\u0435 \u043f\u043e\u0440\u043e\u0436\u043d\u0456\u043c, \u0449\u043e\u0431 \u0437\u0431\u0435\u0440\u0435\u0433\u0442\u0438 \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u0438\u0439 \u043a\u043b\u044e\u0447. \u0421\u0435\u043a\u0440\u0435\u0442\u043d\u0438\u0439 \u043a\u043b\u044e\u0447 (sk_\u2026) \u2014 \u043d\u0456\u043a\u043e\u043b\u0438 \u043d\u0435 \u043f\u0443\u0431\u043b\u0456\u0447\u043d\u0438\u0439."],"Stripe webhook signing secret":["\u0421\u0435\u043a\u0440\u0435\u0442 \u043f\u0456\u0434\u043f\u0438\u0441\u0443 \u0432\u0435\u0431\u0445\u0443\u043a\u0430 Stripe"],"Saving\u2026":["\u0417\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043d\u044f\u2026"],"Saved.":["\u0417\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043e."],"Save failed.":["\u041d\u0435 \u0432\u0434\u0430\u043b\u043e\u0441\u044f \u0437\u0431\u0435\u0440\u0435\u0433\u0442\u0438."],"Webhook endpoint (register in the Stripe dashboard \u2192 Webhooks)":["\u041a\u0456\u043d\u0446\u0435\u0432\u0430 \u0442\u043e\u0447\u043a\u0430 \u0432\u0435\u0431\u0445\u0443\u043a\u0430 (\u0437\u0430\u0440\u0435\u0454\u0441\u0442\u0440\u0443\u0439\u0442\u0435 \u0432 \u043f\u0430\u043d\u0435\u043b\u0456 Stripe \u2192 Webhooks)"],"Events: checkout.session.completed, checkout.session.expired, checkout.session.async_payment_failed":["\u041f\u043e\u0434\u0456\u0457: checkout.session.completed, checkout.session.expired, checkout.session.async_payment_failed"],"Test connection":["\u041f\u0435\u0440\u0435\u0432\u0456\u0440\u0438\u0442\u0438 \u0437'\u0454\u0434\u043d\u0430\u043d\u043d\u044f"],"Checking\u2026":["\u041f\u0435\u0440\u0435\u0432\u0456\u0440\u043a\u0430\u2026"],"Key valid":["\u041a\u043b\u044e\u0447 \u0434\u0456\u0439\u0441\u043d\u0438\u0439"],"Webhook delivery still needs to be confirmed in the Stripe dashboard.":["\u0414\u043e\u0441\u0442\u0430\u0432\u043a\u0443 \u0432\u0435\u0431\u0445\u0443\u043a\u0430 \u0432\u0441\u0435 \u0449\u0435 \u043f\u043e\u0442\u0440\u0456\u0431\u043d\u043e \u043f\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u0438 \u0432 \u043f\u0430\u043d\u0435\u043b\u0456 Stripe."],"Check failed.":["\u041f\u0435\u0440\u0435\u0432\u0456\u0440\u043a\u0430 \u043d\u0435 \u0432\u0434\u0430\u043b\u0430\u0441\u044f."],"The installed free plugin is too old for automatic ticket delivery after payment \u2014 update the free plugin to 3.3.1 or newer.":["\u0412\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0439 \u0431\u0435\u0437\u043a\u043e\u0448\u0442\u043e\u0432\u043d\u0438\u0439 \u043f\u043b\u0430\u0433\u0456\u043d \u0437\u0430\u0441\u0442\u0430\u0440\u0456\u043b\u0438\u0439 \u0434\u043b\u044f \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u043e\u0457 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0438 \u043a\u0432\u0438\u0442\u043a\u0456\u0432 \u043f\u0456\u0441\u043b\u044f \u043e\u043f\u043b\u0430\u0442\u0438 \u2014 \u043e\u043d\u043e\u0432\u0456\u0442\u044c \u0431\u0435\u0437\u043a\u043e\u0448\u0442\u043e\u0432\u043d\u0438\u0439 \u043f\u043b\u0430\u0433\u0456\u043d \u0434\u043e \u0432\u0435\u0440\u0441\u0456\u0457 3.3.1 \u0430\u0431\u043e \u043d\u043e\u0432\u0456\u0448\u043e\u0457."]}}}