{"translation-revision-date":"2026-03-24 18:00+0100","generator":"WP-CLI\/2.12.0","source":"js\/shop-payment-settings.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"hu_HU","plural-forms":"nplurals=2; plural=(n != 1);"},"Save":["\u062d\u0641\u0638"],"Network error.":["\u062e\u0637\u0623 \u0641\u064a \u0627\u0644\u0634\u0628\u0643\u0629."],"Online payments":["\u0627\u0644\u0645\u062f\u0641\u0648\u0639\u0627\u062a \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629"],"Sell through the shop page with a hosted Stripe checkout \u2014 buyers pay by card and the tickets are sent automatically.":["\u0628\u0650\u0639 \u0639\u0628\u0631 \u0635\u0641\u062d\u0629 \u0627\u0644\u0645\u062a\u062c\u0631 \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u062f\u0641\u0639 Stripe \u0627\u0644\u0645\u0633\u062a\u0636\u0627\u0641 \u2014 \u064a\u062f\u0641\u0639 \u0627\u0644\u0645\u0634\u062a\u0631\u0648\u0646 \u0628\u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0648\u062a\u064f\u0631\u0633\u0644 \u0627\u0644\u062a\u0630\u0627\u0643\u0631 \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627."],"Off \u2014 orders are confirmed manually in the Kasse":["\u0645\u064f\u0639\u0637\u064e\u0651\u0644 \u2014 \u064a\u062a\u0645 \u062a\u0623\u0643\u064a\u062f \u0627\u0644\u0637\u0644\u0628\u0627\u062a \u064a\u062f\u0648\u064a\u064b\u0627 \u0641\u064a \u0627\u0644\u0643\u0627\u0634\u064a\u0631"],"Configured":["\u0645\u064f\u0647\u064a\u064e\u0651\u0623"],"Not configured":["\u063a\u064a\u0631 \u0645\u064f\u0647\u064a\u064e\u0651\u0623"],"Payment provider":["\u0645\u0632\u0648\u0651\u062f \u0627\u0644\u062f\u0641\u0639"],"Stripe secret key":["\u0645\u0641\u062a\u0627\u062d Stripe \u0627\u0644\u0633\u0631\u064a"],"Leave empty to keep the stored key. A secret key (sk_\u2026) \u2014 never the publishable one.":["\u0627\u062a\u0631\u0643\u0647 \u0641\u0627\u0631\u063a\u064b\u0627 \u0644\u0644\u0627\u062d\u062a\u0641\u0627\u0638 \u0628\u0627\u0644\u0645\u0641\u062a\u0627\u062d \u0627\u0644\u0645\u062e\u0632\u064e\u0651\u0646. \u0645\u0641\u062a\u0627\u062d \u0633\u0631\u064a (sk_\u2026) \u2014 \u0648\u0644\u064a\u0633 \u0627\u0644\u0645\u0641\u062a\u0627\u062d \u0627\u0644\u0639\u0627\u0645 \u0623\u0628\u062f\u064b\u0627."],"Stripe webhook signing secret":["\u0633\u0631 \u062a\u0648\u0642\u064a\u0639 Webhook \u0627\u0644\u062e\u0627\u0635 \u0628\u0640 Stripe"],"Saving\u2026":["\u062c\u0627\u0631\u064d \u0627\u0644\u062d\u0641\u0638\u2026"],"Saved.":["\u062a\u0645 \u0627\u0644\u062d\u0641\u0638."],"Save failed.":["\u0641\u0634\u0644 \u0627\u0644\u062d\u0641\u0638."],"Webhook endpoint (register in the Stripe dashboard \u2192 Webhooks)":["\u0639\u0646\u0648\u0627\u0646 Webhook (\u0633\u062c\u0651\u0644\u0647 \u0641\u064a \u0644\u0648\u062d\u0629 Stripe \u2190 Webhooks)"],"Events: checkout.session.completed, checkout.session.expired, checkout.session.async_payment_failed":["\u0627\u0644\u0623\u062d\u062f\u0627\u062b: checkout.session.completed\u060c checkout.session.expired\u060c checkout.session.async_payment_failed"],"Test connection":["\u0627\u062e\u062a\u0628\u0627\u0631 \u0627\u0644\u0627\u062a\u0635\u0627\u0644"],"Checking\u2026":["\u062c\u0627\u0631\u064d \u0627\u0644\u062a\u062d\u0642\u0642\u2026"],"Key valid":["\u0627\u0644\u0645\u0641\u062a\u0627\u062d \u0635\u0627\u0644\u062d"],"Webhook delivery still needs to be confirmed in the Stripe dashboard.":["\u0644\u0627 \u064a\u0632\u0627\u0644 \u064a\u062a\u0639\u064a\u064e\u0651\u0646 \u062a\u0623\u0643\u064a\u062f \u062a\u0633\u0644\u064a\u0645 Webhook \u0641\u064a \u0644\u0648\u062d\u0629 Stripe."],"Check failed.":["\u0641\u0634\u0644 \u0627\u0644\u062a\u062d\u0642\u0642."],"The installed free plugin is too old for automatic ticket delivery after payment \u2014 update the free plugin to 3.3.1 or newer.":["\u0627\u0644\u0625\u0636\u0627\u0641\u0629 \u0627\u0644\u0645\u062c\u0627\u0646\u064a\u0629 \u0627\u0644\u0645\u062b\u0628\u064e\u0651\u062a\u0629 \u0642\u062f\u064a\u0645\u0629 \u062c\u062f\u064b\u0627 \u0644\u0644\u062a\u0633\u0644\u064a\u0645 \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a \u0644\u0644\u062a\u0630\u0627\u0643\u0631 \u0628\u0639\u062f \u0627\u0644\u062f\u0641\u0639 \u2014 \u062d\u062f\u0650\u0651\u062b \u0627\u0644\u0625\u0636\u0627\u0641\u0629 \u0627\u0644\u0645\u062c\u0627\u0646\u064a\u0629 \u0625\u0644\u0649 3.3.1 \u0623\u0648 \u0623\u062d\u062f\u062b."]}}}