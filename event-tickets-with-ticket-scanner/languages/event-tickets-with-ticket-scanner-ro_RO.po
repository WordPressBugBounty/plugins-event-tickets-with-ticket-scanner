msgstr ""
"Dacă este activ, butonul de descărcare a fișierului calendar nu va fi afișat "
"pe vizualizarea detaliilor biletului. Va fi afișat doar dacă produsul bilet "
"are o dată de început."

#: sasoEventtickets_Options.php:708
msgid "Text that will be added as the ICS calendar file download label"
msgstr ""
"Text care va fi adăugat ca etichetă de descărcare a fișierului de calendar "
"ICS"

#. translators: %s: default value
#: sasoEventtickets_Options.php:708
msgid "Download calendar file"
msgstr "Descarcă fișierul calendar"

#. translators: %s: default value
#: sasoEventtickets_Options.php:709
