#: sasoEventtickets_Options.php:801
msgid "Logged in user only"
msgstr "Doar utilizatori autentificați"

#: sasoEventtickets_Options.php:802
msgid ""
"Allow only logged in wordpress user to enter a ticket number for validation"
msgstr ""
"Permite doar utilizatorilor WordPress autentificați să introducă un număr de "
"bilet pentru validare"

#: sasoEventtickets_Options.php:802
msgid ""
"If active and the user is not logged in, then the input fields will be "
"disabled"
msgstr ""
"Dacă este activ și utilizatorul nu este autentificat, atunci câmpurile de "
"introducere vor fi dezactivate"

#: sasoEventtickets_Options.php:803
msgid "Your own 'Only for logged in user' message"
msgstr "Mesajul propriu 'Doar pentru utilizatori autentificați'"

