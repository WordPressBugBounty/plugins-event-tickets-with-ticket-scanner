{"translation-revision-date":"2026-03-24 18:00+0100","generator":"WP-CLI\/2.12.0","source":"js\/congress-a.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"hu_HU","plural-forms":"nplurals=2; plural=(n != 1);"},"Title":["\u0936\u0940\u0930\u094d\u0937\u0915"],"Add":["Hozz\u00e1ad\u00e1s"],"Export contacts":["\u0938\u0902\u092a\u0930\u094d\u0915 \u0928\u093f\u0930\u094d\u092f\u093e\u0924 \u0915\u0930\u0947\u0902"],"Portal label":["\u092a\u094b\u0930\u094d\u091f\u0932 \u0932\u0947\u092c\u0932"],"Shown in the wallet and email (e.g. \"Opera evening\", \"Zoo visit\"). Empty = use the global default.":["\u0935\u0949\u0932\u0947\u091f \u0914\u0930 \u0908\u092e\u0947\u0932 \u092e\u0947\u0902 \u0926\u093f\u0916\u093e\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948 (\u091c\u0948\u0938\u0947 \"\u0913\u092a\u0947\u0930\u093e \u0938\u0902\u0927\u093f\", \"\u091a\u093f\u0921\u093c\u093f\u092f\u093e\u0918\u0930 \u092f\u093e\u0924\u094d\u0930\u093e\")\u0964 \u0916\u093e\u0932\u0940 = \u0935\u0948\u0936\u094d\u0935\u093f\u0915 \u0921\u093f\u092b\u093c\u0949\u0932\u094d\u091f \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0947\u0902\u0964"],"Show pages as a card grid on the start screen":["\u092a\u094d\u0930\u093e\u0930\u0902\u092d \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u092a\u0930 \u092a\u0943\u0937\u094d\u0920\u094b\u0902 \u0915\u094b \u0915\u093e\u0930\u094d\u0921 \u0917\u094d\u0930\u093f\u0921 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0926\u093f\u0916\u093e\u090f\u0901"],"Visitors first see a grid of page cards (icon\/image + description) instead of jumping straight into the first page.":["\u0906\u0917\u0902\u0924\u0941\u0915 \u092a\u0939\u0932\u0947 \u092a\u0943\u0937\u094d\u0920 \u0915\u093e\u0930\u094d\u0921 \u0915\u093e \u0917\u094d\u0930\u093f\u0921 \u0926\u0947\u0916\u0924\u0947 \u0939\u0948\u0902 (\u0906\u0907\u0915\u0928\/\u091b\u0935\u093f + \u0935\u093f\u0935\u0930\u0923), \u092c\u091c\u093e\u092f \u0938\u0940\u0927\u0947 \u092a\u0939\u0932\u0947 \u092a\u0943\u0937\u094d\u0920 \u092a\u0930 \u091c\u093e\u0928\u0947 \u0915\u0947\u0964"],"Active \u2014 visible to ticket holders":["\u0938\u0915\u094d\u0930\u093f\u092f \u2014 \u091f\u093f\u0915\u091f \u0927\u093e\u0930\u0915\u094b\u0902 \u0915\u094b \u0926\u093f\u0916\u093e\u0908 \u0926\u0947 \u0930\u0939\u093e \u0939\u0948"],"Turn off to hide this congress everywhere (page + wallet) without unassigning it \u2014 e.g. to publish the info only later.":["\u092c\u093f\u0928\u093e \u0905\u0938\u093e\u0907\u0928 \u0939\u091f\u093e\u090f \u0907\u0938\u0947 \u0939\u0930 \u091c\u0917\u0939 (\u092a\u0943\u0937\u094d\u0920 + \u0935\u0949\u0932\u0947\u091f) \u091b\u093f\u092a\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092c\u0902\u0926 \u0915\u0930\u0947\u0902 \u2014 \u091c\u0948\u0938\u0947 \u092c\u093e\u0926 \u092e\u0947\u0902 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u092a\u094d\u0930\u0915\u093e\u0936\u093f\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f\u0964"],"No icon":["\u0915\u094b\u0908 \u0906\u0907\u0915\u0928 \u0928\u0939\u0940\u0902"],"Remove image":["\u091b\u0935\u093f \u0939\u091f\u093e\u090f\u0901"],"Icon, optional image, card color and a short description shown on the page card.":["\u092a\u0943\u0937\u094d\u0920 \u0915\u093e\u0930\u094d\u0921 \u092a\u0930 \u0926\u093f\u0916\u093e\u092f\u093e \u0917\u092f\u093e \u0906\u0907\u0915\u0928, \u0935\u0948\u0915\u0932\u094d\u092a\u093f\u0915 \u091b\u0935\u093f, \u0915\u093e\u0930\u094d\u0921 \u0930\u0902\u0917 \u0914\u0930 \u0938\u0902\u0915\u094d\u0937\u093f\u092a\u094d\u0924 \u0935\u093f\u0935\u0930\u0923\u0964"],"Icon":["\u0906\u0907\u0915\u0928"],"Image (optional, overrides icon)":["\u091b\u0935\u093f (\u0935\u0948\u0915\u0932\u094d\u092a\u093f\u0915, \u0906\u0907\u0915\u0928 \u0915\u094b \u0913\u0935\u0930\u0930\u093e\u0907\u0921 \u0915\u0930\u0924\u093e \u0939\u0948)"],"Card color":["\u0915\u093e\u0930\u094d\u0921 \u0930\u0902\u0917"],"Short description (max 160)":["\u0938\u0902\u0915\u094d\u0937\u093f\u092a\u094d\u0924 \u0935\u093f\u0935\u0930\u0923 (\u0905\u0927\u093f\u0915\u0924\u092e 160)"],"Page card settings":["\u092a\u0943\u0937\u094d\u0920 \u0915\u093e\u0930\u094d\u0921 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938"],"Settings":["\u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938"],"Speakers":["\u0935\u0915\u094d\u0924\u093e"],"Insert variable\u2026":["\u0935\u0947\u0930\u093f\u090f\u092c\u0932 \u0938\u092e\u094d\u092e\u093f\u0932\u093f\u0924 \u0915\u0930\u0947\u0902\u2026"],"Short bio (max 500 characters)":["\u0938\u0902\u0915\u094d\u0937\u093f\u092a\u094d\u0924 \u092a\u0930\u093f\u091a\u092f (\u0905\u0927\u093f\u0915\u0924\u092e 500 \u0935\u0930\u094d\u0923)"],"Add speaker":["\u0935\u0915\u094d\u0924\u093e \u091c\u094b\u0921\u093c\u0947\u0902"],"Each speaker has an image, name, title and a short bio (max 500 characters). One speaker is shown in full; several are shown as boxes. Drag to reorder.":["\u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u0935\u0915\u094d\u0924\u093e \u0915\u0940 \u091b\u0935\u093f, \u0928\u093e\u092e, \u0909\u092a\u093e\u0927\u093f \u0914\u0930 \u0938\u0902\u0915\u094d\u0937\u093f\u092a\u094d\u0924 \u092a\u0930\u093f\u091a\u092f (\u0905\u0927\u093f\u0915\u0924\u092e 500 \u0935\u0930\u094d\u0923) \u0939\u094b\u0924\u093e \u0939\u0948\u0964 \u090f\u0915 \u0935\u0915\u094d\u0924\u093e \u092a\u0942\u0930\u094d\u0923 \u0930\u0942\u092a \u0938\u0947 \u0926\u093f\u0916\u093e\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948; \u0915\u0908 \u0935\u0915\u094d\u0924\u093e \u092c\u0915\u094d\u0938\u094b\u0902 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0926\u093f\u0916\u0924\u0947 \u0939\u0948\u0902\u0964 \u092a\u0941\u0928\u0930\u094d\u0935\u094d\u092f\u0935\u0938\u094d\u0925\u093f\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0916\u0940\u0902\u091a\u0947\u0902\u0964"]}}}