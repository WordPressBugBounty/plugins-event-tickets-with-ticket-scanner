915\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e\u0964"],"URLs":["URLs"],"Add section":["\u0905\u0928\u0941\u092d\u093e\u0917 \u091c\u094b\u0921\u093c\u0947\u0902"],"Gallery":["\u0917\u0948\u0932\u0930\u0940"],"Delete":["T\u00f6rl\u00e9s"],"Add days and time slots. Each slot has time, title, speaker and room.":["\u0926\u093f\u0928 \u0914\u0930 \u0938\u092e\u092f \u0938\u094d\u0932\u0949\u091f \u091c\u094b\u0921\u093c\u0947\u0902\u0964 \u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u0938\u094d\u0932\u0949\u091f \u092e\u0947\u0902 \u0938\u092e\u092f, \u0936\u0940\u0930\u094d\u0937\u0915, \u0935\u0915\u094d\u0924\u093e \u0914\u0930 \u0915\u0915\u094d\u0937 \u0939\u094b\u0924\u093e \u0939\u0948\u0964"],"Create":["\u092c\u0928\u093e\u090f\u0901"],"Edit event app":[""],"Shown in the wallet and email (e.g. \"Opera evening\", \"Zoo visit\"). Empty = use the global default.":["\u0935\u0949\u0932\u0947\u091f \u0914\u0930 \u0908\u092e\u0947\u0932 \u092e\u0947\u0902 \u0926\u093f\u0916\u093e\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948 (\u091c\u0948\u0938\u0947 \"\u0913\u092a\u0947\u0930\u093e \u0938\u0902\u0927\u093f\", \"\u091a\u093f\u0921\u093c\u093f\u092f\u093e\u0918\u0930 \u092f\u093e\u0924\u094d\u0930\u093e\")\u0964 \u0916\u093e\u0932\u0940 = \u0935\u0948\u0936\u094d\u0935\u093f\u0915 \u0921\u093f\u092b\u093c\u0949\u0932\u094d\u091f \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0947\u0902\u0964"],"Active":["\u0938\u0915\u094d\u0930\u093f\u092f"],"Save the congress first to add pages and sections.":["\u092a\u0943\u0937\u094d\u0920 \u0914\u0930 \u0905\u0928\u0941\u092d\u093e\u0917 \u091c\u094b\u0921\u093c\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092a\u0939\u0932\u0947 \u0915\u093e\u0902\u0917\u094d\u0930\u0947\u0938 \u0915\u094b \u0938\u0939\u0947\u091c\u0947\u0902\u0964"],"Add":["Hozz\u00e1ad\u00e1s"],"Expired":["\u0938\u092e\u092f \u0938\u092e\u093e\u092a\u094d\u0924 \u0939\u094b \u091a\u0941\u0915\u093e"],"Turn off to hide this congress everywhere (page + wallet) without unassigning it \u2014 e.g. to publish the info only later.":["\u092c\u093f\u0928\u093e \u0905\u0938\u093e\u0907\u0928 \u0939\u091f\u093e\u090f \u0907\u0938\u0947 \u0939\u0930 \u091c\u0917\u0939 (\u092a\u0943\u0937\u094d\u0920 + \u0935\u0949\u0932\u0947\u091f) \u091b\u093f\u092a\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092c\u0902\u0926 \u0915\u0930\u0947\u0902 \u2014 \u091c\u0948\u0938\u0947 \u092c\u093e\u0926 \u092e\u0947\u0902 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u092a\u094d\u0930\u0915\u093e\u0936\u093f\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f\u0964"],"Slug for new edition:":["\u0928\u090f \u0938\u0902\u0938\u094d\u0915\u0930\u0923 \u0915\u0947 \u0932\u093f\u090f \u0938\u094d\u0932\u0917:"],"Add speaker":["\u0935\u0915\u094d\u0924\u093e \u091c\u094b\u0921\u093c\u0947\u0902"],"Title and slug are required.":["\u0936\u0940\u0930\u094d\u0937\u0915 \u0914\u0930 \u0938\u094d\u0932\u0917 \u0906\u0935\u0936\u094d\u092f\u0915 \u0939\u0948\u0902\u0964"],"Program":["\u0915\u093e\u0930\u094d\u092f\u0915\u094d\u0930\u092e"],"Updated":["\u0905\u092a\u0921\u0947\u091f \u0915\u093f\u092f\u093e \u0917\u092f\u093e"],"Products":["\u0909\u0924\u094d\u092a\u093e\u0926"],"Speaker":["\u0935\u0915\u094d\u0924\u093e"],"Pick files from the media library. Label is shown to visitors. Drag to reorder.":["\u092e\u0940\u0921\u093f\u092f\u093e \u0932\u093e\u0907\u092c\u094d\u0930\u0947\u0930\u0940 \u0938\u0947 \u092b\u093c\u093e\u0907\u0932\u0947\u0902 \u091a\u0941\u0928\u0947\u0902\u0964 \u0932\u0947\u092c\u0932 \u0906\u0917\u0902\u0924\u0941\u0915\u094b\u0902 \u0915\u094b \u0926\u093f\u0916\u093e\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u0915\u094d\u0930\u092e \u092c\u0926\u0932\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0916\u0940\u0902\u091a\u0947\u0902\u0964"],"Unique identifier for this congress. Visitors open it through their personal ticket link, not the slug.":["\u0907\u0938 \u0915\u093e\u0902\u0917\u094d\u0930\u0947\u0938 \u0915\u0947 \u0932\u093f\u090f \u0935\u093f\u0936\u093f\u0937\u094d\u091f \u092a\u0939\u091a\u093e\u0928\u0915\u0930\u094d\u0924\u093e\u0964 \u0906\u0917\u0902\u0924\u0941\u0915 \u0907\u0938\u0947 \u0905\u092a\u0928\u0947 \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u091f\u093f\u0915\u091f \u0932\u093f\u0902\u0915 \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u0916\u094b\u0932\u0924\u0947 \u0939\u0948\u0902, \u0938\u094d\u0932\u0917 \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u0928\u0939\u0940\u0902\u0964"],"Choose":["\u091a\u0941\u0928\u0947\u0902"],"Save congress":["\u0915\u093e\u0902\u0917\u094d\u0930\u0947\u0938 \u0938\u0939\u0947\u091c\u0947\u0902"],"Delete page?":["\u092a\u0943\u0937\u094d\u0920 \u0939\u091f\u093e\u090f\u0901?"],"Save":["\u0938\u0939\u0947\u091c\u0947\u0902"],"Assign via the WooCommerce product settings.":["WooCommerce \u0909\u0924\u094d\u092a\u093e\u0926 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u0905\u0938\u093e\u0907\u0928 \u0915\u0930\u0947\u0902\u0964"],"Internal":["\u0906\u0902\u0924\u0930\u093f\u0915"],"Insert variable\u2026":["\u0935\u0947\u0930\u093f\u090f\u092c\u0932 \u0938\u092e\u094d\u092e\u093f\u0932\u093f\u0924 \u0915\u0930\u0947\u0902\u2026"],"Files":["\u092b\u093c\u093e\u0907\u0932\u0947\u0902"],"Title":["\u0936\u0940\u0930\u094d\u0937\u0915"],"Cancel":["M\u00e9gse"],"Choose image":["\u091b\u0935\u093f \u091a\u0941\u0928\u0947\u0902"],"Image":["\u091b\u0935\u093f"],"Manual hard cutoff. Leave empty for unlimited access.":["\u092e\u0948\u0928\u094d\u092f\u0941\u0905\u0932 \u0939\u093e\u0930\u094d\u0921 \u0915\u091f\u0911\u092b\u0964 \u0905\u0938\u0940\u092e\u093f\u0924 \u092a\u0939\u0941\u0901\u091a \u0915\u0947 \u0932\u093f\u090f \u0916\u093e\u0932\u0940 \u091b\u094b\u0921\u093c \u0926\u0947\u0902\u0964"],"Caption (optional)":["\u0915\u0948\u092a\u094d\u0936\u0928 (\u0935\u0948\u0915\u0932\u094d\u092a\u093f\u0915)"],"No pages yet. Add a page to start.":["\u0905\u092d\u0940 \u0924\u0915 \u0915\u094b\u0908 \u092a\u0943\u0937\u094d\u0920 \u0928\u0939\u0940\u0902\u0964 \u0936\u0941\u0930\u0942 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u092a\u0943\u0937\u094d\u0920 \u091c\u094b\u0921\u093c\u0947\u0902\u0964"],"Portal label":["\u092a\u094b\u0930\u094d\u091f\u0932 \u0932\u0947\u092c\u0932"],"assigned (manage on product level)":["\u0905\u0938\u093e\u0907\u0928 \u0915\u093f\u092f\u093e \u0917\u092f\u093e (\u0909\u0924\u094d\u092a\u093e\u0926 \u0938\u094d\u0924\u0930 \u092a\u0930 \u092a\u094d\u0930\u092c\u0902\u0927\u093f\u0924 \u0915\u0930\u0947\u0902)"],"Video":["\u0935\u0940\u0921\u093f\u092f\u094b"],"Icon":["\u0906\u0907\u0915\u0928"],"Drag to reorder":["\u092a\u0941\u0928\u0903 \u0915\u094d\u0930\u092e\u092c\u0926\u094d\u0927 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0916\u0940\u0902\u091a\u0947\u0902"],"Room":["\u0915\u0915\u094d\u0937"],"Add URL":["URL \u091c\u094b\u0921\u093c\u0947\u0902"],"Type":["\u092a\u094d\u0930\u0915\u093e\u0930"],"Access expires (optional)":["\u092a\u0939\u0941\u0901\u091a \u0938\u092e\u093e\u092a\u094d\u0924\u093f (\u0935\u0948\u0915\u0932\u094d\u092a\u093f\u0915)"],"Active \u2014 visible to ticket holders":["\u0938\u0915\u094d\u0930\u093f\u092f \u2014 \u091f\u093f\u0915\u091f \u0927\u093e\u0930\u0915\u094b\u0902 \u0915\u094b \u0926\u093f\u0916\u093e\u0908 \u0926\u0947 \u0930\u0939\u093e \u0939\u0948"],"Add page":["\u092a\u0943\u0937\u094d\u0920 \u091c\u094b\u0921\u093c\u0947\u0902"],"This action cannot be undone. All sections will be deleted as well.":["\u092f\u0939 \u0915\u094d\u0930\u093f\u092f\u093e \u092a\u0942\u0930\u094d\u0935\u0935\u0924 \u0928\u0939\u0940\u0902 \u0915\u0940 \u091c\u093e \u0938\u0915\u0924\u0940\u0964 \u0938\u092d\u0940 \u0905\u0928\u0941\u092d\u093e\u0917 \u092d\u0940 \u0939\u091f\u093e \u0926\u093f\u090f \u091c\u093e\u090f\u0901\u0917\u0947\u0964"],"Icon, optional image, card color and a short description shown on the page card.":["\u092a\u0943\u0937\u094d\u0920 \u0915\u093e\u0930\u094d\u0921 \u092a\u0930 \u0926\u093f\u0916\u093e\u092f\u093e \u0917\u092f\u093e \u0906\u0907\u0915\u0928, \u0935\u0948\u0915\u0932\u094d\u092a\u093f\u0915 \u091b\u0935\u093f, \u0915\u093e\u0930\u094d\u0921 \u0930\u0902\u0917 \u0914\u0930 \u0938\u0902\u0915\u094d\u0937\u093f\u092a\u094d\u0924 \u0935\u093f\u0935\u0930\u0923\u0964"],"Video file":["\u0935\u0940\u0921\u093f\u092f\u094b \u092b\u093c\u093e\u0907\u0932"],"Title for new edition (leave empty to auto-generate):":["\u0928\u090f \u0938\u0902\u0938\u094d\u0915\u0930\u0923 \u0915\u0947 \u0932\u093f\u090f \u0936\u0940\u0930\u094d\u0937\u0915 (\u0938\u094d\u0935\u091a\u093e\u0932\u093f\u0924 \u092c\u0928\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0916\u093e\u0932\u0940 \u091b\u094b\u0921\u093c\u0947\u0902):"],"Paste a YouTube, Vimeo or other supported link. It is embedded automatically.":["YouTube, Vimeo \u092f\u093e \u0905\u0928\u094d\u092f \u0938\u092e\u0930\u094d\u0925\u093f\u0924 \u0932\u093f\u0902\u0915 \u092a\u0947\u0938\u094d\u091f \u0915\u0930\u0947\u0902\u0964 \u092f\u0939 \u0938\u094d\u0935\u091a\u093e\u0932\u093f\u0924 \u0930\u0942\u092a \u0938\u0947 \u090f\u092e\u094d\u092c\u0947\u0921 \u0915\u093f\u092f\u093e \u091c\u093e\u090f\u0917\u093e\u0964"],"start page":["\u092a\u094d\u0930\u093e\u0930\u0902\u092d \u092a\u0943\u0937\u094d\u0920"],"Name":["N\u00e9v"],"Select video":["\u0935\u0940\u0921\u093f\u092f\u094b \u091a\u0941\u0928\u0947\u0902"],"Remove slot":["\u0938\u094d\u0932\u0949\u091f \u0939\u091f\u093e\u090f\u0901"],"Add image":["\u091b\u0935\u093f \u091c\u094b\u0921\u093c\u0947\u0902"],"Remove image":["\u091b\u0935\u093f \u0939\u091f\u093e\u090f\u0901"],"Display size":["\u092a\u094d\u0930\u0926\u0930\u094d\u0936\u0928 \u0906\u0915\u093e\u0930"],"Short description (max 160)":["\u0938\u0902\u0915\u094d\u0937\u093f\u092a\u094d\u0924 \u0935\u093f\u0935\u0930\u0923 (\u0905\u0927\u093f\u0915\u0924\u092e 160)"],"Choose which page this section belongs to. Change it to move the section to another page.":["\u091a\u0941\u0928\u0947\u0902 \u0915\u093f \u092f\u0939 \u0905\u0928\u0941\u092d\u093e\u0917 \u0915\u093f\u0938 \u092a\u0943\u0937\u094d\u0920 \u0938\u0947 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0939\u0948\u0964 \u0905\u0928\u0941\u092d\u093e\u0917 \u0915\u094b \u0915\u093f\u0938\u0940 \u0905\u0928\u094d\u092f \u092a\u0943\u0937\u094d\u0920 \u092a\u0930 \u0932\u0947 \u091c\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0907\u0938\u0947 \u092c\u0926\u0932\u0947\u0902\u0964"],"Open full size when clicked":["\u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0928\u0947 \u092a\u0930 \u092a\u0942\u0930\u094d\u0923 \u0906\u0915\u093e\u0930 \u0916\u094b\u0932\u0947\u0902"],"Content":["\u0938\u093e\u092e\u0917\u094d\u0930\u0940"],"Video URL":["\u0935\u0940\u0921\u093f\u092f\u094b URL"],"Uploaded video file":["\u0905\u092a\u0932\u094b\u0921 \u0915\u0940 \u0917\u0908 \u0935\u0940\u0921\u093f\u092f\u094b \u092b\u093c\u093e\u0907\u0932"],"Select file":["\u092b\u093c\u093e\u0907\u0932 \u091a\u0941\u0928\u0947\u0902"],"New event app":[""],"Full width":["\u092a\u0942\u0930\u094d\u0923 \u091a\u094c\u0921\u093c\u093e\u0908"],"Card color":["\u0915\u093e\u0930\u094d\u0921 \u0930\u0902\u0917"],"Add slot":["\u0938\u094d\u0932\u0949\u091f \u091c\u094b\u0921\u093c\u0947\u0902"],"Settings":["\u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938"],"Rename page":["\u092a\u0943\u0937\u094d\u0920 \u0915\u093e \u0928\u093e\u092e \u092c\u0926\u0932\u0947\u0902"],"Short bio (max 500 characters)":["\u0938\u0902\u0915\u094d\u0937\u093f\u092a\u094d\u0924 \u092a\u0930\u093f\u091a\u092f (\u0905\u0927\u093f\u0915\u0924\u092e 500 \u0935\u0930\u094d\u0923)"],"No icon":["\u0915\u094b\u0908 \u0906\u0907\u0915\u0928 \u0928\u0939\u0940\u0902"],"An event app is the companion page your visitors open with their ticket: programme and schedule, speaker or artist info, venue maps, downloads, media and support pages \u2014 everything structured in one place. Perfect for a congress with multiple sessions, but just as much for a single event where ticket holders need extra info, a FAQ or contact options. Visitors do not need an account or an extra app: their ticket ID is the key, access opens with the ticket and can expire with it. Assign an event app to a product in the WooCommerce product settings \u2014 one app can serve multiple products, so an event series shares one app.":[""],"Source":["\u0938\u094d\u0930\u094b\u0924"],"Export contacts":["\u0938\u0902\u092a\u0930\u094d\u0915 \u0928\u093f\u0930\u094d\u092f\u093e\u0924 \u0915\u0930\u0947\u0902"],"Edit":["Szerkeszt\u00e9s"],"Page":["\u092a\u0943\u0937\u094d\u0920"],"Updated:":["\u0905\u092a\u0921\u0947\u091f \u0915\u093f\u092f\u093e \u0917\u092f\u093e:"],"Time":["\u0938\u092e\u092f"],"Open inline":["\u0907\u0928\u0932\u093e\u0907\u0928 \u0916\u094b\u0932\u0947\u0902"],"Images":["\u091b\u0935\u093f\u092f\u093e\u0901"],"Add file":["\u092b\u093c\u093e\u0907\u0932 \u091c\u094b\u0921\u093c\u0947\u0902"]}}}