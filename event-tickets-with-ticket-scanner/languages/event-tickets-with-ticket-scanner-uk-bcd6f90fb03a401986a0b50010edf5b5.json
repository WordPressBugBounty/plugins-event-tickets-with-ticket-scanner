{"translation-revision-date":"2026-03-24 18:00+0100","generator":"WP-CLI\/2.12.0","source":"js\/congress-a.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"hu_HU","plural-forms":"nplurals=2; plural=(n != 1);"},"Error":["Hiba"],"Active":["\u0410\u043a\u0442\u0438\u0432\u043d\u0438\u0439"],"Status":["\u00c1llapot"],"Expired":["\u0422\u0435\u0440\u043c\u0456\u043d \u043c\u0438\u043d\u0443\u0432"],"New congress":["\u041d\u043e\u0432\u0438\u0439 \u043a\u043e\u043d\u0433\u0440\u0435\u0441"],"Title":["\u041d\u0430\u0437\u0432\u0430"],"Products":["\u0422\u043e\u0432\u0430\u0440\u0438"],"Updated":["\u041e\u043d\u043e\u0432\u043b\u0435\u043d\u043e"],"Export contacts":["\u0415\u043a\u0441\u043f\u043e\u0440\u0442 \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u0456\u0432"],"Edit":["Szerkeszt\u00e9s"],"New edition":["\u041d\u043e\u0432\u0435 \u0432\u0438\u0434\u0430\u043d\u043d\u044f"],"Delete":["T\u00f6rl\u00e9s"],"Congresses let you attach structured information (programme, downloads, media, texts) to an event. Ticket holders can access the congress page using their ticket ID. Assign a congress to a product in the WooCommerce product settings \u2014 one congress can be shared across multiple products.":["\u041a\u043e\u043d\u0433\u0440\u0435\u0441\u0438 \u0434\u043e\u0437\u0432\u043e\u043b\u044f\u044e\u0442\u044c \u043f\u0440\u0438\u043a\u0440\u0456\u043f\u043b\u044e\u0432\u0430\u0442\u0438 \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u043e\u0432\u0430\u043d\u0443 \u0456\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0456\u044e (\u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0443, \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u043d\u044f, \u043c\u0435\u0434\u0456\u0430, \u0442\u0435\u043a\u0441\u0442\u0438) \u0434\u043e \u043f\u043e\u0434\u0456\u0457. \u0412\u043b\u0430\u0441\u043d\u0438\u043a\u0438 \u043a\u0432\u0438\u0442\u043a\u0456\u0432 \u043c\u043e\u0436\u0443\u0442\u044c \u043e\u0442\u0440\u0438\u043c\u0430\u0442\u0438 \u0434\u043e\u0441\u0442\u0443\u043f \u0434\u043e \u0441\u0442\u043e\u0440\u0456\u043d\u043a\u0438 \u043a\u043e\u043d\u0433\u0440\u0435\u0441\u0443 \u0437\u0430 ID \u043a\u0432\u0438\u0442\u043a\u0430. \u041f\u0440\u0438\u0437\u043d\u0430\u0447\u0442\u0435 \u043a\u043e\u043d\u0433\u0440\u0435\u0441 \u0442\u043e\u0432\u0430\u0440\u0443 \u0432 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f\u0445 WooCommerce \u2014 \u043e\u0434\u0438\u043d \u043a\u043e\u043d\u0433\u0440\u0435\u0441 \u043c\u043e\u0436\u0435 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0432\u0430\u0442\u0438\u0441\u044f \u0434\u043b\u044f \u043a\u0456\u043b\u044c\u043a\u043e\u0445 \u0442\u043e\u0432\u0430\u0440\u0456\u0432."],"Delete this congress?":["\u0412\u0438\u0434\u0430\u043b\u0438\u0442\u0438 \u0446\u0435\u0439 \u043a\u043e\u043d\u0433\u0440\u0435\u0441?"],"This action cannot be undone. All sections will be deleted as well.":["\u0426\u044e \u0434\u0456\u044e \u043d\u0435 \u043c\u043e\u0436\u043d\u0430 \u0441\u043a\u0430\u0441\u0443\u0432\u0430\u0442\u0438. \u0423\u0441\u0456 \u0440\u043e\u0437\u0434\u0456\u043b\u0438 \u0442\u0430\u043a\u043e\u0436 \u0431\u0443\u0434\u0443\u0442\u044c \u0432\u0438\u0434\u0430\u043b\u0435\u043d\u0456."],"Current title:":["\u041f\u043e\u0442\u043e\u0447\u043d\u0430 \u043d\u0430\u0437\u0432\u0430:"],"Current slug:":["\u041f\u043e\u0442\u043e\u0447\u043d\u0438\u0439 slug:"],"Slug for new edition:":["Slug \u0434\u043b\u044f \u043d\u043e\u0432\u043e\u0433\u043e \u0432\u0438\u0434\u0430\u043d\u043d\u044f:"],"Title for new edition (leave empty to auto-generate):":["\u041d\u0430\u0437\u0432\u0430 \u043d\u043e\u0432\u043e\u0433\u043e \u0432\u0438\u0434\u0430\u043d\u043d\u044f (\u0437\u0430\u043b\u0438\u0448\u0442\u0435 \u043f\u043e\u0440\u043e\u0436\u043d\u0456\u043c \u0434\u043b\u044f \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u043e\u0457 \u0433\u0435\u043d\u0435\u0440\u0430\u0446\u0456\u0457):"],"Create":["\u0421\u0442\u0432\u043e\u0440\u0438\u0442\u0438"],"Cancel":["M\u00e9gse"],"Edit congress":["\u0420\u0435\u0434\u0430\u0433\u0443\u0432\u0430\u0442\u0438 \u043a\u043e\u043d\u0433\u0440\u0435\u0441"],"Details":["\u0414\u0435\u0442\u0430\u043b\u0456"],"Unique identifier for this congress. Visitors open it through their personal ticket link, not the slug.":["\u0423\u043d\u0456\u043a\u0430\u043b\u044c\u043d\u0438\u0439 \u0456\u0434\u0435\u043d\u0442\u0438\u0444\u0456\u043a\u0430\u0442\u043e\u0440 \u0434\u043b\u044f \u0446\u044c\u043e\u0433\u043e \u043a\u043e\u043d\u0433\u0440\u0435\u0441\u0443. \u0412\u0456\u0434\u0432\u0456\u0434\u0443\u0432\u0430\u0447\u0456 \u0432\u0456\u0434\u043a\u0440\u0438\u0432\u0430\u044e\u0442\u044c \u0439\u043e\u0433\u043e \u0447\u0435\u0440\u0435\u0437 \u0441\u0432\u043e\u0454 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u043b\u044c\u043d\u0435 \u043f\u043e\u0441\u0438\u043b\u0430\u043d\u043d\u044f \u043d\u0430 \u043a\u0432\u0438\u0442\u043e\u043a, \u0430 \u043d\u0435 \u0447\u0435\u0440\u0435\u0437 slug."],"Portal label":["\u041c\u0456\u0442\u043a\u0430 \u043f\u043e\u0440\u0442\u0430\u043b\u0443"],"Shown in the wallet and email (e.g. \"Opera evening\", \"Zoo visit\"). Empty = use the global default.":["\u0412\u0456\u0434\u043e\u0431\u0440\u0430\u0436\u0430\u0454\u0442\u044c\u0441\u044f \u0432 \u0433\u0430\u043c\u0430\u043d\u0446\u0456 \u0442\u0430 email (\u043d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u00ab\u0412\u0435\u0447\u0456\u0440 \u0432 \u043e\u043f\u0435\u0440\u0456\u00bb, \u00ab\u0412\u0456\u0437\u0438\u0442 \u0434\u043e \u0437\u043e\u043e\u043f\u0430\u0440\u043a\u0443\u00bb). \u041f\u043e\u0440\u043e\u0436\u043d\u044c\u043e = \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0432\u0430\u0442\u0438 \u0433\u043b\u043e\u0431\u0430\u043b\u044c\u043d\u0435 \u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0437\u0430 \u0437\u0430\u043c\u043e\u0432\u0447\u0443\u0432\u0430\u043d\u043d\u044f\u043c."],"Show pages as a card grid on the start screen":["\u041f\u043e\u043a\u0430\u0437\u0443\u0432\u0430\u0442\u0438 \u0441\u0442\u043e\u0440\u0456\u043d\u043a\u0438 \u0443 \u0432\u0438\u0433\u043b\u044f\u0434\u0456 \u0441\u0456\u0442\u043a\u0438 \u043a\u0430\u0440\u0442\u043e\u043a \u043d\u0430 \u0441\u0442\u0430\u0440\u0442\u043e\u0432\u043e\u043c\u0443 \u0435\u043a\u0440\u0430\u043d\u0456"],"Visitors first see a grid of page cards (icon\/image + description) instead of jumping straight into the first page.":["\u0412\u0456\u0434\u0432\u0456\u0434\u0443\u0432\u0430\u0447\u0456 \u0441\u043f\u043e\u0447\u0430\u0442\u043a\u0443 \u0431\u0430\u0447\u0430\u0442\u044c \u0441\u0456\u0442\u043a\u0443 \u043a\u0430\u0440\u0442\u043e\u043a \u0441\u0442\u043e\u0440\u0456\u043d\u043e\u043a (\u0456\u043a\u043e\u043d\u043a\u0430\/\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u043d\u044f + \u043e\u043f\u0438\u0441), \u0430 \u043d\u0435 \u043e\u0434\u0440\u0430\u0437\u0443 \u043f\u0435\u0440\u0435\u0445\u043e\u0434\u044f\u0442\u044c \u0434\u043e \u043f\u0435\u0440\u0448\u043e\u0457 \u0441\u0442\u043e\u0440\u0456\u043d\u043a\u0438."],"Access expires (optional)":["\u0422\u0435\u0440\u043c\u0456\u043d \u0434\u0456\u0457 \u0434\u043e\u0441\u0442\u0443\u043f\u0443 (\u043d\u0435\u043e\u0431\u043e\u0432'\u044f\u0437\u043a\u043e\u0432\u043e)"],"Manual hard cutoff. Leave empty for unlimited access.":["\u0420\u0443\u0447\u043d\u0435 \u0436\u043e\u0440\u0441\u0442\u043a\u0435 \u043e\u0431\u043c\u0435\u0436\u0435\u043d\u043d\u044f. \u0417\u0430\u043b\u0438\u0448\u0442\u0435 \u043f\u043e\u0440\u043e\u0436\u043d\u0456\u043c \u0434\u043b\u044f \u043d\u0435\u043e\u0431\u043c\u0435\u0436\u0435\u043d\u043e\u0433\u043e \u0434\u043e\u0441\u0442\u0443\u043f\u0443."],"Active \u2014 visible to ticket holders":["\u0410\u043a\u0442\u0438\u0432\u043d\u043e \u2014 \u0432\u0438\u0434\u0438\u043c\u0435 \u0434\u043b\u044f \u0432\u043b\u0430\u0441\u043d\u0438\u043a\u0456\u0432 \u043a\u0432\u0438\u0442\u043a\u0456\u0432"],"Turn off to hide this congress everywhere (page + wallet) without unassigning it \u2014 e.g. to publish the info only later.":["\u0412\u0438\u043c\u043a\u043d\u0456\u0442\u044c, \u0449\u043e\u0431 \u0441\u0445\u043e\u0432\u0430\u0442\u0438 \u0446\u0435\u0439 \u043a\u043e\u043d\u0433\u0440\u0435\u0441 \u0441\u043a\u0440\u0456\u0437\u044c (\u0441\u0442\u043e\u0440\u0456\u043d\u043a\u0430 + \u0433\u0430\u043c\u0430\u043d\u0435\u0446\u044c) \u0431\u0435\u0437 \u0441\u043a\u0430\u0441\u0443\u0432\u0430\u043d\u043d\u044f \u043f\u0440\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u2014 \u043d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0449\u043e\u0431 \u043e\u043f\u0443\u0431\u043b\u0456\u043a\u0443\u0432\u0430\u0442\u0438 \u0456\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0456\u044e \u043f\u0456\u0437\u043d\u0456\u0448\u0435."],"assigned (manage on product level)":["\u043f\u0440\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u043e (\u043a\u0435\u0440\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u0430 \u0440\u0456\u0432\u043d\u0456 \u0442\u043e\u0432\u0430\u0440\u0443)"],"Assign via the WooCommerce product settings.":["\u041f\u0440\u0438\u0437\u043d\u0430\u0447\u0442\u0435 \u0447\u0435\u0440\u0435\u0437 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u0442\u043e\u0432\u0430\u0440\u0443 WooCommerce."],"Save the congress first to add pages and sections.":["\u0421\u043f\u043e\u0447\u0430\u0442\u043a\u0443 \u0437\u0431\u0435\u0440\u0435\u0436\u0456\u0442\u044c \u043a\u043e\u043d\u0433\u0440\u0435\u0441, \u0449\u043e\u0431 \u0434\u043e\u0434\u0430\u0442\u0438 \u0441\u0442\u043e\u0440\u0456\u043d\u043a\u0438 \u0442\u0430 \u0440\u043e\u0437\u0434\u0456\u043b\u0438."],"Pages":["\u0421\u0442\u043e\u0440\u0456\u043d\u043a\u0438"],"Add page":["\u0414\u043e\u0434\u0430\u0442\u0438 \u0441\u0442\u043e\u0440\u0456\u043d\u043a\u0443"],"The first page is the start page (shown first to visitors). Drag pages and sections to reorder.":["\u041f\u0435\u0440\u0448\u0430 \u0441\u0442\u043e\u0440\u0456\u043d\u043a\u0430 \u2014 \u0441\u0442\u0430\u0440\u0442\u043e\u0432\u0430 (\u043f\u043e\u043a\u0430\u0437\u0443\u0454\u0442\u044c\u0441\u044f \u0432\u0456\u0434\u0432\u0456\u0434\u0443\u0432\u0430\u0447\u0430\u043c \u043f\u0435\u0440\u0448\u043e\u044e). \u041f\u0435\u0440\u0435\u0442\u044f\u0433\u0443\u0439\u0442\u0435 \u0441\u0442\u043e\u0440\u0456\u043d\u043a\u0438 \u0442\u0430 \u0440\u043e\u0437\u0434\u0456\u043b\u0438 \u0434\u043b\u044f \u0437\u043c\u0456\u043d\u0438 \u043f\u043e\u0440\u044f\u0434\u043a\u0443."],"Save congress":["\u0417\u0431\u0435\u0440\u0435\u0433\u0442\u0438 \u043a\u043e\u043d\u0433\u0440\u0435\u0441"],"Rename page":["\u041f\u0435\u0440\u0435\u0439\u043c\u0435\u043d\u0443\u0432\u0430\u0442\u0438 \u0441\u0442\u043e\u0440\u0456\u043d\u043a\u0443"],"Delete page?":["\u0412\u0438\u0434\u0430\u043b\u0438\u0442\u0438 \u0441\u0442\u043e\u0440\u0456\u043d\u043a\u0443?"],"Its sections will be moved to the start page. This cannot be undone.":["\u0407\u0457 \u0441\u0435\u043a\u0446\u0456\u0457 \u0431\u0443\u0434\u0435 \u043f\u0435\u0440\u0435\u043c\u0456\u0449\u0435\u043d\u043e \u043d\u0430 \u0433\u043e\u043b\u043e\u0432\u043d\u0443 \u0441\u0442\u043e\u0440\u0456\u043d\u043a\u0443. \u0426\u044e \u0434\u0456\u044e \u043d\u0435 \u043c\u043e\u0436\u043d\u0430 \u0441\u043a\u0430\u0441\u0443\u0432\u0430\u0442\u0438."],"Delete section?":["\u0412\u0438\u0434\u0430\u043b\u0438\u0442\u0438 \u0441\u0435\u043a\u0446\u0456\u044e?"],"This action cannot be undone.":["\u0426\u044e \u0434\u0456\u044e \u043d\u0435 \u043c\u043e\u0436\u043d\u0430 \u0441\u043a\u0430\u0441\u0443\u0432\u0430\u0442\u0438."],"OK":["OK"],"No icon":["\u0411\u0435\u0437 \u0456\u043a\u043e\u043d\u043a\u0438"],"Remove image":["\u0412\u0438\u0434\u0430\u043b\u0438\u0442\u0438 \u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u043d\u044f"],"Choose image":["\u0412\u0438\u0431\u0440\u0430\u0442\u0438 \u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u043d\u044f"],"Select image":["\u0412\u0438\u0431\u0440\u0430\u0442\u0438 \u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u043d\u044f"],"Icon, optional image, card color and a short description shown on the page card.":["\u0406\u043a\u043e\u043d\u043a\u0430, \u043d\u0435\u043e\u0431\u043e\u0432'\u044f\u0437\u043a\u043e\u0432\u0435 \u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u043d\u044f, \u043a\u043e\u043b\u0456\u0440 \u043a\u0430\u0440\u0442\u043a\u0438 \u0442\u0430 \u043a\u043e\u0440\u043e\u0442\u043a\u0438\u0439 \u043e\u043f\u0438\u0441, \u0449\u043e \u0432\u0456\u0434\u043e\u0431\u0440\u0430\u0436\u0430\u044e\u0442\u044c\u0441\u044f \u043d\u0430 \u043a\u0430\u0440\u0442\u0446\u0456 \u0441\u0442\u043e\u0440\u0456\u043d\u043a\u0438."],"Icon":["\u0406\u043a\u043e\u043d\u043a\u0430"],"Image (optional, overrides icon)":["\u0417\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u043d\u044f (\u043d\u0435\u043e\u0431\u043e\u0432'\u044f\u0437\u043a\u043e\u0432\u043e, \u043f\u0435\u0440\u0435\u0432\u0438\u0437\u043d\u0430\u0447\u0430\u0454 \u0456\u043a\u043e\u043d\u043a\u0443)"],"Card color":["\u041a\u043e\u043b\u0456\u0440 \u043a\u0430\u0440\u0442\u043a\u0438"],"Short description (max 160)":["\u041a\u043e\u0440\u043e\u0442\u043a\u0438\u0439 \u043e\u043f\u0438\u0441 (\u043c\u0430\u043a\u0441. 160)"],"Page card settings":["\u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u043a\u0430\u0440\u0442\u043a\u0438 \u0441\u0442\u043e\u0440\u0456\u043d\u043a\u0438"],"No pages yet. Add a page to start.":["\u0421\u0442\u043e\u0440\u0456\u043d\u043e\u043a \u0449\u0435 \u043d\u0435\u043c\u0430\u0454. \u0414\u043e\u0434\u0430\u0439\u0442\u0435 \u0441\u0442\u043e\u0440\u0456\u043d\u043a\u0443, \u0449\u043e\u0431 \u043f\u043e\u0447\u0430\u0442\u0438."],"Drag to reorder pages":["\u041f\u0435\u0440\u0435\u0442\u044f\u0433\u043d\u0456\u0442\u044c, \u0449\u043e\u0431 \u0437\u043c\u0456\u043d\u0438\u0442\u0438 \u043f\u043e\u0440\u044f\u0434\u043e\u043a \u0441\u0442\u043e\u0440\u0456\u043d\u043e\u043a"],"