{"translation-revision-date":"2026-03-24 18:00+0100","generator":"WP-CLI\/2.12.0","source":"js\/congress-a.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"hu_HU","plural-forms":"nplurals=2; plural=(n != 1);"},"Title":["\u041d\u0430\u0437\u0432\u0430"],"Add":["Hozz\u00e1ad\u00e1s"],"Export contacts":["\u0415\u043a\u0441\u043f\u043e\u0440\u0442 \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u0456\u0432"],"Portal label":["\u041c\u0456\u0442\u043a\u0430 \u043f\u043e\u0440\u0442\u0430\u043b\u0443"],"Shown in the wallet and email (e.g. \"Opera evening\", \"Zoo visit\"). Empty = use the global default.":["\u0412\u0456\u0434\u043e\u0431\u0440\u0430\u0436\u0430\u0454\u0442\u044c\u0441\u044f \u0432 \u0433\u0430\u043c\u0430\u043d\u0446\u0456 \u0442\u0430 email (\u043d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u00ab\u0412\u0435\u0447\u0456\u0440 \u0432 \u043e\u043f\u0435\u0440\u0456\u00bb, \u00ab\u0412\u0456\u0437\u0438\u0442 \u0434\u043e \u0437\u043e\u043e\u043f\u0430\u0440\u043a\u0443\u00bb). \u041f\u043e\u0440\u043e\u0436\u043d\u044c\u043e = \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0432\u0430\u0442\u0438 \u0433\u043b\u043e\u0431\u0430\u043b\u044c\u043d\u0435 \u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0437\u0430 \u0437\u0430\u043c\u043e\u0432\u0447\u0443\u0432\u0430\u043d\u043d\u044f\u043c."],"Show pages as a card grid on the start screen":["\u041f\u043e\u043a\u0430\u0437\u0443\u0432\u0430\u0442\u0438 \u0441\u0442\u043e\u0440\u0456\u043d\u043a\u0438 \u0443 \u0432\u0438\u0433\u043b\u044f\u0434\u0456 \u0441\u0456\u0442\u043a\u0438 \u043a\u0430\u0440\u0442\u043e\u043a \u043d\u0430 \u0441\u0442\u0430\u0440\u0442\u043e\u0432\u043e\u043c\u0443 \u0435\u043a\u0440\u0430\u043d\u0456"],"Visitors first see a grid of page cards (icon\/image + description) instead of jumping straight into the first page.":["\u0412\u0456\u0434\u0432\u0456\u0434\u0443\u0432\u0430\u0447\u0456 \u0441\u043f\u043e\u0447\u0430\u0442\u043a\u0443 \u0431\u0430\u0447\u0430\u0442\u044c \u0441\u0456\u0442\u043a\u0443 \u043a\u0430\u0440\u0442\u043e\u043a \u0441\u0442\u043e\u0440\u0456\u043d\u043e\u043a (\u0456\u043a\u043e\u043d\u043a\u0430\/\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u043d\u044f + \u043e\u043f\u0438\u0441), \u0430 \u043d\u0435 \u043e\u0434\u0440\u0430\u0437\u0443 \u043f\u0435\u0440\u0435\u0445\u043e\u0434\u044f\u0442\u044c \u0434\u043e \u043f\u0435\u0440\u0448\u043e\u0457 \u0441\u0442\u043e\u0440\u0456\u043d\u043a\u0438."],"Active \u2014 visible to ticket holders":["\u0410\u043a\u0442\u0438\u0432\u043d\u043e \u2014 \u0432\u0438\u0434\u0438\u043c\u0435 \u0434\u043b\u044f \u0432\u043b\u0430\u0441\u043d\u0438\u043a\u0456\u0432 \u043a\u0432\u0438\u0442\u043a\u0456\u0432"],"Turn off to hide this congress everywhere (page + wallet) without unassigning it \u2014 e.g. to publish the info only later.":["\u0412\u0438\u043c\u043a\u043d\u0456\u0442\u044c, \u0449\u043e\u0431 \u0441\u0445\u043e\u0432\u0430\u0442\u0438 \u0446\u0435\u0439 \u043a\u043e\u043d\u0433\u0440\u0435\u0441 \u0441\u043a\u0440\u0456\u0437\u044c (\u0441\u0442\u043e\u0440\u0456\u043d\u043a\u0430 + \u0433\u0430\u043c\u0430\u043d\u0435\u0446\u044c) \u0431\u0435\u0437 \u0441\u043a\u0430\u0441\u0443\u0432\u0430\u043d\u043d\u044f \u043f\u0440\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u2014 \u043d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0449\u043e\u0431 \u043e\u043f\u0443\u0431\u043b\u0456\u043a\u0443\u0432\u0430\u0442\u0438 \u0456\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0456\u044e \u043f\u0456\u0437\u043d\u0456\u0448\u0435."],"No icon":["\u0411\u0435\u0437 \u0456\u043a\u043e\u043d\u043a\u0438"],"Remove image":["\u0412\u0438\u0434\u0430\u043b\u0438\u0442\u0438 \u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u043d\u044f"],"Icon, optional image, card color and a short description shown on the page card.":["\u0406\u043a\u043e\u043d\u043a\u0430, \u043d\u0435\u043e\u0431\u043e\u0432'\u044f\u0437\u043a\u043e\u0432\u0435 \u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u043d\u044f, \u043a\u043e\u043b\u0456\u0440 \u043a\u0430\u0440\u0442\u043a\u0438 \u0442\u0430 \u043a\u043e\u0440\u043e\u0442\u043a\u0438\u0439 \u043e\u043f\u0438\u0441, \u0449\u043e \u0432\u0456\u0434\u043e\u0431\u0440\u0430\u0436\u0430\u044e\u0442\u044c\u0441\u044f \u043d\u0430 \u043a\u0430\u0440\u0442\u0446\u0456 \u0441\u0442\u043e\u0440\u0456\u043d\u043a\u0438."],"Icon":["\u0406\u043a\u043e\u043d\u043a\u0430"],"Image (optional, overrides icon)":["\u0417\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u043d\u044f (\u043d\u0435\u043e\u0431\u043e\u0432'\u044f\u0437\u043a\u043e\u0432\u043e, \u043f\u0435\u0440\u0435\u0432\u0438\u0437\u043d\u0430\u0447\u0430\u0454 \u0456\u043a\u043e\u043d\u043a\u0443)"],"Card color":["\u041a\u043e\u043b\u0456\u0440 \u043a\u0430\u0440\u0442\u043a\u0438"],"Short description (max 160)":["\u041a\u043e\u0440\u043e\u0442\u043a\u0438\u0439 \u043e\u043f\u0438\u0441 (\u043c\u0430\u043a\u0441. 160)"],"Page card settings":["\u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u043a\u0430\u0440\u0442\u043a\u0438 \u0441\u0442\u043e\u0440\u0456\u043d\u043a\u0438"],"Settings":["\u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f"],"Speakers":["\u0421\u043f\u0456\u043a\u0435\u0440\u0438"],"Insert variable\u2026":["\u0412\u0441\u0442\u0430\u0432\u0438\u0442\u0438 \u0437\u043c\u0456\u043d\u043d\u0443\u2026"],"Short bio (max 500 characters)":["\u041a\u043e\u0440\u043e\u0442\u043a\u0430 \u0431\u0456\u043e\u0433\u0440\u0430\u0444\u0456\u044f (\u043c\u0430\u043a\u0441. 500 \u0441\u0438\u043c\u0432\u043e\u043b\u0456\u0432)"],"Add speaker":["\u0414\u043e\u0434\u0430\u0442\u0438 \u0441\u043f\u0456\u043a\u0435\u0440\u0430"],"Each speaker has an image, name, title and a short bio (max 500 characters). One speaker is shown in full; several are shown as boxes. Drag to reorder.":["\u041a\u043e\u0436\u0435\u043d \u0441\u043f\u0456\u043a\u0435\u0440 \u043c\u0430\u0454 \u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u043d\u044f, \u0456\u043c'\u044f, \u043f\u043e\u0441\u0430\u0434\u0443 \u0442\u0430 \u043a\u043e\u0440\u043e\u0442\u043a\u0443 \u0431\u0456\u043e\u0433\u0440\u0430\u0444\u0456\u044e (\u043c\u0430\u043a\u0441. 500 \u0441\u0438\u043c\u0432\u043e\u043b\u0456\u0432). \u041e\u0434\u0438\u043d \u0441\u043f\u0456\u043a\u0435\u0440 \u0432\u0456\u0434\u043e\u0431\u0440\u0430\u0436\u0430\u0454\u0442\u044c\u0441\u044f \u043f\u043e\u0432\u043d\u0456\u0441\u0442\u044e; \u043a\u0456\u043b\u044c\u043a\u0430 \u2014 \u0443 \u0432\u0438\u0433\u043b\u044f\u0434\u0456 \u0431\u043b\u043e\u043a\u0456\u0432. \u041f\u0435\u0440\u0435\u0442\u044f\u0433\u0443\u0439\u0442\u0435 \u0434\u043b\u044f \u0437\u043c\u0456\u043d\u0438 \u043f\u043e\u0440\u044f\u0434\u043a\u0443."]}}}