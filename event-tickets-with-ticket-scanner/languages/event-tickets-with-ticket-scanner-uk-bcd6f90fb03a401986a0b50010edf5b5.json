u0437\u043e\u043e\u043f\u0430\u0440\u043a\u0443\u00bb). \u041f\u043e\u0440\u043e\u0436\u043d\u044c\u043e = \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0432\u0430\u0442\u0438 \u0433\u043b\u043e\u0431\u0430\u043b\u044c\u043d\u0435 \u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0437\u0430 \u0437\u0430\u043c\u043e\u0432\u0447\u0443\u0432\u0430\u043d\u043d\u044f\u043c."],"Active":["\u0410\u043a\u0442\u0438\u0432\u043d\u0438\u0439"],"Save the congress first to add pages and sections.":["\u0421\u043f\u043e\u0447\u0430\u0442\u043a\u0443 \u0437\u0431\u0435\u0440\u0435\u0436\u0456\u0442\u044c \u043a\u043e\u043d\u0433\u0440\u0435\u0441, \u0449\u043e\u0431 \u0434\u043e\u0434\u0430\u0442\u0438 \u0441\u0442\u043e\u0440\u0456\u043d\u043a\u0438 \u0442\u0430 \u0440\u043e\u0437\u0434\u0456\u043b\u0438."],"Add":["Hozz\u00e1ad\u00e1s"],"Expired":["\u0422\u0435\u0440\u043c\u0456\u043d \u043c\u0438\u043d\u0443\u0432"],"Turn off to hide this congress everywhere (page + wallet) without unassigning it \u2014 e.g. to publish the info only later.":["\u0412\u0438\u043c\u043a\u043d\u0456\u0442\u044c, \u0449\u043e\u0431 \u0441\u0445\u043e\u0432\u0430\u0442\u0438 \u0446\u0435\u0439 \u043a\u043e\u043d\u0433\u0440\u0435\u0441 \u0441\u043a\u0440\u0456\u0437\u044c (\u0441\u0442\u043e\u0440\u0456\u043d\u043a\u0430 + \u0433\u0430\u043c\u0430\u043d\u0435\u0446\u044c) \u0431\u0435\u0437 \u0441\u043a\u0430\u0441\u0443\u0432\u0430\u043d\u043d\u044f \u043f\u0440\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u2014 \u043d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0449\u043e\u0431 \u043e\u043f\u0443\u0431\u043b\u0456\u043a\u0443\u0432\u0430\u0442\u0438 \u0456\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0456\u044e \u043f\u0456\u0437\u043d\u0456\u0448\u0435."],"Slug for new edition:":["Slug \u0434\u043b\u044f \u043d\u043e\u0432\u043e\u0433\u043e \u0432\u0438\u0434\u0430\u043d\u043d\u044f:"],"Add speaker":["\u0414\u043e\u0434\u0430\u0442\u0438 \u0441\u043f\u0456\u043a\