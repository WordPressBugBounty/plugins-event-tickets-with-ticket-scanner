2\u043d\u0456 \u0442\u043e\u0432\u0430\u0440\u0443)"],"Video":["\u0412\u0456\u0434\u0435\u043e"],"Icon":["\u0406\u043a\u043e\u043d\u043a\u0430"],"Drag to reorder":["\u041f\u0435\u0440\u0435\u0442\u044f\u0433\u043d\u0456\u0442\u044c, \u0449\u043e\u0431 \u0437\u043c\u0456\u043d\u0438\u0442\u0438 \u043f\u043e\u0440\u044f\u0434\u043e\u043a"],"Room":["\u0417\u0430\u043b"],"Add URL":["\u0414\u043e\u0434\u0430\u0442\u0438 URL"],"Type":["\u0422\u0438\u043f"],"Access expires (optional)":["\u0422\u0435\u0440\u043c\u0456\u043d \u0434\u0456\u0457 \u0434\u043e\u0441\u0442\u0443\u043f\u0443 (\u043d\u0435\u043e\u0431\u043e\u0432'\u044f\u0437\u043a\u043e\u0432\u043e)"],"Active \u2014 visible to ticket holders":["\u0410\u043a\u0442\u0438\u0432\u043d\u043e \u2014 \u0432\u0438\u0434\u0438\u043c\u0435 \u0434\u043b\u044f \u0432\u043b\u0430\u0441\u043d\u0438\u043a\u0456\u0432 \u043a\u0432\u0438\u0442\u043a\u0456\u0432"],"Add page":["\u0414\u043e\u0434\u0430\u0442\u0438 \u0441\u0442\u043e\u0440\u0456\u043d\u043a\u0443"],"This action cannot be undone. All sections will be deleted as well.":["\u0426\u044e \u0434\u0456\u044e \u043d\u0435 \u043c\u043e\u0436\u043d\u0430 \u0441\u043a\u0430\u0441\u0443\u0432\u0430\u0442\u0438. \u0423\u0441\u0456 \u0440\u043e\u0437\u0434\u0456\u043b\u0438 \u0442\u0430\u043a\u043e\u0436 \u0431\u0443\u0434\u0443\u0442\u044c \u0432\u0438\u0434\u0430\u043b\u0435\u043d\u0456."],"Icon, optional image, card color and a short description shown on the page card.":["\u0406\u043a\u043e\u043d\u043a\u0430, \u043d\u0435\u043e\u0431\u043e\u0432'\u044f\u0437\u043a\u043e\u0432\u0435 \u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u043d\u044f, \u043a\u043e\u043b\u0456\u0440 \u043a\u0430\u0440\u0442\u043a\u0438 \u0442\u0430 \u043a\u043e\u0440\u043e\u0442\u043a\u0438\u0439 \u043e\u043f\u0438\u0441, \u0449\u043e \u0432\u0456\u0434\u043e\u0431\u0440\u0430\u0436\u0430\u044e\u0442\u044c\u0441\u044f \u043d\u0430 \u043a\u0430\u0440\u0442\u0446\u0456 \u0441\u0442\u043e\u0440\u0456\u043d\u043a\u0438."],"Video file":["\u0412\u0456\u0434\u0435\u043e\u0444\u0430\u0439\u043b"],"Title for new edition (leave empty to auto-generate):":["\u041d\u0430\u0437\u0432\u0430 \u043d\u043e\u0432\u043e\u0433\u043e \u0432\u0438\u0434\u0430\u043d\u043d\u044f (\u0437\u0430\u043b\u0438\u0448\u0442\u0435 \u043f\u043e\u0440\u043e\u0436\u043d\u0456\u043c \u0434\u043b\u044f \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u043e\u0457 \u0433\u0435\u043d\u0435\u0440\u0430\u0446\u0456\u0457):"],"Paste a YouTube, Vimeo or other supported link. It is embedded automatically.":["\u0412\u0441\u0442\u0430\u0432\u0442\u0435 \u043f\u043e\u0441\u0438\u043b\u0430\u043d\u043d\u044f YouTube, Vimeo \u0430\u0431\u043e \u0456\u043d\u0448\u0435 \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u0432\u0430\u043d\u0435 \u043f\u043e\u0441\u0438\u043b\u0430\u043d\u043d\u044f. \u0412\u043e\u043d\u043e \u0432\u0431\u0443\u0434\u043e\u0432\u0443\u0454\u0442\u044c\u0441\u044f \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u043e."],"start page":["\u0441\u0442\u0430\u0440\u0442\u043e\u0432\u0430 \u0441\u0442\u043e\u0440\u0456\u043d\u043a\u0430"],"Name":["N\u00e9v"],"Select video":["\u0412\u0438\u0431\u0440\u0430\u0442\u0438 \u0432\u0456\u0434\u0435\u043e"],"Remove slot":["\u0412\u0438\u0434\u0430\u043b\u0438\u0442\u0438 \u0441\u043b\u043e\u0442"],"Add image":["\u0414\u043e\u0434\u0430\u0442\u0438 \u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u043d\u044f"],"Remove image":["\u0412\u0438\u0434\u0430\u043b\u0438\u0442\u0438 \u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u043d\u044f"],"Display size":["\u0420\u043e\u0437\u043c\u0456\u0440 \u0432\u0456\u0434\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u043d\u044f"],"Short description (max 160)":["\u041a\u043e\u0440\u043e\u0442\u043a\u0438\u0439 \u043e\u043f\u0438\u0441 (\u043c\u0430\u043a\u0441. 160)"],"Choose which page this section belongs to. Change it to move the section to another page.":["\u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u0441\u0442\u043e\u0440\u0456\u043d\u043a\u0443, \u0434\u043e \u044f\u043a\u043e\u0457 \u043d\u0430\u043b\u0435\u0436\u0438\u0442\u044c \u0446\u044f \u0441\u0435\u043a\u0446\u0456\u044f. \u0417\u043c\u0456\u043d\u0456\u0442\u044c \u0457\u0457, \u0449\u043e\u0431 \u043f\u0435\u0440\u0435\u043c\u0456\u0441\u0442\u0438\u0442\u0438 \u0441\u0435\u043a\u0446\u0456\u044e \u043d\u0430 \u0456\u043d\u0448\u0443 \u0441\u0442\u043e\u0440\u0456\u043d\u043a\u0443."],"Open full size when clicked":["\u0412\u0456\u0434\u043a\u0440\u0438\u0432\u0430\u0442\u0438 \u043f\u043e\u0432\u043d\u0438\u0439 \u0440\u043e\u0437\u043c\u0456\u0440 \u043f\u0440\u0438 \u043d\u0430\u0442\u0438\u0441\u043a\u0430\u043d\u043d\u0456"],"Content":["\u0412\u043c\u0456\u0441\u0442"],"Video URL":["URL-\u0430\u0434\u0440\u0435\u0441\u0430 \u0432\u0456\u0434\u0435\u043e"],"Uploaded video file":["\u0417\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u0438\u0439 \u0432\u0456\u0434\u0435\u043e\u0444\u0430\u0439\u043b"],"Select file":["\u0412\u0438\u0431\u0440\u0430\u0442\u0438 \u0444\u0430\u0439\u043b"],"New event app":[""],"Full width":["\u041d\u0430 \u043f\u043e\u0432\u043d\u0443 \u0448\u0438\u0440\u0438\u043d\u0443"],"Card color":["\u041a\u043e\u043b\u0456\u0440 \u043a\u0430\u0440\u0442\u043a\u0438"],"Add slot":["\u0414\u043e\u0434\u0430\u0442\u0438 \u0441\u043b\u043e\u0442"],"Settings":["\u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f"],"Rename page":["\u041f\u0435\u0440\u0435\u0439\u043c\u0435\u043d\u0443\u0432\u0430\u0442\u0438 \u0441\u0442\u043e\u0440\u0456\u043d\u043a\u0443"],"Short bio (max 500 characters)":["\u041a\u043e\u0440\u043e\u0442\u043a\u0430 \u0431\u0456\u043e\u0433\u0440\u0430\u0444\u0456\u044f (\u043c\u0430\u043a\u0441. 500 \u0441\u0438\u043c\u0432\u043e\u043b\u0456\u0432)"],"No icon":["\u0411\u0435\u0437 \u0456\u043a\u043e\u043d\u043a\u0438"],"An event app is the companion page your visitors open with their ticket: programme and schedule, speaker or artist info, venue maps, downloads, media and support pages \u2014 everything structured in one place. Perfect for a congress with multiple sessions, but just as much for a single event where ticket holders need extra info, a FAQ or contact options. Visitors do not need an account or an extra app: their ticket ID is the key, access opens with the ticket and can expire with it. Assign an event app to a product in the WooCommerce product settings \u2014 one app can serve multiple products, so an event series shares one app.":[""],"Source":["\u0414\u0436\u0435\u0440\u0435\u043b\u043e"],"Export contacts":["\u0415\u043a\u0441\u043f\u043e\u0440\u0442 \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u0456\u0432"],"Edit":["Szerkeszt\u00e9s"],"Page":["\u0421\u0442\u043e\u0440\u0456\u043d\u043a\u0430"],"Updated:":["\u041e\u043d\u043e\u0432\u043b\u0435\u043d\u043e:"],"Time":["\u0427\u0430\u0441"],"Open inline":["\u0412\u0456\u0434\u043a\u0440\u0438\u0432\u0430\u0442\u0438 \u0432\u0431\u0443\u0434\u043e\u0432\u0430\u043d\u043e"],"Images":["\u0417\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u043d\u044f"],"Add file":["\u0414\u043e\u0434\u0430\u0442\u0438 \u0444\u0430\u0439\u043b"]}}}