{"translation-revision-date":"2026-03-24 18:00+0100","generator":"WP-CLI\/2.12.0","source":"js\/shop-payment-settings.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"hu_HU","plural-forms":"nplurals=2; plural=(n != 1);"},"Save":["\u0391\u03c0\u03bf\u03b8\u03ae\u03ba\u03b5\u03c5\u03c3\u03b7"],"Network error.":["\u03a3\u03c6\u03ac\u03bb\u03bc\u03b1 \u03b4\u03b9\u03ba\u03c4\u03cd\u03bf\u03c5."],"Online payments":["\u0397\u03bb\u03b5\u03ba\u03c4\u03c1\u03bf\u03bd\u03b9\u03ba\u03ad\u03c2 \u03c0\u03bb\u03b7\u03c1\u03c9\u03bc\u03ad\u03c2"],"Sell through the shop page with a hosted Stripe checkout \u2014 buyers pay by card and the tickets are sent automatically.":["\u03a0\u03bf\u03c5\u03bb\u03ae\u03c3\u03c4\u03b5 \u03bc\u03ad\u03c3\u03c9 \u03c4\u03b7\u03c2 \u03c3\u03b5\u03bb\u03af\u03b4\u03b1\u03c2 \u03ba\u03b1\u03c4\u03b1\u03c3\u03c4\u03ae\u03bc\u03b1\u03c4\u03bf\u03c2 \u03bc\u03b5 \u03c6\u03b9\u03bb\u03bf\u03be\u03b5\u03bd\u03bf\u03cd\u03bc\u03b5\u03bd\u03bf Stripe checkout \u2014 \u03bf\u03b9 \u03b1\u03b3\u03bf\u03c1\u03b1\u03c3\u03c4\u03ad\u03c2 \u03c0\u03bb\u03b7\u03c1\u03ce\u03bd\u03bf\u03c5\u03bd \u03bc\u03b5 \u03ba\u03ac\u03c1\u03c4\u03b1 \u03ba\u03b1\u03b9 \u03c4\u03b1 \u03b5\u03b9\u03c3\u03b9\u03c4\u03ae\u03c1\u03b9\u03b1 \u03b1\u03c0\u03bf\u03c3\u03c4\u03ad\u03bb\u03bb\u03bf\u03bd\u03c4\u03b1\u03b9 \u03b1\u03c5\u03c4\u03cc\u03bc\u03b1\u03c4\u03b1."],"Off \u2014 orders are confirmed manually in the Kasse":["\u0391\u03bd\u03b5\u03bd\u03b5\u03c1\u03b3\u03cc \u2014 \u03bf\u03b9 \u03c0\u03b1\u03c1\u03b1\u03b3\u03b3\u03b5\u03bb\u03af\u03b5\u03c2 \u03b5\u03c0\u03b9\u03b2\u03b5\u03b2\u03b1\u03b9\u03ce\u03bd\u03bf\u03bd\u03c4\u03b1\u03b9 \u03c7\u03b5\u03b9\u03c1\u03bf\u03ba\u03af\u03bd\u03b7\u03c4\u03b1 \u03c3\u03c4\u03bf \u03c4\u03b1\u03bc\u03b5\u03af\u03bf"],"Configured":["\u03a1\u03c5\u03b8\u03bc\u03af\u03c3\u03c4\u03b7\u03ba\u03b5"],"Not configured":["\u0394\u03b5\u03bd \u03ad\u03c7\u03b5\u03b9 \u03c1\u03c5\u03b8\u03bc\u03b9\u03c3\u03c4\u03b5\u03af"],"Payment provider":["\u03a0\u03ac\u03c1\u03bf\u03c7\u03bf\u03c2 \u03c0\u03bb\u03b7\u03c1\u03c9\u03bc\u03ce\u03bd"],"Stripe secret key":["\u039c\u03c5\u03c3\u03c4\u03b9\u03ba\u03cc \u03ba\u03bb\u03b5\u03b9\u03b4\u03af Stripe"],"Leave empty to keep the stored key. A secret key (sk_\u2026) \u2014 never the publishable one.":["\u0391\u03c6\u03ae\u03c3\u03c4\u03b5 \u03ba\u03b5\u03bd\u03cc \u03b3\u03b9\u03b1 \u03bd\u03b1 \u03b4\u03b9\u03b1\u03c4\u03b7\u03c1\u03b7\u03b8\u03b5\u03af \u03c4\u03bf \u03b1\u03c0\u03bf\u03b8\u03b7\u03ba\u03b5\u03c5\u03bc\u03ad\u03bd\u03bf \u03ba\u03bb\u03b5\u03b9\u03b4\u03af. \u039c\u03c5\u03c3\u03c4\u03b9\u03ba\u03cc \u03ba\u03bb\u03b5\u03b9\u03b4\u03af (sk_\u2026) \u2014 \u03c0\u03bf\u03c4\u03ad \u03c4\u03bf \u03b4\u03b7\u03bc\u03cc\u03c3\u03b9\u03bf."],"Stripe webhook signing secret":["\u039c\u03c5\u03c3\u03c4\u03b9\u03ba\u03cc \u03c5\u03c0\u03bf\u03b3\u03c1\u03b1\u03c6\u03ae\u03c2 webhook \u03c4\u03bf\u03c5 Stripe"],"Saving\u2026":["\u0391\u03c0\u03bf\u03b8\u03ae\u03ba\u03b5\u03c5\u03c3\u03b7\u2026"],"Saved.":["\u0391\u03c0\u03bf\u03b8\u03b7\u03ba\u03b5\u03cd\u03c4\u03b7\u03ba\u03b5."],"Save failed.":["\u0397 \u03b1\u03c0\u03bf\u03b8\u03ae\u03ba\u03b5\u03c5\u03c3\u03b7 \u03b1\u03c0\u03ad\u03c4\u03c5\u03c7\u03b5."],"Webhook endpoint (register in the Stripe dashboard \u2192 Webhooks)":["\u03a4\u03b5\u03bb\u03b9\u03ba\u03cc \u03c3\u03b7\u03bc\u03b5\u03af\u03bf webhook (\u03ba\u03b1\u03c4\u03b1\u03c7\u03c9\u03c1\u03af\u03c3\u03c4\u03b5 \u03c4\u03bf \u03c3\u03c4\u03bf Stripe \u2192 Webhooks)"],"Events: checkout.session.completed, checkout.session.expired, checkout.session.async_payment_failed":["\u03a3\u03c5\u03bc\u03b2\u03ac\u03bd\u03c4\u03b1: checkout.session.completed, checkout.session.expired, checkout.session.async_payment_failed"],"Test connection":["\u0394\u03bf\u03ba\u03b9\u03bc\u03ae \u03c3\u03cd\u03bd\u03b4\u03b5\u03c3\u03b7\u03c2"],"Checking\u2026":["\u0388\u03bb\u03b5\u03b3\u03c7\u03bf\u03c2\u2026"],"Key valid":["\u03a4\u03bf \u03ba\u03bb\u03b5\u03b9\u03b4\u03af \u03b5\u03af\u03bd\u03b1\u03b9 \u03ad\u03b3\u03ba\u03c5\u03c1\u03bf"],"Webhook delivery still needs to be confirmed in the Stripe dashboard.":["\u0397 \u03c0\u03b1\u03c1\u03ac\u03b4\u03bf\u03c3\u03b7 \u03c4\u03bf\u03c5 webhook \u03c0\u03c1\u03ad\u03c0\u03b5\u03b9 \u03b1\u03ba\u03cc\u03bc\u03b1 \u03bd\u03b1 \u03b5\u03c0\u03b9\u03b2\u03b5\u03b2\u03b1\u03b9\u03c9\u03b8\u03b5\u03af \u03c3\u03c4\u03bf Stripe."],"Check failed.":["\u039f \u03ad\u03bb\u03b5\u03b3\u03c7\u03bf\u03c2 \u03b1\u03c0\u03ad\u03c4\u03c5\u03c7\u03b5."],"The installed free plugin is too old for automatic ticket delivery after payment \u2014 update the free plugin to 3.3.1 or newer.":["\u03a4\u03bf \u03b5\u03b3\u03ba\u03b1\u03c4\u03b5\u03c3\u03c4\u03b7\u03bc\u03ad\u03bd\u03bf \u03b4\u03c9\u03c1\u03b5\u03ac\u03bd \u03c0\u03c1\u03cc\u03c3\u03b8\u03b5\u03c4\u03bf \u03b5\u03af\u03bd\u03b1\u03b9 \u03c0\u03bf\u03bb\u03cd \u03c0\u03b1\u03bb\u03b9\u03cc \u03b3\u03b9\u03b1 \u03c4\u03b7\u03bd \u03b1\u03c5\u03c4\u03cc\u03bc\u03b1\u03c4\u03b7 \u03c0\u03b1\u03c1\u03ac\u03b4\u03bf\u03c3\u03b7 \u03b5\u03b9\u03c3\u03b9\u03c4\u03b7\u03c1\u03af\u03c9\u03bd \u03bc\u03b5\u03c4\u03ac \u03c4\u03b7\u03bd \u03c0\u03bb\u03b7\u03c1\u03c9\u03bc\u03ae \u2014 \u03b5\u03bd\u03b7\u03bc\u03b5\u03c1\u03ce\u03c3\u03c4\u03b5 \u03c4\u03bf \u03b4\u03c9\u03c1\u03b5\u03ac\u03bd \u03c0\u03c1\u03cc\u03c3\u03b8\u03b5\u03c4\u03bf \u03c3\u03c4\u03b7\u03bd \u03ad\u03ba\u03b4\u03bf\u03c3\u03b7 3.3.1 \u03ae \u03bd\u03b5\u03cc\u03c4\u03b5\u03c1\u03b7."]}}}