{"translation-revision-date":"2023-02-09 14:09+01:00","generator":"WP-CLI\/2.12.0","source":"js\/shop-payment-settings.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"zh_CN","plural-forms":"nplurals=2; plural=(n != 1);"},"Save":["\u4fdd\u5b58"],"Network error.":["\u7f51\u7edc\u9519\u8bef\u3002"],"Online payments":["\u5728\u7ebf\u652f\u4ed8"],"Sell through the shop page with a hosted Stripe checkout \u2014 buyers pay by card and the tickets are sent automatically.":["\u901a\u8fc7\u6258\u7ba1\u7684 Stripe \u7ed3\u8d26\u9875\u9762\u5728\u5546\u5e97\u9875\u9762\u9500\u552e\u2014\u2014\u4e70\u5bb6\u5237\u5361\u4ed8\u6b3e,\u7968\u5238\u81ea\u52a8\u53d1\u9001\u3002"],"Off \u2014 orders are confirmed manually in the Kasse":["\u5173\u95ed \u2014 \u8ba2\u5355\u5728\u6536\u94f6\u53f0\u4e2d\u624b\u52a8\u786e\u8ba4"],"Configured":["\u5df2\u914d\u7f6e"],"Not configured":["\u672a\u914d\u7f6e"],"Payment provider":["\u652f\u4ed8\u670d\u52a1\u63d0\u4f9b\u5546"],"Stripe secret key":["Stripe \u5bc6\u94a5"],"Leave empty to keep the stored key. A secret key (sk_\u2026) \u2014 never the publishable one.":["\u7559\u7a7a\u4ee5\u4fdd\u7559\u5df2\u5b58\u50a8\u7684\u5bc6\u94a5\u3002\u8bf7\u586b\u5199\u5bc6\u94a5(sk_\u2026)\u2014\u2014\u5207\u52ff\u586b\u5199\u53ef\u516c\u5f00\u7684\u5bc6\u94a5\u3002"],"Stripe webhook signing secret":["Stripe Webhook \u7b7e\u540d\u5bc6\u94a5"],"Saving\u2026":["\u6b63\u5728\u4fdd\u5b58\u2026"],"Saved.":["\u5df2\u4fdd\u5b58\u3002"],"Save failed.":["\u4fdd\u5b58\u5931\u8d25\u3002"],"Webhook endpoint (register in the Stripe dashboard \u2192 Webhooks)":["Webhook \u7aef\u70b9(\u5728 Stripe \u63a7\u5236\u9762\u677f \u2192 Webhooks \u4e2d\u6ce8\u518c)"],"Events: checkout.session.completed, checkout.session.expired, checkout.session.async_payment_failed":["\u4e8b\u4ef6:checkout.session.completed\u3001checkout.session.expired\u3001checkout.session.async_payment_failed"],"Test connection":["\u6d4b\u8bd5\u8fde\u63a5"],"Checking\u2026":["\