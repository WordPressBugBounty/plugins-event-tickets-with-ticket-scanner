{"translation-revision-date":"2023-02-09 14:09+01:00","generator":"WP-CLI\/2.12.0","source":"js\/shop-payment-settings.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"ja","plural-forms":"nplurals=2; plural=(n != 1);"},"Save":["\u4fdd\u5b58"],"Network error.":["\u30cd\u30c3\u30c8\u30ef\u30fc\u30af\u30a8\u30e9\u30fc\u3002"],"Online payments":["\u30aa\u30f3\u30e9\u30a4\u30f3\u6c7a\u6e08"],"Sell through the shop page with a hosted Stripe checkout \u2014 buyers pay by card and the tickets are sent automatically.":["\u30db\u30b9\u30c8\u578bStripe\u30c1\u30a7\u30c3\u30af\u30a2\u30a6\u30c8\u3067\u30b7\u30e7\u30c3\u30d7\u30da\u30fc\u30b8\u304b\u3089\u8ca9\u58f2 \u2014 \u8cfc\u5165\u8005\u306f\u30ab\u30fc\u30c9\u3067\u652f\u6255\u3044\u3001\u30c1\u30b1\u30c3\u30c8\u306f\u81ea\u52d5\u7684\u306b\u9001\u4fe1\u3055\u308c\u307e\u3059\u3002"],"Off \u2014 orders are confirmed manually in the Kasse":["\u30aa\u30d5 \u2014 \u6ce8\u6587\u306f\u30ec\u30b8\u3067\u624b\u52d5\u78ba\u8a8d\u3055\u308c\u307e\u3059"],"Configured":["\u8a2d\u5b9a\u6e08\u307f"],"Not configured":["\u672a\u8a2d\u5b9a"],"Payment provider":["\u6c7a\u6e08\u30d7\u30ed\u30d0\u30a4\u30c0\u30fc"],"Stripe secret key":["Stripe\u30b7\u30fc\u30af\u30ec\u30c3\u30c8\u30ad\u30fc"],"Leave empty to keep the stored key. A secret key (sk_\u2026) \u2014 never the publishable one.":["\u4fdd\u5b58\u6e08\u307f\u306e\u30ad\u30fc\u3092\u4fdd\u6301\u3059\u308b\u306b\u306f\u7a7a\u6b04\u306e\u307e\u307e\u306b\u3057\u307e\u3059\u3002\u30b7\u30fc\u30af\u30ec\u30c3\u30c8\u30ad\u30fc(sk_\u2026)\u2014\u516c\u958b\u53ef\u80fd\u30ad\u30fc\u306f\u7d76\u5bfe\u306b\u4f7f\u7528\u3057\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u3002"],"Stripe webhook signing secret":["Stripe\u30a6\u30a7\u30d6\u30d5\u30c3\u30af\u7f72\u540d\u30b7\u30fc\u30af\u30ec\u30c3\u30c8"],"Saving\u2026":["\u4fdd\u5b58\u4e2d\u2026"],"Saved.":["\u4fdd\u5b58\u3057\u307e\u3057\u305f\u3002"],"Save failed.":["\u4fdd\u5b58\u306b\u5931\u6557\u3057\u307e\u3057\u305f\u3002"],"Webhook endpoint (register in the Stripe dashboard \u2192 Webhooks)":["\u30a6\u30a7\u30d6\u30d5\u30c3\u30af\u30a8\u30f3\u30c9\u30dd\u30a4\u30f3\u30c8(Stripe\u30c0\u30c3\u30b7\u30e5\u30dc\u30fc\u30c9 \u2192 Webhooks \u3067\u767b\u9332)"],"Events: checkout.session.completed, checkout.session.expired, checkout.session.async_payment_failed":["\u30a4\u30d9\u30f3\u30c8:checkout.session.completed\u3001checkout.session.expired\u3001checkout.session.async_payment_failed"],"Test connection":["\u63a5\u7d9a\u30c6\u30b9\u30c8"],"Checking\u2026":["\u78ba\u8a8d\u4e2d\u2026"],"Key valid":["\u30ad\u30fc\u306f\u6709\u52b9\u3067\u3059"],"Webhook delivery still needs to be confirmed in the Stripe dashboard.":["\u30a6\u30a7\u30d6\u30d5\u30c3\u30af\u306e\u914d\u4fe1\u306f\u3001Stripe\u30c0\u30c3\u30b7\u30e5\u30dc\u30fc\u30c9\u3067\u307e\u3060\u78ba\u8a8d\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002"],"Check failed.":["\u78ba\u8a8d\u306b\u5931\u6557\u3057\u307e\u3057\u305f\u3002"],"The installed free plugin is too old for automatic ticket delivery after payment \u2014 update the free plugin to 3.3.1 or newer.":["\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u3055\u308c\u3066\u3044\u308b\u7121\u6599\u30d7\u30e9\u30b0\u30a4\u30f3\u304c\u53e4\u3059\u304e\u3066\u3001\u652f\u6255\u3044\u5f8c\u306e\u30c1\u30b1\u30c3\u30c8\u81ea\u52d5\u914d\u4fe1\u306b\u5bfe\u5fdc\u3057\u3066\u3044\u307e\u305b\u3093\u3002\u7121\u6599\u30d7\u30e9\u30b0\u30a4\u30f3\u30923.3.1\u4ee5\u964d\u306b\u66f4\u65b0\u3057\u3066\u304f\u3060\u3055\u3044\u3002"]}}}