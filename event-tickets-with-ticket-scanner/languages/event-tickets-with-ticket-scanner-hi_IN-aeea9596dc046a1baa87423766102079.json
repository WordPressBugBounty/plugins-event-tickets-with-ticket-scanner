{"translation-revision-date":"2026-03-24 18:00+0100","generator":"WP-CLI\/2.12.0","source":"js\/seating_a.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"hi_IN","plural-forms":"nplurals=2; plural=(n != 1);"},"Free Version: %d\/%d plans":["\u092e\u0941\u092b\u093c\u094d\u0924 \u0938\u0902\u0938\u094d\u0915\u0930\u0923: %d\/%d \u092f\u094b\u091c\u0928\u093e\u090f\u0901"],"Seating Plan Layout":["\u0938\u0940\u091f\u093f\u0902\u0917 \u092a\u094d\u0932\u093e\u0928 \u0932\u0947\u0906\u0909\u091f"],"Limit reached. Upgrade to Premium for unlimited access.":["\u0938\u0940\u092e\u093e \u092a\u0942\u0930\u0940 \u0939\u094b \u0917\u0908\u0964 \u0905\u0938\u0940\u092e\u093f\u0924 \u092a\u0939\u0941\u0901\u091a \u0915\u0947 \u0932\u093f\u090f \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u092e\u0947\u0902 \u0905\u092a\u0917\u094d\u0930\u0947\u0921 \u0915\u0930\u0947\u0902\u0964"],"Remove":["\u0939\u091f\u093e\u090f\u0901"],"Hide Layout":["\u0932\u0947\u0906\u0909\u091f \u091b\u093f\u092a\u093e\u090f\u0901"],"Clone":["\u0915\u094d\u0932\u094b\u0928 \u0915\u0930\u0947\u0902"],"Import Seating Plan":[""],"File:":[""],"Seating Plans":["\u0938\u0940\u091f\u093f\u0902\u0917 \u092a\u094d\u0932\u093e\u0928"],"Failed to load designer script":["\u0921\u093f\u091c\u093c\u093e\u0907\u0928\u0930 \u0938\u094d\u0915\u094d\u0930\u093f\u092a\u094d\u091f \u0932\u094b\u0921 \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u0935\u093f\u092b\u0932"],"Plan to replace:":[""],"-- Action --":["-- \u0915\u094d\u0930\u093f\u092f\u093e --"],"Visual (Seat Map)":["\u0926\u0943\u0936\u094d\u092f (\u0938\u0940\u091f \u092e\u0948\u092a)"],"Customers will see an interactive seat map where they can click on available seats. Occupied seats are shown in a different color. This provides a visual overview of the venue. (Premium feature)":["\u0917\u094d\u0930\u093e\u0939\u0915\u094b\u0902 \u0915\u094b \u090f\u0915 \u0907\u0902\u091f\u0930\u0948\u0915\u094d\u091f\u093f\u0935 \u0938\u0940\u091f \u092e\u0948\u092a \u0926\u093f\u0916\u093e\u0908 \u0926\u0947\u0917\u093e \u091c\u0939\u093e\u0902 \u0935\u0947 \u0909\u092a\u0932\u092c\u094d\u0927 \u0938\u0940\u091f\u094b\u0902 \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u0905\u0927\u093f\u0915\u0943\u0924 \u0938\u0940\u091f\u0947\u0902 \u0905\u0932\u0917 \u0930\u0902\u0917 \u092e\u0947\u0902 \u0926\u093f\u0916\u093e\u0908 \u091c\u093e\u0924\u0940 \u0939\u0948\u0902\u0964 \u092f\u0939 \u0938\u094d\u0925\u093e\u0928 \u0915\u093e \u0935\u093f\u091c\u093c\u0941\u0905\u0932 \u0905\u0935\u0932\u094b\u0915\u0928 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u093e \u0939\u0948\u0964 (\u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u0938\u0941\u0935\u093f\u0927\u093e)"],"Status":["\u00c1llapot"],"Seat updated successfully":["\u0938\u0940\u091f \u0938\u092b\u0932\u0924\u093e\u092a\u0942\u0930\u094d\u0935\u0915 \u0905\u092a\u0921\u0947\u091f \u0915\u0940 \u0917\u0908"],"Customers will see a dropdown menu to select their seat. Available seats are shown in a list sorted by identifier. This is ideal for smaller venues or when visual seat selection is not needed.":["\u0917\u094d\u0930\u093e\u0939\u0915\u094b\u0902 \u0915\u094b \u0905\u092a\u0928\u0940 \u0938\u0940\u091f \u091a\u0941\u0928\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u0921\u094d\u0930\u0949\u092a\u0921\u093e\u0909\u0928 \u092e\u0947\u0928\u0942 \u0926\u093f\u0916\u093e\u0908 \u0926\u0947\u0917\u093e\u0964 \u0909\u092a\u0932\u092c\u094d\u0927 \u0938\u0940\u091f\u0947\u0902 \u092a\u0939\u091a\u093e\u0928\u0915\u0930\u094d\u0924\u093e \u0926\u094d\u0935\u093e\u0930\u093e \u0915\u094d\u0930\u092e\u092c\u0926\u094d\u0927 \u0938\u0942\u091a\u0940 \u092e\u0947\u0902 \u0926\u093f\u0916\u093e\u0908 \u091c\u093e\u0924\u0940 \u0939\u0948\u0902\u0964 \u092f\u0939 \u091b\u094b\u091f\u0947 \u0938\u094d\u0925\u093e\u0928\u094b\u0902 \u092f\u093e \u091c\u092c \u0935\u093f\u091c\u093c\u0941\u0905\u0932 \u0938\u0940\u091f \u091a\u092f\u0928 \u0915\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0928\u0939\u0940\u0902 \u0939\u0948 \u0924\u094b \u0906\u0926\u0930\u094d\u0936 \u0939\u0948\u0964"],"Seating plan cloned successfully":["\u0938\u0940\u091f\u093f\u0902\u0917 \u092a\u094d\u0932\u093e\u0928 \u0938\u092b\u0932\u0924\u093e\u092a\u0942\u0930\u094d\u0935\u0915 \u0915\u094d\u0932\u094b\u0928 \u0915\u093f\u092f\u093e \u0917\u092f\u093e"],"Save & Add Next":["\u0938\u0939\u0947\u091c\u0947\u0902 \u0914\u0930 \u0905\u0917\u0932\u093e \u091c\u094b\u0921\u093c\u0947\u0902"],"Are you sure you want to delete this?":["\u0915\u094d\u092f\u093e \u0906\u092a \u0935\u093e\u0915\u0908 \u0907\u0938\u0947 \u0939\u091f\u093e\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902?"],"Optional: Upload a photo of the entire venue\/hall. Customers can view this via \"View Seating Plan\" button. Useful when the seat map only shows a specific section.":["\u0935\u0948\u0915\u0932\u094d\u092a\u093f\u0915: \u092a\u0942\u0930\u0947 \u0938\u094d\u0925\u0932\/\u0939\u0949\u0932 \u0915\u0940 \u090f\u0915 \u092b\u094b\u091f\u094b \u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u0947\u0902\u0964 \u0917\u094d\u0930\u093e\u0939\u0915 \u0907\u0938\u0947 \"\u0938\u0940\u091f\u093f\u0902\u0917 \u092a\u094d\u0932\u093e\u0928 \u0926\u0947\u0916\u0947\u0902\" \u092c\u091f\u0928 \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u0926\u0947\u0916 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u0909\u092a\u092f\u094b\u0917\u0940 \u0939\u0948 \u091c\u092c \u0938\u0940\u091f \u092e\u0948\u092a \u0915\u0947\u0935\u0932 \u090f\u0915 \u0935\u093f\u0936\u093f\u0937\u094d\u091f \u092d\u093e\u0917 \u0926\u093f\u0916\u093e\u0924\u093e \u0939\u0948\u0964"],"Open Designer":["\u0921\u093f\u091c\u093c\u093e\u0907\u0928\u0930 \u0916\u094b\u0932\u0947\u0902"],"An error occurred. Please try again.":["\u090f\u0915 \u0924\u094d\u0930\u0941\u091f\u093f \u0939\u0941\u0908\u0