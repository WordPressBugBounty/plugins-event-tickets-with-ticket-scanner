1 \u092a\u094d\u0930\u092f\u093e\u0938\u0964 \u0915\u0943\u092a\u092f\u093e \u0907\u0935\u0947\u0902\u091f \u0935\u094d\u092f\u0935\u0938\u094d\u0925\u093e\u092a\u0915 \u0938\u0947 \u0907\u0938 \u091f\u093f\u0915\u091f \u0915\u094b \u0930\u0940\u0938\u0947\u091f \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u0939\u0947\u0902\u0964"],"label\u0004Confirm codes":["\u0915\u094b\u0921 \u0915\u0940 \u092a\u0941\u0937\u094d\u091f\u093f \u0915\u0930\u0947\u0902"]}}}