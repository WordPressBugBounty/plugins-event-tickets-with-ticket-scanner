{"translation-revision-date":"2026-03-24 18:00+0100","generator":"WP-CLI\/2.12.0","source":"js\/congress-a.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"ko_KR","plural-forms":"nplurals=1; plural=0;"},"Title":["\uc81c\ubaa9"],"Add":["\ucd94\uac00"],"Export contacts":["\uc5f0\ub77d\ucc98 \ub0b4\ubcf4\ub0b4\uae30"],"Portal label":["\ud3ec\ud138 \ub808\uc774\ube14"],"Shown in the wallet and email (e.g. \"Opera evening\", \"Zoo visit\"). Empty = use the global default.":["\uc9c0\uac11\uacfc \uc774\uba54\uc77c\uc5d0 \ud45c\uc2dc\ub429\ub2c8\ub2e4(\uc608: \"\uc624\ud398\ub77c\uc758 \ubc24\", \"\ub3d9\ubb3c\uc6d0 \ubc29\ubb38\"). \ube44\uc6cc\ub450\uba74 \uc804\uc5ed \uae30\ubcf8\uac12\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4."],"Show pages as a card grid on the start screen":["\uc2dc\uc791 \ud654\uba74\uc5d0\uc11c \ud398\uc774\uc9c0\ub97c \uce74\ub4dc \uadf8\ub9ac\ub4dc\ub85c \ud45c\uc2dc"],"Visitors first see a grid of page cards (icon\/image + description) instead of jumping straight into the first page.":["\ubc29\ubb38\uc790\uac00 \uccab \ubc88\uc9f8 \ud398\uc774\uc9c0\ub85c \ubc14\ub85c \uc774\ub3d9\ud558\ub294 \ub300\uc2e0 \ud398\uc774\uc9c0 \uce74\ub4dc(\uc774\ubbf8\uc9c0\/\uc544\uc774\ucf58 + \uc124\uba85) \uadf8\ub9ac\ub4dc\ub97c \uba3c\uc800 \ubd05\ub2c8\ub2e4."],"Active \u2014 visible to ticket holders":["\ud65c\uc131 \u2014 \ud2f0\ucf13 \ubcf4\uc720\uc790\uc5d0\uac8c \ud45c\uc2dc\ub428"],"Turn off to hide this congress everywhere (page + wallet) without unassigning it \u2014 e.g. to publish the info only later.":["\ud560\ub2f9 \ud574\uc81c\ud558\uc9c0 \uc54a\uace0\ub3c4 \uc774 \ucee8\uadf8\ub808\uc2a4\ub97c \ubaa8\ub4e0 \uacf3(\ud398\uc774\uc9c0 + \uc9c0\uac11)\uc5d0\uc11c \uc228\uae30\ub824\uba74 \ub044\uc138\uc694. \uc608: \uc815\ubcf4\ub97c \ub098\uc911\uc5d0 \uac8c\uc2dc\ud558\ub824\ub294 \uacbd\uc6b0."],"No icon":["\uc544\uc774\ucf58 \uc5c6\uc74c"],"Remove image":["\uc774\ubbf8\uc9c0 \uc81c\uac70"],"Icon, optional image, card color and a short description shown on the page card.":["\ud398\uc774\uc9c0 \uce74\ub4dc\uc5d0 \ud45c\uc2dc\ub418\ub294 \uc544\uc774\ucf58, \uc120\ud0dd \uc774\ubbf8\uc9c0, \uce74\ub4dc \uc0c9\uc0c1, \uac04\ub2e8 \uc124\uba85\uc785\ub2c8\ub2e4."],"Icon":["\uc544\uc774\ucf58"],"Image (optional, overrides icon)":["\uc774\ubbf8\uc9c0(\uc120\ud0dd, \uc544\uc774\ucf58\uc744 \ub300\uccb4)"],"Card color":["\uce74\ub4dc \uc0c9\uc0c1"],"Short description (max 160)":["\uac04\ub2e8 \uc124\uba85(\ucd5c\ub300 160\uc790)"],"Page card settings":["\ud398\uc774\uc9c0 \uce74\ub4dc \uc124\uc815"],"Settings":["\uc124\uc815"],"Speakers":["\uc5f0\uc0ac"],"Insert variable\u2026":["\ubcc0\uc218 \uc0bd\uc785\u2026"],"Short bio (max 500 characters)":["\uc9e7\uc740 \uc18c\uac1c(\ucd5c\ub300 500\uc790)"],"Add speaker":["\uc5f0\uc0ac \ucd94\uac00"],"Each speaker has an image, name, title and a short bio (max 500 characters). One speaker is shown in full; several are shown as boxes. Drag to reorder.":["\uac01 \uc5f0\uc0ac\ub294 \uc774\ubbf8\uc9c0, \uc774\ub984, \uc9c1\ud568, \uac04\ub2e8 \uc18c\uac1c(\ucd5c\ub300 500\uc790)\ub97c \uac00\uc9d1\ub2c8\ub2e4. \uc5f0\uc0ac 1\uba85\uc740 \uc804\uccb4 \ud45c\uc2dc, \uc5ec\ub7ec \uba85\uc740 \ubc15\uc2a4 \ud615\ud0dc\ub85c \ud45c\uc2dc\ub429\ub2c8\ub2e4. \ub4dc\ub798\uadf8\ud558\uc5ec \uc21c\uc11c\ub97c \ubc14\uafb8\uc138\uc694."]}}}