{"translation-revision-date":"2023-02-09 14:09+01:00","generator":"WP-CLI\/2.12.0","source":"js\/congress-a.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"zh_CN","plural-forms":"nplurals=2; plural=(n != 1);"},"Error":["\u9519\u8bef"],"Active":["\u6709\u6548"],"Status":["\u72b6\u6001"],"Expired":["\u5df2\u8fc7\u671f"],"New congress":["\u65b0\u5efa\u5927\u4f1a"],"Title":[""],"Products":["\u4ea7\u54c1"],"Updated":["\u5df2\u66f4\u65b0"],"Export contacts":[""],"Edit":["\u7f16\u8f91"],"New edition":["\u65b0\u7248\u672c"],"Delete":["\u5220\u9664"],"Congresses let you attach structured information (programme, downloads, media, texts) to an event. Ticket holders can access the congress page using their ticket ID. Assign a congress to a product in the WooCommerce product settings \u2014 one congress can be shared across multiple products.":["\u5927\u4f1a\u529f\u80fd\u5141\u8bb8\u60a8\u5c06\u7ed3\u6784\u5316\u4fe1\u606f\uff08\u8bae\u7a0b\u3001\u4e0b\u8f7d\u3001\u5a92\u4f53\u3001\u6587\u672c\uff09\u9644\u52a0\u5230\u6d3b\u52a8\u4e2d\u3002\u6301\u7968\u8005\u53ef\u4ee5\u4f7f\u7528\u5176\u7968\u636eID\u8bbf\u95ee\u5927\u4f1a\u9875\u9762\u3002\u5728WooCommerce\u4ea7\u54c1\u8bbe\u7f6e\u4e2d\u5c06\u5927\u4f1a\u5206\u914d\u7ed9\u4ea7\u54c1\u2014\u2014\u4e00\u4e2a\u5927\u4f1a\u53ef\u4ee5\u5728\u591a\u4e2a\u4ea7\u54c1\u95f4\u5171\u4eab\u3002"],"Delete this congress?":["\u5220\u9664\u6b64\u5927\u4f1a\uff1f"],"This action cannot be undone. All sections will be deleted as well.":["\u6b64\u64cd\u4f5c\u65e0\u6cd5\u64a4\u9500\u3002\u6240\u6709\u7248\u5757\u4e5f\u5c06\u4e00\u5e76\u5220\u9664\u3002"],"Current title:":["\u5f53\u524d\u6807\u9898\uff1a"],"Current slug:":["\u5f53\u524d\u522b\u540d (slug)\uff1a"],"Slug for new edition:":["\u65b0\u7248\u672c\u7684\u522b\u540d\uff1a"],"Title for new edition (leave empty to auto-generate):":["\u65b0\u7248\u672c\u6807\u9898\uff08\u7559\u7a7a\u81ea\u52a8\u751f\u6210\uff09\uff1a"],"Create":["\u521b\u5efa"],"Cancel":["\u53d6\u6d88"],"Edit congress":["\u7f16\u8f91\u5927\u4f1a"],"Details":["\u8be6\u60c5"],"Unique identifier for this congress. Visitors open it through their personal ticket link, not the slug.":["\u6b64\u5927\u4f1a\u7684\u552f\u4e00\u6807\u8bc6\u7b26\u3002\u8bbf\u5ba2\u901a\u8fc7\u5176\u4e2a\u4eba\u95e8\u7968\u94fe\u63a5\u6253\u5f00\uff0c\u800c\u975e\u901a\u8fc7\u522b\u540d (slug)\u3002"],"Portal label":[""],"Shown in the wallet and email (e.g. \"Opera evening\", \"Zoo visit\"). Empty = use the global default.":[""],"Show pages as a card grid on the start screen":[""],"Visitors first see a grid of page cards (icon\/image + description) instead of jumping straight into the first page.":[""],"Access expires (optional)":["\u8bbf\u95ee\u8fc7\u671f\uff08\u53ef\u9009\uff09"],"Manual hard cutoff. Leave empty for unlimited access.":["\u624b\u52a8\u786c\u6027\u622a\u6b62\u3002\u7559\u7a7a\u8868\u793a\u4e0d\u9650\u5236\u8bbf\u95ee\u3002"],"Active \u2014 visible to ticket holders":[""],"Turn off to hide this congress everywhere (page + wallet) without unassigning it \u2014 e.g. to publish the info only later.":[""],"assigned (manage on product level)":["\u5df2\u5206\u914d\uff08\u5728\u4ea7\u54c1\u7ea7\u522b\u7ba1\u7406\uff09"],"Assign via the WooCommerce product settings.":["\u901a\u8fc7WooCommerce\u4ea7\u54c1\u8bbe\u7f6e\u8fdb\u884c\u5206\u914d\u3002"],"Save the congress first to add pages and sections.":["\u8bf7\u5148\u4fdd\u5b58\u5927\u4f1a\uff0c\u7136\u540e\u624d\u80fd\u6dfb\u52a0\u9875\u9762\u548c\u7248\u5757\u3002"],"Pages":["\u9875\u9762"],"Add page":["\u6dfb\u52a0\u9875\u9762"],"The first page is the start page (shown first to visitors). Drag pages and sections to reorder.":["\u7b2c\u4e00\u4e2a\u9875\u9762\u4e3a\u8d77\u59cb\u9875\u9762\uff08\u9996\u5148\u5411\u8bbf\u5ba2\u663e\u793a\uff09\u3002\u62d6\u52a8\u9875\u9762\u548c\u7248\u5757\u4ee5\u91cd\u65b0\u6392\u5e8f\u3002"],"Save congress":["\u4fdd\u5b58\u5927\u4f1a"],"Rename page":["\u91cd\u547d\u540d\u9875\u9762"],"Delete page?":["\u5220\u9664\u9875\u9762\uff1f"],"Its sections will be moved to the start page. This cannot be undone.":["\u5176\u7248\u5757\u5c06\u88ab\u79fb\u52a8\u5230\u8d77\u59cb\u9875\u9762\u3002\u6b64\u64cd\u4f5c\u65e0\u6cd5\u64a4\u9500\u3002"],"Delete section?":["\u5220\u9664\u7ae0\u8282\uff1f"],"This action cannot be undone.":["\u6b64\u64cd\u4f5c\u65e0\u6cd5\u64a4\u9500\u3002"],"OK":["\u786e\u5b9a"],"No icon":[""],"Remove image":[""],"Choose image":["\u9009\u62e9\u56fe\u7247"],"Select image":["\u9009\u62e9\u56fe\u7247"],"Icon, optional image, card color and a short description shown on the page card.":[""],"Icon":[""],"Image (optional, overrides icon)":[""],"Card color":[""],"Short description (max 160)":[""],"Page card settings":[""],"No pages yet. Add a page to start.":["\u5c1a\u65e0\u9875\u9762\u3002\u6dfb\u52a0\u4e00\u4e2a\u9875\u9762\u4ee5\u5f00\u59cb\u3002"],"Drag to reorder pages":["\u62d6\u52a8\u4ee5\u91cd\u65b0\u6392\u5e8f\u9875\u9762"],"Start page":["\u8d77\u59cb\u9875\u9762"],"Add section":["\u6dfb\u52a0\u7248\u5757"],"Rename":["\u91cd\u547d\u540d"],"Settings":[""],"No sections on this page yet.":["\u6b64\u9875\u9762\u5c1a\u65e0\u7248\u5757\u3002"],"Program":["\u8bae\u7a0b"],"Image":["\u56fe\u7247"],"Video":["\u89c6\u9891"],"Gallery":["\u56fe\u5e93"],"Speakers":[""],"Type":["\u7c7b\u578b"],"start page":["\u8d77\u59cb\u9875\u9762"],"Page":["\u9875\u9762"],"Choose which page this section belongs to. Change it to move the section to another page.":["\u9009\u62e9\u8be5\u7248\u5757\u6240\u5c5e\u7684\u9875\u9762\u3002\u66f4\u6539\u6b64\u9879\u53ef\u5c06\u7248\u5757\u79fb\u52a8\u5230\u53e6\u4e00\u4e2a\u9875\u9762\u3002"],"Content":["\u5185\u5bb9"],"HTML allowed (same rules as blog posts). JavaScript is stripped.":["\u5141\u8bb8\u4f7f\u7528 HTML\uff08\u89c4\u5219\u4e0e\u535a\u5ba2\u6587\u7ae0\u76f8\u540c\uff09\u3002JavaScript \u4f1a\u88ab\u79fb\u9664\u3002"],"Insert variable\u2026":[""],"Select file":["\u9009\u62e9\u6587\u4ef6"],"Drag to reorder":["\u62d6\u52