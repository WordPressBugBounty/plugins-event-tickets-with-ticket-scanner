{"translation-revision-date":"2023-02-09 14:09+01:00","generator":"WP-CLI\/2.12.0","source":"js\/congress-a.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"zh_CN","plural-forms":"nplurals=2; plural=(n != 1);"},"Add slot":["\u6dfb\u52a0\u65f6\u95f4\u6bb5"],"Add days and time slots. Each slot has time, title, speaker and room.":["\u6dfb\u52a0\u65e5\u671f\u548c\u65f6\u95f4\u6bb5\u3002\u6bcf\u4e2a\u65f6\u95f4\u6bb5\u5305\u542b\u65f6\u95f4\u3001\u6807\u9898\u3001\u6f14\u8bb2\u8005\u548c\u4f1a\u573a\u3002"],"Add file":["\u6dfb\u52a0\u6587\u4ef6"],"Images":["\u56fe\u7247"],"An event app is the companion page your visitors open with their ticket: programme and schedule, speaker or artist info, venue maps, downloads, media and support pages \u2014 everything structured in one place. Perfect for a congress with multiple sessions, but just as much for a single event where ticket holders need extra info, a FAQ or contact options. Visitors do not need an account or an extra app: their ticket ID is the key, access opens with the ticket and can expire with it. Assign an event app to a product in the WooCommerce product settings \u2014 one app can serve multiple products, so an event series shares one app.":[""],"No icon":[""],"Open inline":["\u5185\u5d4c\u6253\u5f00"],"Program":["\u8bae\u7a0b"],"Visitors first see a grid of page cards (icon\/image + description) instead of jumping straight into the first page.":[""],"Manual hard cutoff. Leave empty for unlimited access.":["\u624b\u52a8\u786c\u6027\u622a\u6b62\u3002\u7559\u7a7a\u8868\u793a\u4e0d\u9650\u5236\u8bbf\u95ee\u3002"],"Active":["\u6709\u6548"],"Short description (max 160)":[""],"Add section":["\u6dfb\u52a0\u7248\u5757"],"Status":["\u72b6\u6001"],"Title and slug are required.":["\u6807\u9898\u548c\u522b\u540d\u4e3a\u5fc5\u586b\u9879\u3002"],"Products":["\u4ea7\u54c1"],"Internal":["\u5185\u90e8"],"Current title:":["\u5f53\u524d\u6807\u9898\uff1a"],"Cancel":["\u53d6\u6d88"],"Shown in the wallet and email (e.g. \"Opera evening\", \"Zoo visit\"). Empty = use the global default.":[""],"Remove":["\u79fb\u9664"],"Speakers":[""],"Add page":["\u6dfb\u52a0\u9875\u9762"],"Delete section?":["\u5220\u9664\u7ae0\u8282\uff1f"],"Choose video":["\u9009\u62e9\u89c6\u9891"],"Custom width":["\u81ea\u5b9a\u4e49\u5bbd\u5ea6"],"No sections on this page yet.":["\u6b64\u9875\u9762\u5c1a\u65e0\u7248\u5757\u3002"],"Title for new edition (leave empty to auto-generate):":["\u65b0\u7248\u672c\u6807\u9898\uff08\u7559\u7a7a\u81ea\u52a8\u751f\u6210\uff09\uff1a"],"Icon, optional image, card color and a short description shown on the page card.":[""],"Rename":["\u91cd\u547d\u540d"],"Choose":["\u9009\u62e9"],"Add":[""],"Video":["\u89c6\u9891"],"Choose which page this section belongs to. Change it to move the section to another page.":["\u9009\u62e9\u8be5\u7248\u5757\u6240\u5c5e\u7684\u9875\u9762\u3002\u66f4\u6539\u6b64\u9879\u53ef\u5c06\u7248\u5757\u79fb\u52a8\u5230\u53e6\u4e00\u4e2a\u9875\u9762\u3002"],"Delete page?":["\u5220\u9664\u9875\u9762\uff1f"],"Details":["\u8be6\u60c5"],"Files":["\u6587\u4ef6"],"Drag to reorder pages":["\u62d6\u52a8\u4ee5\u91cd\u65b0\u6392\u5e8f\u9875\u9762"],"Page card settings":[""],"Delete":["\u5220\u9664"],"Video URL":["\u89c6\u9891 URL"],"Add URL":["\u6dfb\u52a0 URL"],"Link (YouTube, Vimeo, \u2026)":["\u94fe\u63a5\uff08YouTube\u3001Vimeo\u3001\u2026\uff09"],"Display size":["\u663e\u793a\u5c3a\u5bf8"],"start page":["\u8d77\u59cb\u9875\u9762"],"Short bio (max 500 characters)":[""],"Portal label":[""],"Edit section":["\u7f16\u8f91\u7248\u5757"],"Image":["\u56fe\u7247"],"Show pages as a card grid on the start screen":[""],"Edit event app":[""],"Icon":[""],"Save congress":["\u4fdd\u5b58\u5927\u4f1a"],"Assign via the WooCommerce product settings.":["\u901a\u8fc7WooCommerce\u4ea7\u54c1\u8bbe\u7f6e\u8fdb\u884c\u5206\u914d\u3002"],"Name":["\u540d\u79f0"],"Unique identifier for this congress. Visitors open it through their personal ticket link, not the slug.":["\u6b64\u5927\u4f1a\u7684\u552f\u4e00\u6807\u8bc6\u7b26\u3002\u8bbf\u5ba2\u901a\u8fc7\u5176\u4e2a\u4eba\u95e8\u7968\u94fe\u63a5\u6253\u5f00\uff0c\u800c\u975e\u901a\u8fc7\u522b\u540d (slug)\u3002"],"Type":["\u7c7b\u578b"],"assigned (manage on product level)":["\u5df2\u5206\u914d\uff08\u5728\u4ea7\u54c1\u7ea7\u522b\u7ba1\u7406\uff09"],"Remove day":["\u79fb\u9664\u65e5\u671f"],"Save the congress first to add pages and sections.":["\u8bf7\u5148\u4fdd\u5b58\u5927\u4f1a\uff0c\u7136\u540e\u624d\u80fd\u6dfb\u52a0\u9875\u9762\u548c\u7248\u5757\u3002"],"Select image":["\u9009\u62e9\u56fe\u7247"],"Add image":["\u6dfb\u52a0\u56fe\u7247"],"Page":["\u9875\u9762"],"Title":[""],"New edition":["\u65b0\u7248\u672c"],"Image (optional, overrides icon)":[""],"Remove image":[""],"Drag to reorder":["\u62d6\u52a8\u4ee5\u91cd\u65b0\u6392\u5e8f"],"Add speaker":[""],"This action cannot be undone. All sections will be deleted as well.":["\u6b64\u64cd\u4f5c\u65e0\u6cd5\u64a4\u9500\u3002\u6240\u6709\u7248\u5757\u4e5f\u5c06\u4e00\u5e76\u5220\u9664\u3002"],"Rename page":["\u91cd\u547d\u540d\u9875\u9762"],"Create":["\u521b\u5efa"],"Current slug:":["\u5f53\u524d\u522b\u540d (slug)\uff1a"],"Video file":["\u89c6\u9891\u6587\u4ef6"],"HTML allowed (same rules as blog posts). JavaScript is stripped.":["\u5141\u8bb8\u4f7f\u7528 HTML\uff08\u89c4\u5219\u4e0e\u535a\u5ba2\u6587\u7ae0\u76f8\u540c\uff09\u3002JavaScript \u4f1a\u88ab\u79fb\u9664\u3002"],"Open example":[""],"Label for visitors":["\u9762\u5411\u8bbf\u5ba2\u7684\u6807\u7b7e"],"OK":["\u786e\u5b9a"],"Caption (optional)":["\u8bf4\u660e\u6587\u5b57\uff08\u53ef\u9009\uff09"],"Updated:":["\u66f4\u65b0\u65f6\u95f4\uff1a"],"Open in browser instead of downloading (PDF, images).":["\u5728\u6d4f\u89c8\u5668\u4e2d\u6253\u5f00\u800c\u975e\u4e0b\u8f7d\uff08PDF\u3001\u56fe\u7247\uff09\u3002"],"Pick files from the media library. Label is shown to visitors. Drag to reorder.":["\u4ece\u5a92\u4f53\u5e93\u4e2d\u9009\u62e9\u6587\u4ef6\u3002\u6807\u7b7e\u4f1a\u663e\u793a\u7e