{"translation-revision-date":"2023-02-09 14:09+01:00","generator":"WP-CLI\/2.12.0","source":"js\/congress-a.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"ja","plural-forms":"nplurals=2; plural=(n != 1);"},"Title":["\u30bf\u30a4\u30c8\u30eb"],"Add":["\u8ffd\u52a0"],"Export contacts":["\u9023\u7d61\u5148\u3092\u30a8\u30af\u30b9\u30dd\u30fc\u30c8"],"Portal label":["\u30dd\u30fc\u30bf\u30eb\u30e9\u30d9\u30eb"],"Shown in the wallet and email (e.g. \"Opera evening\", \"Zoo visit\"). Empty = use the global default.":["\u30a6\u30a9\u30ec\u30c3\u30c8\u3068\u30e1\u30fc\u30eb\u306b\u8868\u793a\u3055\u308c\u307e\u3059\uff08\u4f8b\uff1a\u300c\u30aa\u30da\u30e9\u306e\u5915\u3079\u300d\u300c\u52d5\u7269\u5712\u8a2a\u554f\u300d\uff09\u3002\u7a7a\u6b04\uff1d\u30b0\u30ed\u30fc\u30d0\u30eb\u30c7\u30d5\u30a9\u30eb\u30c8\u3092\u4f7f\u7528\u3002"],"Show pages as a card grid on the start screen":["\u30b9\u30bf\u30fc\u30c8\u753b\u9762\u3067\u30da\u30fc\u30b8\u30ab\u30fc\u30c9\u3092\u30b0\u30ea\u30c3\u30c9\u8868\u793a\u3059\u308b"],"Visitors first see a grid of page cards (icon\/image + description) instead of jumping straight into the first page.":["\u8a2a\u554f\u8005\u306f\u6700\u521d\u306e\u30da\u30fc\u30b8\u306b\u3044\u304d\u306a\u308a\u98db\u3070\u305a\u3001\u6700\u521d\u306b\u30da\u30fc\u30b8\u30ab\u30fc\u30c9\uff08\u30a2\u30a4\u30b3\u30f3\/\u753b\u50cf + \u8aac\u660e\uff09\u306e\u30b0\u30ea\u30c3\u30c9\u3092\u8868\u793a\u3057\u307e\u3059\u3002"],"Active \u2014 visible to ticket holders":["\u6709\u52b9 \u2014 \u30c1\u30b1\u30c3\u30c8\u6240\u6709\u8005\u306b\u8868\u793a"],"Turn off to hide this congress everywhere (page + wallet) without unassigning it \u2014 e.g. to publish the info only later.":["\u5272\u308a\u5f53\u3066\u3092\u89e3\u9664\u305b\u305a\u306b\u3001\u3053\u306e\u30b3\u30f3\u30b0\u30ec\u30b9\u3092\u30da\u30fc\u30b8\u3068\u30a6\u30a9\u30ec\u30c3\u30c8\u306e\u4e21\u65b9\u3067\u975e\u8868\u793a\u306b\u3057\u307e\u3059\uff08\u4f8b\uff1a\u60c5\u5831\u516c\u958b\u3092\u5f8c\u3067\u884c\u3046\u5834\u5408\uff09\u3002"],"No icon":["\u30a2\u30a4\u30b3\u30f3\u306a\u3057"],"Remove image":["\u753b\u50cf\u3092\u524a\u9664"],"Icon, optional image, card color and a short description shown on the page card.":["\u30a2\u30a4\u30b3\u30f3\u3001\u30aa\u30d7\u30b7\u30e7\u30f3\u306e\u753b\u50cf\u3001\u30ab\u30fc\u30c9\u306e\u8272\u3001\u7c21\u5358\u306a\u8aac\u660e\u304c\u30da\u30fc\u30b8\u30ab\u30fc\u30c9\u306b\u8868\u793a\u3055\u308c\u307e\u3059\u3002"],"Icon":["\u30a2\u30a4\u30b3\u30f3"],"Image (optional, overrides icon)":["\u753b\u50cf\uff08\u30aa\u30d7\u30b7\u30e7\u30f3\u3001\u30a2\u30a4\u30b3\u30f3\u3092\u4e0a\u66f8\u304d\uff09"],"Card color":["\u30ab\u30fc\u30c9\u306e\u8272"],"Short description (max 160)":["\u7c21\u5358\u306a\u8aac\u660e\uff08\u6700\u5927160\u6587\u5b57\uff09"],"Page card settings":["\u30da\u30fc\u30b8\u30ab\u30fc\u30c9\u8a2d\u5b9a"],"Settings":["\u8a2d\u5b9a"],"Speakers":["\u767b\u58c7\u8005"],"Insert variable\u2026":["\u5909\u6570\u3092\u633f\u5165\u2026"],"Short bio (max 500 characters)":["\u7c21\u5358\u306a\u7d4c\u6b74\uff08\u6700\u5927500\u6587\u5b57\uff09"],"Add speaker":["\u767b\u58c7\u8005\u3092\u8ffd\u52a0"],"Each speaker has an image, name, title and a short bio (max 500 characters). One speaker is shown in full; several are shown as boxes. Drag to reorder.":["\u5404\u767b\u58c7\u8005\u306b\u306f\u753b\u50cf\u3001\u540d\u524d\u3001\u80a9\u66f8\u304d\u3001\u7c21\u5358\u306a\u7d4c\u6b74\uff08\u6700\u5927500\u6587\u5b57\uff09\u304c\u3042\u308a\u307e\u3059\u30021\u4eba\u306e\u5834\u5408\u306f\u5168\u4f53\u8868\u793a\u3001\u8907\u6570\u3044\u308b\u5834\u5408\u306f\u30dc\u30c3\u30af\u30b9\u8868\u793a\u3002\u30c9\u30e9\u30c3\u30b0\u3067\u4e26\u3079\u66ff\u3048\u53ef\u80fd\u3002"]}}}