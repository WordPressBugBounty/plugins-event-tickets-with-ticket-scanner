{"translation-revision-date":"2026-03-24 18:00+0100","generator":"WP-CLI\/2.12.0","source":"js\/shop-payment-settings.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"hu_HU","plural-forms":"nplurals=2; plural=(n != 1);"},"Save":["\u0938\u0939\u0947\u091c\u0947\u0902"],"Network error.":["\u0928\u0947\u091f\u0935\u0930\u094d\u0915 \u0924\u094d\u0930\u0941\u091f\u093f\u0964"],"Online payments":["\u0911\u0928\u0932\u093e\u0907\u0928 \u092d\u0941\u0917\u0924\u093e\u0928"],"Sell through the shop page with a hosted Stripe checkout \u2014 buyers pay by card and the tickets are sent automatically.":["\u0939\u094b\u0938\u094d\u091f\u0947\u0921 Stripe \u091a\u0947\u0915\u0906\u0909\u091f \u0915\u0947 \u0938\u093e\u0925 \u0936\u0949\u092a \u092a\u0947\u091c \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u092c\u0947\u091a\u0947\u0902 \u2014 \u0916\u0930\u0940\u0926\u093e\u0930 \u0915\u093e\u0930\u094d\u0921 \u0938\u0947 \u092d\u0941\u0917\u0924\u093e\u0928 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u091f\u093f\u0915\u091f \u0938\u094d\u0935\u091a\u093e\u0932\u093f\u0924 \u0930\u0942\u092a \u0938\u0947 \u092d\u0947\u091c\u0947 \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964"],"Off \u2014 orders are confirmed manually in the Kasse":["\u092c\u0902\u0926 \u2014 \u0911\u0930\u094d\u0921\u0930 \u0915\u0948\u0936\u093f\u092f\u0930 \u092e\u0947\u0902 \u092e\u0948\u0928\u094d\u092f\u0941\u0905\u0932 \u0930\u0942\u092a \u0938\u0947 \u092a\u0941\u0937\u094d\u091f \u0915\u093f\u090f \u091c\u093e\u0924\u0947 \u0939\u0948\u0902"],"Configured":["\u0915\u0949\u0928\u094d\u092b\u093c\u093f\u0917\u0930 \u0915\u093f\u092f\u093e \u0917\u092f\u093e"],"Not configured":["\u0915\u0949\u0928\u094d\u092b\u093c\u093f\u0917\u0930 \u0928\u0939\u0940\u0902 \u0939\u0948"],"Payment provider":["\u092d\u0941\u0917\u0924\u093e\u0928 \u092a\u094d\u0930\u0926\u093e\u0924\u093e"],"Stripe secret key":["Stripe \u0917\u0941\u092a\u094d\u0924 \u0915\u0941\u0902\u091c\u0940"],"Leave empty to keep the stored key. A secret key (sk_\u2026) \u2014 never the publishable one.":["\u0938\u0902\u0917\u094d\u0930\u0939\u0940\u0924 \u0915\u0941\u0902\u091c\u0940 \u092c\u0928\u093e\u090f \u0930\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0916\u093e\u0932\u0940 \u091b\u094b\u0921\u093c\u0947\u0902\u0964 \u0917\u0941\u092a\u094d\u0924 \u0915\u0941\u0902\u091c\u0940 (sk_\u2026) \u2014 \u0915\u092d\u0940 \u092d\u0940 \u0938\u093e\u0930\u094d\u0935\u091c\u0928\u093f\u0915 \u0915\u0941\u0902\u091c\u0940 \u0928\u0939\u0940\u0902\u0964"],"Stripe webhook signing secret":["Stripe \u0935\u0947\u092c\u0939\u0941\u0915 \u0938\u093e\u0907\u0928\u093f\u0902\u0917 \u0930\u0939\u0938\u094d\u092f"],"Saving\u2026":["\u0938\u0939\u0947\u091c\u093e \u091c\u093e \u0930\u0939\u093e \u0939\u0948\u2026"],"Saved.":["\u0938\u0939\u0947\u091c\u093e \u0917\u092f\u093e\u0964"],"Save failed.":["\u0938\u0939\u0947\u091c\u0928\u093e \u0935\u093f\u092b\u0932\u0964"],"Webhook endpoint (register in the Stripe dashboard \u2192 Webhooks)":["\u0935\u0947\u092c\u0939\u0941\u0915 \u090f\u0902\u0921\u092a\u0949\u0907\u0902\u091f (Stripe \u0921\u0948\u0936\u092c\u094b\u0930\u094d\u0921 \u2192 Webhooks \u092e\u0947\u0902 \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u0915\u0930\u0947\u0902)"],"Events: checkout.session.completed, checkout.session.expired, checkout.session.async_payment_failed":["\u0907\u0935\u0947\u0902\u091f: checkout.session.completed, checkout.session.expired, checkout.session.async_payment_failed"],"Test connection":["\u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u092a\u0930\u0940\u0915\u094d\u0937\u0923"],"Checking\u2026":["\u091c\u093e\u0901\u091a \u0939\u094b \u0930\u0939\u0940 \u0939\u0948\u2026"],"Key valid":["\u0915\u0941\u0902\u091c\u0940 \u092e\u093e\u0928\u094d\u092f \u0939\u0948"],"Webhook delivery still needs to be confirmed in the Stripe dashboard.":["\u0935\u0947\u092c\u0939\u0941\u0915 \u0921\u093f\u0932\u0940\u0935\u0930\u0940 \u0915\u0940 \u092a\u0941\u0937\u094d\u091f\u093f \u0905\u092d\u0940 \u092d\u0940 Stripe \u0921\u0948\u0936\u092c\u094b\u0930\u094d\u0921 \u092e\u0947\u0902 \u0915\u0930\u0928\u0940 \u0939\u094b\u0917\u0940\u0964"],"Check failed.":["\u091c\u093e\u0901\u091a \u0935\u093f\u092b\u0932\u0964"],"The installed free plugin is too old for automatic ticket delivery after payment \u2014 update the free plugin to 3.3.1 or newer.":["\u092d\u0941\u0917\u0924\u093e\u0928 \u0915\u0947 \u092c\u093e\u0926 \u091f\u093f\u0915\u091f \u0915\u0940 \u0938\u094d\u0935\u091a\u093e\u0932\u093f\u0924 \u0921\u093f\u0932\u0940\u0935\u0930\u0940 \u0915\u0947 \u0932\u093f\u090f \u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0928\u093f\u0903\u0936\u0941\u0932\u094d\u0915 \u092a\u094d\u0932\u0917\u0907\u0928 \u092c\u0939\u0941\u0924 \u092a\u0941\u0930\u093e\u0928\u093e \u0939\u0948 \u2014 \u0928\u093f\u0903\u0936\u0941\u0932\u094d\u0915 \u092a\u094d\u0932\u0917\u0907\u0928 \u0915\u094b 3.3.1 \u092f\u093e \u0928\u090f \u092e\u0947\u0902 \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0947\u0902\u0964"]}}}