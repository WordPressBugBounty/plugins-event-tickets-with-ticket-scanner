#: includes/woocommerce/class-product.php:910
msgid "Override: Ask for a dropdown selection per ticket."
msgstr "Zastąpienie: pytanie o wybór z listy rozwijanej dla każdego biletu."

#: includes/woocommerce/class-product.php:916
msgid "Dropdown label"
msgstr "Etykieta listy rozwijanej"

#: includes/woocommerce/class-product.php:924
msgid "Dropdown values"
msgstr "Wartości listy rozwijanej"

#: includes/woocommerce/class-product.php:925
