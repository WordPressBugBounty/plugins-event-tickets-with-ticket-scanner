{"translation-revision-date":"2026-03-24 18:00+0100","generator":"WP-CLI\/2.12.0","source":"js\/seating_a.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"zh_TW","plural-forms":"nplurals=1; plural=0;"},"Seating plan created successfully":["\u5ea7\u4f4d\u5716\u5efa\u7acb\u6210\u529f"],"Seating plan updated successfully":["\u5ea7\u4f4d\u5716\u66f4\u65b0\u6210\u529f"],"Seating plan deleted successfully":["\u5ea7\u4f4d\u5716\u522a\u9664\u6210\u529f"],"Seating plan cloned successfully":["\u5ea7\u4f4d\u5716\u8907\u88fd\u6210\u529f"],"Seat created successfully":["\u5ea7\u4f4d\u5df2\u6210\u529f\u5efa\u7acb"],"Seat updated successfully":["\u5ea7\u4f4d\u66f4\u65b0\u6210\u529f"],"Seat deleted successfully":["\u5ea7\u4f4d\u5df2\u6210\u529f\u522a\u9664"],"Are you sure you want to delete this?":["\u78ba\u5b9a\u8981\u522a\u9664\u6b64\u9805\u76ee\u55ce\uff1f"],"This plan has seats. Delete plan and all seats?":["\u6b64\u65b9\u6848\u5305\u542b\u5ea7\u4f4d\u3002\u662f\u5426\u522a\u9664\u65b9\u6848\u53ca\u6240\u6709\u5ea7\u4f4d\uff1f"],"Seats created successfully":["\u5ea7\u4f4d\u5efa\u7acb\u6210\u529f"],"Limit reached. Upgrade to Premium for unlimited access.":["\u5df2\u9054\u4e0a\u9650\u3002\u5347\u7d1a\u81f3 Premium \u5373\u53ef\u4eab\u6709\u7121\u9650\u5b58\u53d6\u3002"],"An error occurred. Please try again.":["\u767c\u751f\u932f\u8aa4\uff0c\u8acb\u518d\u8a66\u4e00\u6b21\u3002"],"Loading...":["\u8f09\u5165\u4e2d\u2026\u2026"],"No seating plans found. Create your first plan!":["\u627e\u4e0d\u5230\u5ea7\u4f4d\u8868\u3002\u5efa\u7acb\u60a8\u7684\u7b2c\u4e00\u500b\u5ea7\u4f4d\u8868!"],"No seats in this plan. Add seats below.":["\u6b64\u5ea7\u4f4d\u8868\u5c1a\u7121\u5ea7\u4f4d\u3002\u8acb\u5728\u4e0b\u65b9\u65b0\u589e\u5ea7\u4f4d\u3002"],"Simple Layout (Dropdown)":["\u7c21\u6613\u7248\u9762\uff08\u4e0b\u62c9\u9078\u55ae\uff09"],"Customers will see a dropdown menu to select their seat. Available seats are shown in a list sorted by identifier. This is ideal for smaller venues or when visual seat selection is not needed.":["\u5ba2\u6236\u5c07\u770b\u5230\u4e00\u500b\u4e0b\u62c9\u5f0f\u9078\u55ae\u4f86\u9078\u64c7\u5ea7\u4f4d\u3002\u53ef\u7528\u5ea7\u4f4d\u6703\u4f9d\u7167\u8b58\u5225\u78bc\u6392\u5e8f\u986f\u793a\u70ba\u6e05\u55ae\u3002\u9019\u9069\u7528\u65bc\u8f03\u5c0f\u7684\u5834\u5730\uff0c\u6216\u4e0d\u9700\u8981\u8996\u89ba\u5316\u5ea7\u4f4d\u9078\u64c7\u7684\u60c5\u6cc1\u3002"],"Visual Layout (Seat Map)":["\u8996\u89ba\u5316\u7248\u9762\uff08\u5ea7\u4f4d\u5716\uff09"],"Customers will see an interactive seat map where they can click on available seats. Occupied seats are shown in a different color. This provides a visual overview of the venue. (Premium feature)":["\u5ba2\u6236\u5c07\u770b\u5230\u4e00\u500b\u4e92\u52d5\u5f0f\u5ea7\u4f4d\u5716\uff0c\u53ef\u9ede\u64ca\u9078\u64c7\u53ef\u7528\u5ea7\u4f4d\u3002\u5df2\u4f54\u7528\u5ea7\u4f4d\u6703\u4ee5\u4e0d\u540c\u984f\u8272\u986f\u793a\u3002\u9019\u80fd\u63d0\u4f9b\u5834\u5730\u7684\u8996\u89ba\u5316\u6982\u89bd\u3002(\u9032\u968e\u7248\u529f\u80fd)"],"Seat":["\u5ea7\u4f4d"],"Seating Plan":["\u5ea7\u4f4d\u5716"],"Description":["\u63cf\u8ff0"],"Activate":["\u555f\u7528"],"Active":["\u555f\u7528"],"Inactive":["\u672a\u555f\u7528"],"Status":["\u72c0\u614b"],"Export CSV":["\u532f\u51fa CSV"],"Edit":["\u7de8\u8f2f"],"Delete":["\u522a\u9664"],"Cancel":["\u53d6\u6d88"],"Drag to reorder":["\u62d6\u66f3\u4ee5\u91cd\u65b0\u6392\u5e8f"],"Remove":["\u79fb\u9664"],"Label":["\u6a19\u7c64"],"Name":["\u540d\u7a31"],"Show Layout":["\u986f\u793a\u7248\u9762"],"Hide Layout":["\u96b1\u85cf\u7248\u9762"],"Delete %d seats?":["\u8981\u522a\u9664 %d \u500b\u5ea7\u4f4d\u55ce\uff1f"],"%d seats updated":["\u5df2\u66f4\u65b0 %d \u500b\u5ea7\u4f4d"],"%d seats deleted":["\u5df2\u522a\u9664 %d \u500b\u5ea7\u4f4d"],"%d seats processed, %d errors":["\u5df2\u8655\u7406 %d \u500b\u5ea7\u4f4d\uff0c\u767c\u751f %d \u500b\u932f\u8aa4"],"selected":["\u5df2\u9078\u53d6"],"-- Action --":["-- \u52d5\u4f5