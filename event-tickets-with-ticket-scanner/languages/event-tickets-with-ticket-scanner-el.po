msgstr "Ετικέτα \"Θέση\" για τις πληροφορίες θέσης"

#: sasoEventtickets_Options.php:658
msgid "Label 'Customer' heading on the customer details"
msgstr "Ετικέτα \"Πελάτης\" στις λεπτομέρειες πελάτη"

#: sasoEventtickets_Options.php:658
msgid "Customer"
msgstr "Vásárló"

#: sasoEventtickets_Options.php:659
msgid "Label 'Payment details' heading on the payment details"
msgstr "Ετικέτα \"Στοιχεία πληρωμής\" στα στοιχεία πληρωμής"

#: sasoEventtickets_Options.php:659
msgid "Payment details"
msgstr "Στοιχεία πληρωμής"

#: sasoEventtickets_Options.php:660
msgid "Label 'Order paid at' on the payment details"
msgstr "Ετικέτα \"Η παραγγελία πληρώθηκε στις\" στα στοιχεία πληρωμής"

#: sasoEventtickets_Options.php:660
msgid "Order paid at:"
msgstr "Η παραγγελία πληρώθηκε στις:"

#: sasoEventtickets_Options.php:661
msgid "Label 'Order completed at' on the payment details"
msgstr "Ετικέτα \"Η παραγγελία ολοκληρώθηκε στις\" στα στοιχεία πληρωμής"

#: sasoEventtickets_Options.php:661
msgid "Order completed at:"
msgstr "Η παραγγελία ολοκληρώθηκε στις:"

#: sasoEventtickets_Options.php:662
msgid "Label 'Paid via' on the payment details"
msgstr "Ετικέτα \"Πληρωμή μέσω\" στα στοιχεία πληρωμής"

