msgstr "Εισιτήριο"

#: sasoEventtickets_Options.php:655
msgid "Label 'EXPIRED' on the event date"
msgstr "Ετικέτα \"ΕΛΗΞΕ\" για την ημερομηνία της εκδήλωσης"

#: sasoEventtickets_Options.php:655
msgid "EXPIRED"
msgstr "ΕΛΗΞΕ"

#: sasoEventtickets_Options.php:656
msgid "Label 'Location' heading on for the event location"
msgstr "Ετικέτα \"Τοποθεσία\" για την τοποθεσία της εκδήλωσης"

#: sasoEventtickets_Options.php:656
msgid "Location"
msgstr "Τοποθεσία"

#: sasoEventtickets_Options.php:657
