{"translation-revision-date":"2026-03-24 18:00+0100","generator":"WP-CLI\/2.12.0","source":"js\/congress-a.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"hu_HU","plural-forms":"nplurals=2; plural=(n != 1);"},"Title":["\u0627\u0644\u0639\u0646\u0648\u0627\u0646"],"Add":["Hozz\u00e1ad\u00e1s"],"Export contacts":["\u062a\u0635\u062f\u064a\u0631 \u062c\u0647\u0627\u062a \u0627\u0644\u0627\u062a\u0635\u0627\u0644"],"Portal label":["\u062a\u0633\u0645\u064a\u0629 \u0627\u0644\u0628\u0648\u0627\u0628\u0629"],"Shown in the wallet and email (e.g. \"Opera evening\", \"Zoo visit\"). Empty = use the global default.":["\u064a\u0638\u0647\u0631 \u0641\u064a \u0627\u0644\u0645\u062d\u0641\u0638\u0629 \u0648\u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a (\u0645\u062b\u0644 \"\u0645\u0633\u0627\u0621 \u0627\u0644\u0623\u0648\u0628\u0631\u0627\"\u060c \"\u0632\u064a\u0627\u0631\u0629 \u062d\u062f\u064a\u0642\u0629 \u0627\u0644\u062d\u064a\u0648\u0627\u0646\"). \u0641\u0627\u0631\u063a = \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a \u0627\u0644\u0639\u0627\u0645."],"Show pages as a card grid on the start screen":["\u0625\u0638\u0647\u0627\u0631 \u0627\u0644\u0635\u0641\u062d\u0627\u062a \u0643\u0634\u0628\u0643\u0629 \u0628\u0637\u0627\u0642\u0627\u062a \u0639\u0644\u0649 \u0634\u0627\u0634\u0629 \u0627\u0644\u0628\u062f\u0627\u064a\u0629"],"Visitors first see a grid of page cards (icon\/image + description) instead of jumping straight into the first page.":["\u064a\u0631\u0649 \u0627\u0644\u0632\u0648\u0627\u0631 \u0623\u0648\u0644\u0627\u064b \u0634\u0628\u0643\u0629 \u0645\u0646 \u0628\u0637\u0627\u0642\u0627\u062a \u0627\u0644\u0635\u0641\u062d\u0629 (\u0623\u064a\u0642\u0648\u0646\u0629\/\u0635\u0648\u0631\u0629 + \u0648\u0635\u0641) \u0628\u062f\u0644\u0627\u064b \u0645\u0646 \u0627\u0644\u0627\u0646\u062a\u0642\u0627\u0644 \u0645\u0628\u0627\u0634\u0631\u0629 \u0625\u0644\u0649 \u0627\u0644\u0635\u0641\u062d\u0629 \u0627\u0644\u0623\u0648\u0644\u0649."],"Active \u2014 visible to ticket holders":["\u0646\u0634\u0637 \u2014 \u0645\u0631\u0626\u064a \u0644\u062d\u0627\u0645\u0644\u064a \u0627\u0644\u062a\u0630\u0627\u0643\u0631"],"Turn off to hide this congress everywhere (page + wallet) without unassigning it \u2014 e.g. to publish the info only later.":["\u0642\u0645 \u0628\u0625\u064a\u0642\u0627\u0641\u0647 \u0644\u0625\u062e\u0641\u0627\u0621 \u0647\u0630\u0627 \u0627\u0644\u0645\u0624\u062a\u0645\u0631 \u0641\u064a \u0643\u0644 \u0645\u0643\u0627\u0646 (\u0635\u0641\u062d\u0629 + \u0645\u062d\u0641\u0638\u0629) \u062f\u0648\u0646 \u0625\u0644\u063a\u0627\u0621 \u062a\u0639\u064a\u064a\u0646\u0647 \u2014 \u0639\u0644\u0649 \u0633\u0628\u064a\u0644 \u0627\u0644\u0645\u062b\u0627\u0644 \u0644\u0646\u0634\u0631 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0644\u0627\u062d\u0642\u0627\u064b \u0641\u0642\u0637."],"No icon":["\u0628\u062f\u0648\u0646 \u0623\u064a\u0642\u0648\u0646\u0629"],"Remove image":["\u0625\u0632\u0627\u0644\u0629 \u0627\u0644\u0635\u0648\u0631\u0629"],"Icon, optional image, card color and a short description shown on the page card.":["\u0623\u064a\u0642\u0648\u0646\u0629\u060c \u0635\u0648\u0631\u0629 \u0627\u062e\u062a\u064a\u0627\u0631\u064a\u0629\u060c \u0644\u0648\u0646 \u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0648\u0648\u0635\u0641 \u0642\u0635\u064a\u0631 \u064a\u0638\u0647\u0631 \u0639\u0644\u0649 \u0628\u0637\u0627\u0642\u0629 \u0627\u0644\u0635\u0641\u062d\u0629."],"Icon":["\u0627\u0644\u0623\u064a\u0642\u0648\u0646\u0629"],"Image (optional, overrides icon)":["\u0627\u0644\u0635\u0648\u0631\u0629 (\u0627\u062e\u062a\u064a\u0627\u0631\u064a\u0629\u060c \u062a\u062a\u062c\u0627\u0648\u0632 \u0627\u0644\u0623\u064a\u0642\u0648\u0646\u0629)"],"Card color":["\u0644\u0648\u0646 \u0627\u0644\u0628\u0637\u0627\u0642\u0629"],"Short description (max 160)":["\u0648\u0635\u0641 \u0642\u0635\u064a\u0631 (\u0628\u062d\u062f \u0623\u0642\u0635\u0649 160)"],"Page card settings":["\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0628\u0637\u0627\u0642\u0629 \u0627\u0644\u0635\u0641\u062d\u0629"],"Settings":["\u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a"],"Speakers":["\u0627\u0644\u0645\u062a\u062d\u062f\u062b\u0648\u0646"],"Insert variable\u2026":["\u0625\u062f\u0631\u0627\u062c \u0645\u062a\u063a\u064a\u0631\u2026"],"Short bio (max 500 characters)":["\u0633\u064a\u0631\u0629 \u0630\u0627\u062a\u064a\u0629 \u0642\u0635\u064a\u0631\u0629 (\u0628\u062d\u062f \u0623\u0642\u0635\u0649 500 \u062d\u0631\u0641)"],"Add speaker":["\u0625\u0636\u0627\u0641\u0629 \u0645\u062a\u062d\u062f\u062b"],"Each speaker has an image, name, title and a short bio (max 500 characters). One speaker is shown in full; several are shown as boxes. Drag to reorder.":["\u0644\u0643\u0644 \u0645\u062a\u062d\u062f\u062b \u0635\u0648\u0631\u0629 \u0648\u0627\u0633\u0645 \u0648\u0644\u0642\u0628 \u0648\u0633\u064a\u0631\u0629 \u0630\u0627\u062a\u064a\u0629 \u0642\u0635\u064a\u0631\u0629 (\u0628\u062d\u062f \u0623\u0642\u0635\u0649 500 \u062d\u0631\u0641). \u064a\u0638\u0647\u0631 \u0645\u062a\u062d\u062f\u062b \u0648\u0627\u062d\u062f \u0628\u0627\u0644\u0643\u0627\u0645\u0644\u061b \u0648\u064a\u062a\u0638\u0647\u0631 \u0639\u062f\u0629 \u0645\u062a\u062d\u062f\u062b\u064a\u0646 \u0643\u0635\u0646\u0627\u062f\u064a\u0642. \u0627\u0633\u062d\u0628 \u0644\u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u062a\u0631\u062a\u064a\u0628."]}}}